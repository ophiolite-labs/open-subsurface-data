    "shot": "node tools/shot.mjs"
  },
  "devDependencies": {
    "maplibre-gl": "4.7.1",
    "maplibre-gl-5": "npm:maplibre-gl@5.24.0",
    "playwright": "^1.64.1",
    "pmtiles": "4.5.0"
  }
}
