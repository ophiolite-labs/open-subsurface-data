     1	# Publish the site from main. Continuous: every merge is a release. No version numbers,
     2	# no qualification step; the check on the pull request was the proof.
     3	# Levels come from the `verification-results` branch the verify workflow writes (OSD-D5).
     4	name: pages
     5	on:
     6	  push:
     7	    branches: [main]
     8	  workflow_dispatch:
     9	permissions: { contents: read, pages: write, id-token: write }
    10	concurrency: { group: pages, cancel-in-progress: true }
    11	jobs:
    12	  publish:
    13	    runs-on: ubuntu-24.04
    14	    timeout-minutes: 10
    15	    environment: { name: github-pages, url: "${{ steps.deploy.outputs.page_url }}" }
    16	    steps:
    17	      - uses: actions/checkout@v4
    18	        with: { fetch-depth: 0 }
    19	      - uses: astral-sh/setup-uv@v3
    20	        with: { python-version: "3.12" }
    21	      - run: uv sync
    22	      - name: latest verification results
    23	        run: |
    24	          if git ls-remote --exit-code origin verification-results >/dev/null; then
    25	            git fetch -q origin verification-results
    26	            mkdir -p build/verification
    27	            git archive origin/verification-results | tar -x -C build/verification
    28	          fi
    29	      - run: make build
    30	      - uses: actions/configure-pages@v5
    31	      - uses: actions/upload-pages-artifact@v3
    32	        with: { path: site }
    33	      - id: deploy
    34	        uses: actions/deploy-pages@v4
