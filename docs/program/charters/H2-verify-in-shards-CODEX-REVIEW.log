    34	def cmd_fidelity(a: argparse.Namespace) -> int:
    35	    """osd verify <id> --fidelity-from F: offline, the L4 rule (E09). Writes the verification back."""
    36	    if len(a.ids) != 1:
    37	        print("refused: --fidelity-from takes exactly one record id, the record the fidelity is for")
    38	        return 2
    39	    (rid,) = a.ids
    40	    vdir = Path(a.vdir)
    41	    try:
    42	        doc = json.loads(Path(a.fidelity_from).read_text())
    43	    except (OSError, ValueError) as e:
    44	        print(f"refused: {a.fidelity_from}: {e}")
    45	        return 1
    46	    v, reasons = apply_fidelity(rid, doc if isinstance(doc, dict) else {}, build_mod.latest_verification(rid, vdir))
    47	    if v is None:
    48	        print(f"refused: {reasons[0]}")
    49	        return 1
    50	    verify_mod._validator().validate(v)   # never write a record the schema refuses
    51	    (vdir / (rid.replace("/", "__") + ".json")).write_text(json.dumps(v, indent=2) + "\n")
    52	    c = next(c for c in v["checks"] if c["name"] == "canonical-conversion")
    53	    if c["outcome"] == "fail":
    54	        for r in reasons:
    55	            print(f"  {v['level']}  {rid}  fidelity rejected: {r}")
    56	        return 1
    57	    print(f"  {v['level']}  {rid}  canonical-conversion: pass ({c['detail']})")
    58	    for r in reasons:
    59	        print(f"  {v['level']}  {rid}  L4 not awarded: {r}")
    60	    return 0
    61	
