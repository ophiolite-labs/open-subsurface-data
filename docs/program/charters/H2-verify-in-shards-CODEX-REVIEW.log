   103	def status_lines(vdir: Path = paths.VERIFICATION_DIR, now: datetime | None = None,
   104	                 records_dir: Path = paths.RECORDS_DIR) -> list[str]:
   105	    """The levels `osd build` publishes, read from the same verification directory; an L4 shows
   106	    its coverage beside it, "L4 (2 of 2 converted)" (E09), and a stated expiry of the terms,
   107	    "L1 (terms expire 2027-01-01)" (E19); every line ends with the reason, the string records.json
   108	    carries (osd.reasons, E23/E27)."""
   109	    rows = []
   110	    for rid, r in load_records(records_dir).items():
   111	        v = build_mod.latest_verification(rid, vdir)
   112	        lv, checked = (v["level"], v["checked_at"]) if v else ("L0", None)
   113	        coverage = conversion_coverage(v)
   114	        lv += f" ({coverage})" if coverage else ""
   115	        terms = terms_note(r, now)
   116	        lv += f" ({terms})" if terms else ""
   117	        when = (checked or "never")[:10] + (" stale" if is_stale(checked, now) else "")
   118	        blocked = (v or {}).get("origin", {}).get("blocked_since")
   119	        when += f" blocked since {blocked[:10]}" if blocked else ""
   120	        rows.append((lv, (f"{rid:36} {when:36} {r['origin']['access']:12} "
   121	                          f"{r['licence']['redistribution']:14}"), ",".join(r["kinds"]), reasons_mod.reason(v, r)))
   122	    w = max([5] + [len(lv) for lv, *_ in rows])
   123	    k = max([5] + [len(kinds) for _, _, kinds, _ in rows])
   124	    return ([f"{'level':{w}} {'id':36} {'checked':36} {'access':12} {'redistribution':14} {'kinds':{k}} reason"]
   125	            + [f"{lv:{w}} {rest} {kinds:{k}} {why}".rstrip() for lv, rest, kinds, why in rows])
   126	
   127	
   128	def cmd_status(_: argparse.Namespace) -> int:
   129	    print("\n".join(status_lines()))
   130	    return 0
