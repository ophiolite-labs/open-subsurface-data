   242	# --- the L3 check ------------------------------------------------------------------------------
   243	
   244	def check(rec: dict, outline: dict, rule: dict | None, stored: dict[str, str],
   245	          refused: str | None = None) -> tuple[str, str]:
   246	    """(outcome, detail) of `outline-derived`: pass only when every feature is derived and names
   247	    an input of the collection whose (url, sha256) is a stored input of the record, ids are unique
   248	    and the count reaches the rules' min_features."""
   249	    feats = outline.get("features") or []
   250	    if refused:
   251	        return "fail", f"derivation refused this run: {refused}"
   252	    if not feats:
   253	        return "fail", "no features"
   254	    props = [f.get("properties") or {} for f in feats]
   255	    approx = sum(1 for p in props if p.get("approximate") is not False)
   256	    if approx:
   257	        return "fail", f"{approx} approximate features"
   258	    named = outline.get("inputs") or {}
   259	    lacking = sum(1 for p in props if not (p.get("feature_id") and (named.get(p.get("input")) or {}).get("sha256")))
   260	    if lacking:
   261	        return "fail", f"{lacking} features without feature_id or an input the collection carries"
   262	    dup = [k for k, n in Counter(p["feature_id"] for p in props).items() if n > 1]
   263	    if dup:
   264	        return "fail", f"duplicate feature_id {dup[0]}"
   265	    declared = {i["url"] for i in rec.get("inputs") or []}
   266	    if not declared:
   267	        return "fail", "the record declares no inputs"
   268	    used = {(named[p["input"]]["url"], named[p["input"]]["sha256"]) for p in props}
   269	    if any(u not in declared for u, _ in used):
   270	        return "fail", "features name an input the record does not declare"
   271	    want = (rule or {}).get("min_features")
   272	    if not isinstance(want, int) or want < 1:
   273	        return "fail", "no min_features for this record in outlines/rules.yaml"
   274	    if len(feats) < want:
   275	        return "fail", f"{len(feats)} features, fewer than the {want} the rules record"
   276	    if not stored:
   277	        return "skip", "inputs not stored on this runner: `osd verify --outlines` fetches them"
   278	    stale = sorted(u for u, s in used if stored.get(u) != s)
   279	    if stale:
   280	        return "fail", f"derived from bytes that differ from the stored input {stale[0]}: rerun --outlines, review the diff"
   281	    unplaced = f"; {len(outline['unplaced'])} listed without a position" if outline.get("unplaced") else ""
   282	    return "pass", (f"{len(feats)} features derived from {len(used)} inputs, every input sha256 equal to the "
   283	                    f"stored bytes (min_features {want}){unplaced}")
