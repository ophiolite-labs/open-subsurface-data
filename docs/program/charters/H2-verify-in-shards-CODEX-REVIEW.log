   234	    for k in ("licence", "inputs"):
   235	        if k in fc:
   236	            head += json.dumps(k) + ":" + json.dumps(fc[k], ensure_ascii=False, separators=(",", ":")) + ",\n"
   237	    if fc.get("unplaced"):
   238	        head += '"unplaced":' + json.dumps(fc["unplaced"], ensure_ascii=False) + ",\n"
   239	    path.write_text(head + '"features":[\n' + ",\n".join(lines) + "\n]}\n")
