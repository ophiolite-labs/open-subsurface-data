   234	def main(argv: list[str] | None = None) -> int:
   235	    ap = argparse.ArgumentParser(prog="osd", description=__doc__)
   236	    sub = ap.add_subparsers(dest="cmd", required=True)
   237	    sub.add_parser("validate", help="records and outlines against their schemas").set_defaults(fn=cmd_validate)
   238	    pv = sub.add_parser("verify", help="network: reach each origin, write verification records")
   239	    pv.add_argument("ids", nargs="*")
   240	    pv.add_argument("--outlines", action="store_true",
   241	                    help="also fetch outline inputs and rewrite outlines/ (osd.outlines, E03)")
   242	    pv.add_argument("--outline-inputs", action="store_true",
   243	                    help="also fetch outline inputs and check the committed outlines against them (CI)")
   244	    pv.add_argument("--fidelity-from", metavar="FILE",
   245	                    help="offline: derive L4 for the one record id from a fidelity/1 record (E09)")
   246	    pv.add_argument("--vdir", default=str(paths.VERIFICATION_DIR), help="with --fidelity-from: verifications")
   247	    pv.set_defaults(fn=cmd_verify)
   248	    sub.add_parser("build", help="write build/catalog").set_defaults(fn=cmd_build)
   249	    sub.add_parser("status", help="one line per record").set_defaults(fn=cmd_status)
   250	    pn = sub.add_parser("new", help="scaffold records/<id>.yaml from a dataset page (reads its title)")
   251	    pn.add_argument("url")
   252	    pn.add_argument("--id", help="publisher/dataset (default: from the address)")
   253	    pn.add_argument("--title", help="skip reading the page")
   254	    pn.set_defaults(fn=cmd_new)
   255	    pr = sub.add_parser("report", help="dead-link report: origins that fell from L1+ to dead, and open issues that recovered")
   256	    pr.add_argument("--before", required=True, help="verification results stored before the run")
   257	    pr.add_argument("--after", default=str(paths.VERIFICATION_DIR), help="results after the run")
   258	    pr.add_argument("--open-issues", help="the open origin-dead issues, `gh issue list --json number,title,labels`;"
   259	                                          " absent or unreadable: nothing is opened or closed")
   260	    pr.add_argument("--verified", default="all", help="the ids this run verified, space separated ('all' or empty: every record)")
   261	    pr.add_argument("--run-url", default="", help="the run named in a closing comment")
   262	    pr.add_argument("--out", help='write {"open": [...], "recovered": [...]} as JSON')
   263	    pr.add_argument("--dry-run", action="store_true", help="say 'would open/close'; the workflow mutates nothing")
   264	    pr.set_defaults(fn=cmd_report)
   265	    pm = sub.add_parser("manifest", help="write a retrieval manifest from the built catalogue")
   266	    pm.add_argument("ids", nargs="+", help="record or collection ids, or feature ids (never a mix)")
   267	    pm.add_argument("-o", "--out", default="manifest.json")
   268	    pm.add_argument("--catalog", default=str(paths.CATALOG_DIR), help="the built catalogue (osd build)")
   269	    pm.add_argument("--catalog-url", default=manifest_mod.CATALOG_URL)
   270	    pm.set_defaults(fn=cmd_manifest)
   271	    pg = sub.add_parser("get", help="network: fetch a manifest's assets, verify, write ATTRIBUTION.md")
   272	    pg.add_argument("manifest")
   273	    pg.add_argument("--dest", required=True)
   274	    pg.set_defaults(fn=cmd_get)
   275	    pmi = sub.add_parser("mirror", help="the mirror store: eligibility, copies, takedown (E07)")
   276	    msub = pmi.add_subparsers(dest="mirror_cmd", required=True)
   277	    me = msub.add_parser("eligible", help="which records may be mirrored, and why not (offline)")
   278	    me.add_argument("ids", nargs="*")
   279	    me.add_argument("--vdir", default=str(paths.VERIFICATION_DIR))
   280	    me.set_defaults(fn=cmd_mirror_eligible)
   281	    store_args = argparse.ArgumentParser(add_help=False)
   282	    store_args.add_argument("--store", default=str(mirror_mod.MIRROR_DIR), help="local store directory (slice 1)")
   283	    store_args.add_argument("--public-url", required=True,
   284	                            help="http(s) address the store is served at; custody hrefs start here")
   285	    mp = msub.add_parser("put", parents=[store_args], help="network: copy eligible records' inventories")
   286	    mp.add_argument("ids", nargs="+")
   287	    mp.add_argument("--vdir", default=str(paths.VERIFICATION_DIR))
   288	    mp.set_defaults(fn=cmd_mirror_put)
   289	    mr = msub.add_parser("remove", parents=[store_args], help="takedown: delete a copy, write its tombstone")
