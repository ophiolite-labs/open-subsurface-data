   112	def _features(rec_input: dict, rule: dict, collections: list[dict]) -> list[dict]:
   113	    f = to_wgs84(rec_input.get("crs"), rec_input.get("units"))
   114	    out = []
   115	    for fc in collections:
   116	        served = _epsg(((fc.get("crs") or {}).get("properties") or {}).get("name", ""))
   117	        if served and served != rec_input.get("crs"):
   118	            raise Refused(f"{rec_input['name']}: the response declares {served}, the record {rec_input.get('crs')}")
   119	        for feat in fc.get("features") or []:
   120	            props = feat.get("properties") or {}
   121	            if not _keep(rule, props):
   122	                continue
   123	            g = feat.get("geometry") or {}
   124	            if not g.get("coordinates") and rule.get("unplaced") == "report":
   125	                out.append({"kind": _kind(rule, props), **_ident(rule, props), **_period(rule, props),
   126	                            "geometry": None})
   127	                continue
   128	            if g.get("type") not in GEOMETRY_TYPES or not g.get("coordinates"):
   129	                raise Refused(f"{rec_input['name']}: a feature has geometry {g.get('type')!r}")
   130	            out.append({"kind": _kind(rule, props), **_ident(rule, props), **_period(rule, props),
   131	                        "geometry": {"type": g["type"], "coordinates": map_positions(g["coordinates"], f)}})
   132	    return out
