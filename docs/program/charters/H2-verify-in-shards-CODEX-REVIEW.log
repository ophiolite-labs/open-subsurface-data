   225	    from stac_validator.utilities import fetch_and_parse_schema
   226	    from stac_validator.validate import StacValidate
   227	
   228	    fetch_and_parse_schema.cache_clear()   # a schema map change must not reuse a cached schema
   229	    v = StacValidate(str(path), recursive=recursive, schema_config=str(schema_config))
   230	    ok = v.run()
   231	    messages = list(v.message)
   232	    if recursive and path.is_file() and json.loads(path.read_text()).get("type") == "Catalog":
   233	        messages += [{"path": problem, "valid_stac": False, "error_type": "containment",
   234	                      "error_message": problem} for problem in containment_problems(path.parent)]
   235	    return ok and all(m.get("valid_stac") for m in messages), messages
