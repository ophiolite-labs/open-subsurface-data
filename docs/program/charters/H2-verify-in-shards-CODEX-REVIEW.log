    25	def cmd_validate(_: argparse.Namespace) -> int:
    26	    problems = validate_records() + validate_outlines()
    27	    for p in problems:
    28	        print(f"  {p}")
    29	    n = len(load_records())
    30	    print(f"{n} records, {len(problems)} problems")
    31	    return 1 if problems else 0
