   791	    for rid, rec in recs.items():
   792	        if ids and rid not in ids:
   793	            continue
   794	        op = outlines_dir / (rid.replace("/", "__") + ".geojson")
   795	        refused = None
   796	        if (derive or fetch_inputs) and opener is not None and rid in rules:
   797	            refused = derive_outline(rec, rules, opener, inputs_dir, op, rewrite=derive)
   798	        outline = load_outline(op) if op.exists() else None
   799	        out = out_dir / (rid.replace("/", "__") + ".json")
   800	        previous = json.loads(out.read_text()) if out.exists() else None
   801	        v = verify_record(rec, fetch, outline, opener=opener, previous=previous, budget=budget,
   802	                          sample=samples.get(rid), outline_rule=rules.get(rid),
   803	                          stored=outlines.stored_inputs(rid, inputs_dir), refused=refused,
   804	                          mirror_rule=mirror_rules.get(rid), browser_probe=browser_probe)
   805	        _validator().validate(v)  # never write a record the schema refuses
   806	        out.write_text(json.dumps(v, indent=2) + "\n")
   807	        results.append(v)
   808	    return results
