    63	def cmd_verify(a: argparse.Namespace) -> int:
    64	    if a.fidelity_from:
    65	        return cmd_fidelity(a)
    66	    results = verify_all(ids=a.ids or None, derive=a.outlines, fetch_inputs=a.outline_inputs)
    67	    for v in results:
    68	        o = v["origin"]
    69	        l2 = "; ".join(f"{c['name']}: {c['outcome']} ({c.get('detail', '')})" for c in v["checks"] if c["level"] == "L2")
    70	        l3 = "; ".join(f"{c['name']}: {c['outcome']} ({c.get('detail', '')})" for c in v["checks"] if c["level"] == "L3")
    71	        l1 = next((c.get("detail", "") for c in v["checks"] if c["name"] == "origin-reachable"), "")
    72	        print(f"  {v['level']}  {v['record_id']}  (origin {o.get('reachability')} HTTP {o.get('http_status')}: {l1}; "
    73	              f"{l2}; {l3})")
    74	    print(f"{len(results)} verified -> {paths.VERIFICATION_DIR}")
    75	    return 0
