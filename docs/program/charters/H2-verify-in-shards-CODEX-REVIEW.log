    84	
    85	def _period(rule: dict, props: dict) -> dict:
    86	    """The feature's own start and end as the service states them (osd:period_*_raw, verbatim)
    87	    and normalised (osd:period_*), from the rule's period_fields; a value the rule lists in
    88	    period_placeholders, or one not in its period_format, keeps its raw string only."""
    89	    out = {}
    90	    for bound, field in (rule.get("period_fields") or {}).items():
    91	        raw = props.get(field)
    92	        if raw in (None, ""):
    93	            continue
    94	        out[f"osd:period_{bound}_raw"] = str(raw)
    95	        if str(raw) in [str(x) for x in rule.get("period_placeholders") or []]:
    96	            continue
    97	        instant = period_instant(str(raw), bound, rule.get("period_format", "iso"))
    98	        if instant:
    99	            out[f"osd:period_{bound}"] = instant
   100	    return out
