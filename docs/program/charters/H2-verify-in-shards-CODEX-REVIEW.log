   151	def cmd_report(a: argparse.Namespace) -> int:
   152	    issues = report_mod.read_issues(Path(a.open_issues) if a.open_issues else None)
   153	    verified = "all" if a.verified.strip() in ("", "all") else set(a.verified.split())
   154	    r = report_mod.report(Path(a.before), Path(a.after), issues, verified, a.run_url)
   155	    print("\n".join(report_mod.report_lines(r, a.dry_run)))
   156	    if a.out:  # the workflow reads .open[] and .recovered[] (and mutates nothing on a dry run)
   157	        Path(a.out).write_text(json.dumps({"open": r["open"], "recovered": r["recovered"]}, indent=2) + "\n")
   158	    return 0
