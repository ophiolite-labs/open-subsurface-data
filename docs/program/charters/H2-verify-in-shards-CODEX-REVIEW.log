   223	def validate(path: Path, recursive: bool = True, schema_config: Path = SCHEMA_MAP) -> tuple[bool, list]:
   224	    """stac-validator over a local file or tree, against the bundled schemas only."""
   225	    from stac_validator.utilities import fetch_and_parse_schema
   226	    from stac_validator.validate import StacValidate
   227	
   228	    fetch_and_parse_schema.cache_clear()   # a schema map change must not reuse a cached schema
   229	    v = StacValidate(str(path), recursive=recursive, schema_config=str(schema_config))
   230	    ok = v.run()
   231	    messages = list(v.message)
   232	    if recursive and path.is_file() and json.loads(path.read_text()).get("type") == "Catalog":
   233	        messages += [{"path": problem, "valid_stac": False, "error_type": "containment",
   234	                      "error_message": problem} for problem in containment_problems(path.parent)]
   235	    return ok and all(m.get("valid_stac") for m in messages), messages
   236	
   237	
   238	def containment_problems(root: Path) -> list[str]:
   239	    """Every Item whose interval is not inside its Collection's temporal extent (E18)."""
   240	    out = []
   241	    for col_path in sorted(root.glob("*/collection.json")):
   242	        [[lo, hi]] = json.loads(col_path.read_text())["extent"]["temporal"]["interval"]
   243	        for it in sorted((col_path.parent / "items").glob("*.json")):
   244	            item = json.loads(it.read_text())
   245	            p = item["properties"]
   246	            start, end = p.get("start_datetime") or p.get("datetime"), p.get("end_datetime") or p.get("datetime")
   247	            if (lo and (start is None or start < lo)) or (hi and (end is None or end > hi)):
   248	                out.append(f"{item['id']}: {start} to {end} is outside its Collection's {lo} to {hi}")
   249	    return out
   250	
   251	
   252	def _links(path: Path) -> list[dict]:
   253	    return json.loads(path.read_text()).get("links", [])
   254	
   255	
   256	def link_problems(root: Path) -> list[str]:
   257	    """Every relative link in the tree points at a file that exists."""
   258	    out = []
   259	    for p in sorted(root.rglob("*.json")):
   260	        for link in _links(p):
   261	            href = link["href"]
   262	            if "://" not in href and not (p.parent / href).resolve().is_file():
   263	                out.append(f"{p.relative_to(root)}: {link['rel']} -> {href} does not exist")
   264	    return out
   265	
   266	
   267	def reachable(catalog: Path) -> dict[str, set[str]]:
   268	    """Collection and Item ids a client reaches from the root by child and item links."""
   269	    out: dict[str, set[str]] = {"collections": set(), "items": set()}
   270	    todo, seen = [catalog.resolve()], set()
   271	    while todo:
   272	        p = todo.pop()
   273	        if p in seen:
   274	            continue
   275	        seen.add(p)
   276	        doc = json.loads(p.read_text())
   277	        if doc["type"] == "Collection":
   278	            out["collections"].add(doc["id"])
   279	        elif doc["type"] == "Feature":
   280	            out["items"].add(doc["id"])
   281	        todo += [(p.parent / x["href"]).resolve() for x in doc.get("links", [])
   282	                 if x["rel"] in ("child", "item")]
   283	    return out
