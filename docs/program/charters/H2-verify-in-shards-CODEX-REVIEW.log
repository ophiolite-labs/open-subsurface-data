   186	def cmd_mirror_eligible(a: argparse.Namespace) -> int:
   187	    rules, n, total = mirror_mod.load_rules(), 0, 0
   188	    for rid, rec in load_records().items():
   189	        if a.ids and rid not in a.ids:
   190	            continue
   191	        e = mirror_mod.eligibility(rec, build_mod.latest_verification(rid, Path(a.vdir)), rules.get(rid))
   192	        n, total = n + e.eligible, total + (e.bytes if e.eligible else 0)
   193	        why = f"{len(e.files)} files, {e.bytes} bytes" if e.eligible else "; ".join(e.reasons)
   194	        print(f"  {'eligible' if e.eligible else 'no':8} {rid:40} {why}")
   195	    print(f"{n} eligible, {total} bytes of inventory")
   196	    return 0
