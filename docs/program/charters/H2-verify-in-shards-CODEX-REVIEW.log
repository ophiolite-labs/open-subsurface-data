   133	def cmd_new(a: argparse.Namespace) -> int:
   134	    try:
   135	        out = new_mod.new_record(a.url, title=a.title, rid=a.id, records_dir=paths.RECORDS_DIR)
   136	    except FileExistsError as e:
   137	        print(f"refused: {e}")
   138	        return 1
   139	    rel = str(out.relative_to(paths.RECORDS_DIR))
   140	    todo: dict[str, str] = {}  # field -> its last problem (an enum's choices beat "not a string")
   141	    for p in validate_records(paths.RECORDS_DIR):
   142	        if p.path == rel:
   143	            field, _, why = p.message.partition(": ")
   144	            todo[field] = why
   145	    print(f"wrote {out}; {len(todo)} fields for a human to fill from the publisher's page:")
   146	    for field, why in todo.items():
   147	        print(f"  {field}: {why}")
   148	    return 0
