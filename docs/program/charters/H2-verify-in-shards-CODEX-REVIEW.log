   203	def cmd_mirror_put(a: argparse.Namespace, opener=http_open) -> int:
   204	    recs, rules, store, bad = load_records(), mirror_mod.load_rules(), _store(a), False
   205	    for rid in a.ids:
   206	        try:
   207	            out = mirror_mod.put(recs[rid], build_mod.latest_verification(rid, Path(a.vdir)), rules.get(rid),
   208	                                 store, opener)
   209	        except mirror_mod.NotEligible as e:
   210	            print(f"refused: {e}")
   211	            bad = True
   212	            continue
   213	        for c in out:
   214	            print(f"  {c.outcome:11} {rid} {c.path} {c.sha256[:12]}  ({c.detail})")
   215	            bad |= c.outcome in ("mismatch", "origin-dead")
   216	    tombs = sum(k.endswith(".removed.json") for k in store.keys("custody/"))
   217	    print(f"store {store.root}: {len(store.keys('mirror/'))} objects, "
   218	          f"{len(store.keys('custody/')) - tombs} custody documents, {tombs} tombstones")
   219	    return 1 if bad else 0
