    84	def terms_note(rec: dict, now: datetime | None = None) -> str:
    85	    """"terms expire D" for a publisher-stated absolute `licence.terms.expires` (record/3, E19). The
    86	    date is a UTC calendar day and the terms hold through its end; nothing is computed from a
    87	    duration. Empty when the record states no date."""
    88	    x = (rec.get("licence", {}).get("terms") or {}).get("expires")
    89	    if x is None:
    90	        return ""
    91	    try:
    92	        if not isinstance(x, date) and not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", str(x)):
    93	            raise ValueError(x)
    94	        day = x if isinstance(x, date) else date.fromisoformat(x)
    95	    except ValueError:
    96	        return f"terms expire ? ({x!r} is not a date)"
    97	    today = (now or datetime.now(UTC)).astimezone(UTC).date()
    98	    if today > day:
    99	        return f"terms expired {day.isoformat()}"
   100	    return f"terms expire {day.isoformat()}" + (" (today)" if today == day else "")
