def write_catalog(out_dir: Path, records: list[dict], vdir: Path = paths.VERIFICATION_DIR,
                  outlines_dir: Path = paths.OUTLINES_DIR, mirror_index: list[dict] | None = None) -> list[dict]:
    """Write out_dir/stac/ from the joined records (record fields plus level, checked_at,
    blocked_since as build() joins them) and return the Collections. `mirror_index` is the public
    index of copies the mirror holds (osd.mirror.public_index). A duplicate feature_id
    anywhere in the outlines fails the build: it is the key Items and the map share."""
    root = out_dir / "stac"
    shutil.rmtree(root, ignore_errors=True)
    root.mkdir(parents=True, exist_ok=True)
    seen: set[str] = set()
    collections, children = [], []
    for rec in records:
        rid, cid = rec["id"], collection_id(rec["id"])
        op = outlines_dir / (rid.replace("/", "__") + ".geojson")
        fc = load_outline(op) if op.exists() else {"features": []}
        for f in fc["features"]:
            fid = f["properties"].get("feature_id")
            if fid in seen:
                raise ValueError(f"duplicate feature_id '{fid}'")
            if fid:
                seen.add(fid)
        when = interval(rec)
        items = []
        if rec.get("period"):
            items = [_item(rec, cid, f, fc.get("inputs", {}), when)
                     for f in fc["features"] if f["properties"].get("feature_id")]
        names: dict[str, str] = {}
        for it in items:
            n = item_file_name(it["id"])
            if n in names:
                raise ValueError(f"{rid}: item file {n} for both '{names[n]}' and '{it['id']}'")
            names[n] = it["id"]
        vp = vdir / (rid.replace("/", "__") + ".json")
        mirrored = {c["sha256"]: c["href"] for c in mirror_index or [] if c["record_id"] == rid}
        assets = _assets(json.loads(vp.read_text()) if vp.exists() else None, mirrored)
        alternate = any("alternate" in a for a in assets.values())
        lic = rec["licence"]
        spatial = (rec.get("region", {}).get("bbox")
                   or _union([bbox(f["geometry"]) for f in fc["features"] if f.get("geometry")])
                   or WORLD)
        col = {
            "type": "Collection", "stac_version": STAC_VERSION,
            "stac_extensions": [OSD_EXTENSION] + ([FILE_EXTENSION] if assets else [])
                               + ([ALTERNATE_EXTENSION] if alternate else []),
            "id": cid, "title": rec["title"], "description": rec.get("summary") or rec["title"],
            "license": lic.get("spdx") or "other",
            "keywords": rec["kinds"],
            "providers": [{"name": rec["publisher"]["name"], "roles": ["producer", "licensor"],
                           "url": rec["publisher"]["url"]}],
            "extent": {"spatial": {"bbox": [spatial]}, "temporal": {"interval": [when]}},
            "links": [{"rel": "root", "href": "../catalog.json", "type": "application/json"},
                      {"rel": "parent", "href": "../catalog.json", "type": "application/json"},
                      {"rel": "about", "href": rec["origin"]["url"], "title": "Publisher's page"},
                      {"rel": "license", "href": lic.get("url", rec["origin"]["url"]),
                       "title": lic["name"]}]
                     + [{"rel": "item", "href": f"./items/{n}", "type": "application/geo+json"}
                        for n in names],
            "osd:level": rec["level"], "osd:checked_at": rec["checked_at"],
            "osd:access": rec["origin"]["access"], "osd:redistribution": lic["redistribution"],
        }
        if rec.get("blocked_since"):
            col["osd:blocked_since"] = rec["blocked_since"]
        if assets:
            col["assets"] = assets
        d = root / cid
        (d / "items" if items else d).mkdir(parents=True, exist_ok=True)
        (d / "collection.json").write_text(json.dumps(col, indent=2) + "\n")
        for n, it in zip(names, items):
            (d / "items" / n).write_text(json.dumps(it) + "\n")
        collections.append(col)
        children.append({"rel": "child", "href": f"./{cid}/collection.json",
                         "type": "application/json", "title": rec["title"]})
    catalog = {
        "type": "Catalog", "stac_version": STAC_VERSION, "id": "open-subsurface-data",
        "title": "Open Subsurface Data",
        "description": "Open subsurface datasets as their publishers state them, one Collection per "
                       "record, with the level our tools verified.",
        "links": [{"rel": "root", "href": "./catalog.json", "type": "application/json"}] + children,
    }
    (root / "catalog.json").write_text(json.dumps(catalog, indent=2) + "\n")
    return collections


def validate(path: Path, recursive: bool = True, schema_config: Path = SCHEMA_MAP) -> tuple[bool, list]:
    """stac-validator over a local file or tree, against the bundled schemas only."""
    from stac_validator.utilities import fetch_and_parse_schema
def build(out_dir: Path = paths.CATALOG_DIR, vdir: Path = paths.VERIFICATION_DIR,
          now: datetime | None = None, mirror_dir: Path = mirror.MIRROR_DIR,
          records_dir: Path = paths.RECORDS_DIR, source_commit: str | None = FROM_ENVIRONMENT,
          verification_commit: str | None = FROM_ENVIRONMENT) -> dict:
    out_dir.mkdir(parents=True, exist_ok=True)
    recs = load_records(records_dir)
    records_out = []
    reasons = {}
    features = []
    for rid, rec in recs.items():
        v = latest_verification(rid, vdir)
        level = v["level"] if v else "L0"
        checked = v["checked_at"] if v else None
        blocked = (v or {}).get("origin", {}).get("blocked_since")
        joined = dict(rec, level=level, checked_at=checked, stale=is_stale(checked, now), blocked_since=blocked)
        reasons[rid] = reason(v, rec)
        records_out.append(joined)
        op = paths.outline_path(rid)
        if op.exists():
            for f in load_outline(op)["features"]:
                # E18: a feature's dates are its STAC Item's, not map attributes (tippecanoe 2.49
                # wrote other features' values into three tiles with them: evidence/e18/registers.md)
                props = {k: v for k, v in f["properties"].items() if not k.startswith("osd:period_")}
                props.update({
                    "title": rec["title"], "publisher": rec["publisher"]["name"],
                    "kinds": rec["kinds"], "licence": rec["licence"]["name"],
                    "redistribution": rec["licence"]["redistribution"], "level": level,
                })
                fid = {"id": props["feature_id"]} if "feature_id" in props else {}
                features.append({"type": "Feature", **fid, "properties": props, "geometry": f["geometry"]})
    catalog = {
        "source_commit": git_head() if source_commit == FROM_ENVIRONMENT else source_commit,
        "verification_commit": (verification_commit_from_env() if verification_commit == FROM_ENVIRONMENT
                                else verification_commit),
        "built_at": (now or datetime.now(UTC)).strftime("%Y-%m-%dT%H:%M:%SZ"),
        "records_digest": records_digest(records_out),
    }
    (out_dir / "records.json").write_text(json.dumps(
        {"tool_version": __version__, "count": len(records_out), "catalog": catalog, "records": records_out,
         "reasons": reasons},
        indent=2) + "\n")
    (out_dir / "outlines.geojson").write_text(json.dumps(
        {"type": "FeatureCollection", "features": features}) + "\n")
    index = mirror.public_index(mirror_dir / "custody")
    (out_dir / "mirror.json").write_text(json.dumps({"copies": index}, indent=2) + "\n")
    collections = stac.write_catalog(out_dir, records_out, vdir, mirror_index=index)
    (out_dir / "collections.json").write_text(json.dumps({"collections": collections}, indent=2) + "\n")
    write_tiles(out_dir) if out_dir == paths.CATALOG_DIR else None  # test builds into tmp dirs skip tiling
    return {"records": len(records_out), "features": len(features), "collections": len(collections)}


# Tiling (E15). One source layer, "outlines", every GeoJSON property kept. Points are kept at every
# zoom (-r1) and clustered by the page; polygons are simplified by tippecanoe below zoom 8 only, so
# z0-7 and z8-12 are two runs joined. Pinned in CI: Ubuntu 24.04 tippecanoe 2.49.0-1build1.
TIPPECANOE_PIN = "2.49.0"
TILE_RUNS = (
    ["-Z0", "-z7"],
    ["-Z8", "-z12", "--no-line-simplification"],
)
TILE_COMMON = ["-q", "-f", "-l", "outlines", "-r1", "--no-feature-limit", "--no-tile-size-limit",
               "--no-tiny-polygon-reduction"]


def write_tiles(out_dir: Path, cache_dir: Path = paths.BUILD_DIR / "tiles") -> Path | None:
    """out_dir/outlines.pmtiles from out_dir/outlines.geojson, or None with a notice when
    tippecanoe is absent (the page then reads the GeoJSON whole). Cached by input and tool version,
    so a second build of the same outlines (the site test's) costs a copy."""
    import hashlib
    import shutil
    import subprocess
    import sys
    import tempfile

    src, dst = out_dir / "outlines.geojson", out_dir / "outlines.pmtiles"
    dst.unlink(missing_ok=True)
    if not (shutil.which("tippecanoe") and shutil.which("tile-join")):
        print("notice: tippecanoe not found, outlines.pmtiles not written; the map reads outlines.geojson "
              f"whole (install tippecanoe {TIPPECANOE_PIN}, see .github/workflows/ci.yml)", file=sys.stderr)
        return None
    version = subprocess.run(["tippecanoe", "--version"], capture_output=True, text=True, check=False).stderr.strip()
    key = hashlib.sha256(src.read_bytes())
    key.update(json.dumps([version, TILE_RUNS, TILE_COMMON]).encode())
    cached = cache_dir / f"outlines-{key.hexdigest()[:16]}.pmtiles"
    if not cached.exists():
        cache_dir.mkdir(parents=True, exist_ok=True)
        with tempfile.TemporaryDirectory() as tmp:
            parts = [Path(tmp) / f"z{i}.pmtiles" for i in range(len(TILE_RUNS))]
            runs = [subprocess.Popen(["tippecanoe", *TILE_COMMON, *zooms, "-o", str(part), str(src)],
                                     stderr=subprocess.PIPE, text=True) for zooms, part in zip(TILE_RUNS, parts)]
            for r in runs:
                err = r.communicate()[1]
                if r.returncode:
                    raise RuntimeError(f"tippecanoe failed: {err}")
            joined = Path(tmp) / "outlines.pmtiles"
            j = subprocess.run(["tile-join", "-q", "-f", "--no-tile-size-limit", "-o", str(joined), *map(str, parts)],
                               capture_output=True, text=True, check=False)
            if j.returncode:
                raise RuntimeError(f"tile-join failed: {j.stderr}")
            for old in cache_dir.glob("outlines-*.pmtiles"):
                old.unlink()
            shutil.move(joined, cached)
    shutil.copyfile(cached, dst)
    note = "" if TIPPECANOE_PIN in version else f" (CI pins {TIPPECANOE_PIN})"
    print(f"tiles: {dst.name} {dst.stat().st_size / 1e6:.1f} MB, z0-12, {version}{note}", file=sys.stderr)
    return dst
# One target per station. CI runs exactly `make check`.
.PHONY: check check-full test lint validate build verify site serve clean site-deps site-test shot

check: lint test validate build          ## the required CI check (offline, < 2 min)

lint:
	uv run ruff check src tests

test:
	uv run pytest -q

validate:                                ## every record and outline against its schema
	uv run osd validate

build:                                   ## build/catalog/*.json, outlines.pmtiles (tippecanoe) + site/data/
	uv run osd build
	mkdir -p site/data && rm -rf site/data/stac site/data/*.pmtiles && cp -R build/catalog/. site/data/   # stac/ is a tree; tiles only when tippecanoe ran (E15)
	ls site/data | grep -vx files.txt > site/data/files.txt   # the map reads optional files from this list

check-full: build                        ## the whole STAC tree, every Item (OSD-D18; verify workflow on main, not the gate)
	uv run python -c "import sys; from pathlib import Path; from osd import stac; ok, m = stac.validate(Path('site/data/stac/catalog.json')); print(len(m), 'STAC objects', 'valid' if ok else 'INVALID'); sys.exit(not ok)"

verify:                                  ## network: reach origins, record levels (not part of `check`)
	uv run osd verify

site: build                              ## serve the map locally
	python3 -m http.server --directory site 8765

site-deps:                               ## Playwright and Chromium for the site test (not part of `check`)
	npm install --no-audit --no-fund
	npx playwright install chromium

site-test: build                         ## Playwright against the local site (not part of `check` yet)
	npm run --silent site-test

shot: build                              ## desktop and phone screenshots into build/shots/
	mkdir -p build/shots
	node tools/shot.mjs build/shots

clean:
	rm -rf build site/data
