   125	def dead_reports(before_dir: Path, after_dir: Path, open_titles: set[str] = frozenset()) -> dict:
   126	    """{"open": [issue...], "reported": [id...], "blocked": [id...]}, each sorted by record id."""
   127	    before, after = _results(before_dir), _results(after_dir)
   128	    out: dict[str, list] = {"open": [], "reported": [], "blocked": []}
   129	    for rid, a in sorted(after.items()):
   130	        b = before.get(rid)
   131	        if not b or b.get("level", "L0") == "L0":
   132	            continue  # never verified before, or not reachable last time either
   133	        reach = a.get("origin", {}).get("reachability")
   134	        if reach == "blocked":
   135	            out["blocked"].append(rid)
   136	            continue
   137	        if reach != "dead" or a["level"] != "L0":
   138	            continue
   139	        title = TITLE.format(rid)
   140	        if title in open_titles:
   141	            out["reported"].append(rid)
   142	            continue
   143	        out["open"].append({"record_id": rid, "title": title, "http_class": http_class(a),
   144	                            "died": a["checked_at"][:10], "label": LABEL, "body": _body(rid, b, a)})
