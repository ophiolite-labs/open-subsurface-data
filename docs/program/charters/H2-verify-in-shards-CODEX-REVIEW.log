   772	def verify_all(ids: list[str] | None = None, fetch: Fetcher | None = None, opener: Opener | None = None,
   773	               out_dir: Path = paths.VERIFICATION_DIR, budget: ByteBudget | None = None,
   774	               derive: bool = False, fetch_inputs: bool = False, inputs_dir: Path = outlines.INPUTS_DIR,
   775	               outlines_dir: Path = paths.OUTLINES_DIR, browser_probe: BrowserProbe | None = None) -> list[dict]:
   776	    """Defaults are the network, paced; tests inject both and are not paced. `derive` (osd verify
   777	    --outlines) refetches the inputs of records that have outline rules and rewrites their outlines;
   778	    `fetch_inputs` (--outline-inputs) refetches them and checks the committed outlines against them."""
   779	    if fetch is None and opener is None:
