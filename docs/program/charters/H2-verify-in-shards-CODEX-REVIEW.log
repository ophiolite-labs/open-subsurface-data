    52	def period_instant(raw: str, bound: str, form: str = "iso") -> str | None:
    53	    """A publisher's date or timestamp as an RFC 3339 UTC instant, or None when it is not in the
    54	    form the rule names. A date is its first second for a start and its last for an end; a
    55	    timestamp without a zone is read as UTC. form: iso (YYYY-MM-DD, YYYY-MM-DDThh:mm:ss[.f][zone])
    56	    or m/d/y (FactMaps GeoJSON: M/D/YYYY[ h:mm:ss AM|PM])."""
    57	    try:
    58	        if form == "m/d/y":
    59	            m = MDY.fullmatch(raw)
    60	            if not m:
    61	                return None
    62	            mo, d, y, h, mi, sec, ampm = m.groups()
    63	            if h is None:
    64	                when, is_date = datetime(int(y), int(mo), int(d)), True
    65	            else:
    66	                if not 1 <= int(h) <= 12:
    67	                    return None
    68	                hour = int(h) % 12 + (12 if ampm == "PM" else 0)
    69	                when, is_date = datetime(int(y), int(mo), int(d), hour, int(mi), int(sec)), False
    70	        elif ISO_DATE.fullmatch(raw):
    71	            when, is_date = datetime.strptime(raw, "%Y-%m-%d"), True
    72	        elif ISO_TIME.fullmatch(raw):
    73	            when, is_date = datetime.fromisoformat(raw), False
    74	        else:
    75	            return None
    76	    except ValueError:
    77	        return None
    78	    if is_date:
    79	        return when.strftime("%Y-%m-%dT23:59:59Z" if bound == "end" else "%Y-%m-%dT00:00:00Z")
    80	    if when.tzinfo is not None:
    81	        when = when.astimezone(UTC)
    82	    return when.strftime("%Y-%m-%dT%H:%M:%SZ")
