   222	def cmd_mirror_remove(a: argparse.Namespace) -> int:
   223	    try:
   224	        gone = mirror_mod.remove(a.sha256, _store(a), request=a.request, approved_by=a.approved_by)
   225	    except mirror_mod.MirrorError as e:
   226	        print(f"refused: {e}")
   227	        return 1
   228	    for k in gone:
   229	        print(f"  deleted   {k}")
   230	    print(f"  tombstone custody/{a.sha256}.removed.json (osd mirror never copies this digest again)")
   231	    return 0
