   757	def derive_outline(rec: dict, rules: dict, opener: Opener, inputs_dir: Path, outline_path: Path,
   758	                   rewrite: bool) -> str | None:
   759	    """Fetch the record's inputs and derive from them; `rewrite` (--outlines) replaces the committed
   760	    file, otherwise (--outline-inputs, the verify workflow) the committed file is checked against
   761	    today's bytes. Returns the reason when refused."""
   762	    try:
   763	        outlines.fetch_inputs(rec, rules, opener, inputs_dir)
   764	        fc = outlines.derive(rec, rules, inputs_dir)
   765	        if rewrite:
   766	            outlines.write_outline(fc, outline_path)
   767	    except outlines.Refused as e:
   768	        return str(e)
   769	    return None
