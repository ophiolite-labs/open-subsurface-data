    43	def problems(doc: dict, name: str | None = None, object_bytes: int | None = None) -> list[str]:
    44	    out = [f"{'/'.join(map(str, e.absolute_path)) or '(root)'}: {e.message}"
    45	           for e in sorted(_validator().iter_errors(doc), key=lambda e: list(map(str, e.absolute_path)))]
    46	    if out:
    47	        return out
    48	    if doc["key"] != object_key(doc["record_id"], doc["sha256"], doc["path"]):
    49	        out.append(f"key {doc['key']} is not {object_key(doc['record_id'], doc['sha256'], doc['path'])}")
    50	    if name is not None:
    51	        tomb = name.endswith(".removed.json")
    52	        if name != doc["sha256"] + (".removed.json" if tomb else ".json"):
    53	            out.append(f"file name {name} does not name the digest {doc['sha256']}")
    54	        if tomb != (doc["removal"]["state"] == "removed"):
    55	            out.append(f"removal state {doc['removal']['state']} in {name}")
    56	    if object_bytes is not None and object_bytes != doc["bytes"]:
    57	        out.append(f"inconsistent size: the document states {doc['bytes']} bytes, the stored object has {object_bytes}")
    58	    return out
