   116	def item_period(props: dict, collection: list) -> tuple[list, str]:
   117	    """(interval, osd:period_source) of one outline feature in a Collection with that interval:
   118	    the feature's own normalised start and end when both are there in order; its start and the
   119	    Collection's end when it states no usable end and starts by then; otherwise the Collection's."""
   120	    start, end = props.get("osd:period_start"), props.get("osd:period_end")
   121	    if start and end and start <= end:
   122	        return [start, end], "feature"
   123	    if start and not end and collection[1] and start <= collection[1]:
   124	        return [start, collection[1]], "feature-start,collection-end"
   125	    return list(collection), "collection"
