     1	"""Why a record is at its level, in the verifier's own words: the one source of that sentence.
     2	
     3	`osd status` prints it and `osd build` writes it into records.json as `reason`, so the terminal, the
     4	map's detail panel and the status page read the same string (E27; the rules are E23's and H1's).
     5	
     6	- never verified: "never verified".
     7	- blocked (OSD-D9, OSD-D20): the origin check's detail, e.g. "origin-reachable: answers a browser, not
     8	  the verifier (HTTP 404 to osd-verifier, HTTP 200 to a browser agent); blocked since 2026-10-23".
     9	- below L2: the first check of the level above the record's that did not pass, as "<check>: <detail>";
    10	  an L0 record names its origin check, an L1 record its first L2 check. The one rewording: a record
    11	  that states no `origin.manifest_url` reads "no file address is published to us", with its access.
    12	- L2 and above: the detail of the check that awarded the level (files hashed, outline derived,
    13	  conversion), without the check name.
    14	"""
    15	
    16	from __future__ import annotations
    17	
    18	from .verify import LEVELS
    19	
    20	EVIDENCE = {"L2": "files-checksummed", "L3": "outline-derived", "L4": "canonical-conversion"}
    21	NO_MANIFEST = "no origin.manifest_url"
    22	
    23	
    24	def reason(v: dict | None, rec: dict | None = None) -> str:
    25	    """The sentence for verification `v` of record `rec` (rec only words the no-listing case)."""
    26	    if v is None:
    27	        return "never verified"
    28	    checks = v.get("checks", [])
    29	    if v.get("origin", {}).get("reachability") == "blocked":
    30	        for c in checks:
    31	            if c["name"] == "origin-reachable":
    32	                return f"{c['name']}: {c.get('detail') or c['outcome']}"
    33	    level = LEVELS.index(v["level"])
    34	    if level >= LEVELS.index("L2"):
    35	        name = EVIDENCE.get(v["level"])
    36	        return next((c.get("detail", "") for c in checks if c["name"] == name and c["outcome"] == "pass"), "")
    37	    for above in LEVELS[level + 1:]:
    38	        for c in checks:
    39	            if c["level"] == above and c["outcome"] != "pass":
    40	                detail = c.get("detail") or c["outcome"]
    41	                if c["name"] == "files-checksummed" and detail == NO_MANIFEST:
    42	                    access = f"; access {rec['origin']['access']}" if rec else ""
    43	                    detail = f"no file address is published to us ({NO_MANIFEST}{access})"
    44	                return f"{c['name']}: {detail}"
    45	    return ""
