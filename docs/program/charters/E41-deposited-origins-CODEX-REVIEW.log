   132	             "osd:period_source": source, "osd:approximate": p["approximate"], "osd:derivation": p["source"]}
   133	    sha = inputs.get(p.get("input"), {}).get("sha256")
   134	    if sha:
   135	        props["osd:input_sha256"] = sha
