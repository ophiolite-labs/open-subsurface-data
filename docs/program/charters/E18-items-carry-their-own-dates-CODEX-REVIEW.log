    80	def geojson_page(b: bytes) -> dict:
    81	    """A GeoJSON page. FactMaps writes two things that are not JSON: `[nan,nan]` for a wellbore
    82	    without a position and `{"type":"MultiPolygon",}` for a survey without an area; both read as
    83	    a geometry without coordinates (the rule decides: unplaced: report, or refuse)."""
    84	    return json.loads(EMPTY_GEOMETRY.sub(rb'{"type":"\1","coordinates":null}', NAN_POSITION.sub(b"null", b)))
