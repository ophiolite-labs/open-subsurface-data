   101	def _get(url: str, opener, robots) -> bytes:
   102	    from ..verify import FetchError, _read  # verify imports this package
   103	
   104	    if not robots.allowed(url):
   105	        raise Refused(f"robots.txt disallows {url}")
   106	    try:
   107	        b = _read(opener(url), PART_BYTES)
   108	    except FetchError as e:
   109	        raise Refused(f"fetch failed: {e}") from None
   110	    if len(b) >= PART_BYTES:
   111	        raise Refused(f"{url} is larger than {PART_BYTES} bytes: not read in part")
   112	    return b
