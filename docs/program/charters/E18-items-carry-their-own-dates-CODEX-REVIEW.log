    66	def read_parts(d: Path) -> list[tuple[str, bytes]]:
    67	    """The parts in fetch order; a part whose bytes no longer match SHA256SUMS is refused."""
    68	    sums = d / "SHA256SUMS"
    69	    if not sums.exists():
    70	        raise Refused(f"input not fetched: no {sums}")
    71	    parts = []
    72	    for line in sums.read_text().splitlines():
    73	        sha, name = line.split("  ", 1)
    74	        b = (d / name).read_bytes()
    75	        if hashlib.sha256(b).hexdigest() != sha:
    76	            raise Refused(f"stored part {d / name} changed since it was fetched")
    77	        parts.append((name, b))
    78	    return parts
