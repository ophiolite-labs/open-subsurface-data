   115	def item_sample(collection_dir: Path) -> list[Path]:
   116	    """First and last Item by file name, plus up to ITEM_SAMPLE between them chosen by a fixed seed."""
   117	    items = sorted((collection_dir / "items").glob("*.json"))
   118	    if len(items) <= 2:
