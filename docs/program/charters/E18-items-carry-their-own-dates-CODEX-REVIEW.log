   168	
   169	def _inputs_with_rules(rec: dict, rules: dict) -> list[dict]:
   170	    rid, inputs = rec["id"], rec.get("inputs") or []
   171	    if not inputs:
   172	        raise Refused("the record declares no inputs")
   173	    names = [i["name"] for i in inputs]
   174	    if len(set(names)) != len(names):
   175	        raise Refused(f"input names repeat: {names}")
   176	    rule = (rules.get(rid) or {}).get("inputs") or {}
   177	    todo = [i for i in inputs if i["name"] in rule]
   178	    if not todo:
   179	        raise Refused(f"no rule in outlines/rules.yaml for any input of {rid}")
   180	    return todo
   181	
   182	
   183	# --- deriving (pure) -------------------------------------------------------------------------
   184	
   185	def derive(rec: dict, rules: dict, inputs_dir: Path = INPUTS_DIR) -> dict:
   186	    """The FeatureCollection for outlines/<id>.geojson, from the stored inputs only."""
   187	    rid = rec["id"]
   188	    feats, unplaced, used = [], [], {}
   189	    defaults = rules.get("defaults") or {}
   190	    tolerance = rules[rid].get("simplify_m", defaults.get("simplify_m", SIMPLIFY_M))
   191	    decimals = rules[rid].get("polygon_decimals", defaults.get("polygon_decimals", POLYGON_DECIMALS))
   192	    exteriors = set(rules[rid].get("exteriors_only") or [])
   193	    for i in _inputs_with_rules(rec, rules):
   194	        rule = rules[rid]["inputs"][i["name"]]
   195	        parts = read_parts(_dir(inputs_dir, rid, i["name"]))
   196	        used[i["name"]] = {"url": i["url"], "sha256": input_sha256(parts)}
   197	        for f in EXTRACTORS[rule["extractor"]](i, rule, parts):
   198	            g = f.pop("geometry")
   199	            key = f.get("publisher_id") or f.get("uwi") or i["name"]
   200	            if rule.get("id_scope"):  # a publisher numbering several registers from one sequence
   201	                key = f"{rule['id_scope']}/{key}"
   202	            if g is None:  # the register lists it without a position (rule unplaced: report)
   203	                unplaced.append(f"{rid}#{key}")
   204	                continue
   205	            how = ""
   206	            if g["type"] in ("Polygon", "MultiPolygon"):  # OSD-D16; points stay exact
   207	                ext = f["kind"] in exteriors
   208	                g, f["rings_dropped"] = simplify(g, tolerance, ext, decimals)
   209	                f["simplified_m"] = tolerance
   210	                how = f", simplified {tolerance} m{', exterior only' if ext else ''}, {decimals} decimals"
   211	            bad = geometry_problems(g)
   212	            if bad:
   213	                raise Refused(f"{i['name']}: {f.get('publisher_id') or f['name']}: {bad[0]}")
   214	            props = {"record_id": rid, "kind": f.pop("kind"), "name": f.pop("name"), "approximate": False,
   215	                     "source": f"{rule['extractor']} ({i['name']}){how}", **f, "feature_id": f"{rid}#{key}",
   216	                     "input": i["name"]}
   217	            feats.append({"type": "Feature", "properties": props, "geometry": g})
   218	    dup = [k for k, n in Counter([f["properties"]["feature_id"] for f in feats] + unplaced).items() if n > 1]
   219	    if dup:
   220	        raise Refused(f"{len(dup)} feature_id collisions, e.g. {dup[0]}")
   221	    feats.sort(key=lambda f: f["properties"]["feature_id"])
   222	    fc = {"type": "FeatureCollection", "licence": rec["licence"]["name"], "inputs": used, "features": feats}
   223	    if unplaced:
   224	        fc["unplaced"] = sorted(unplaced)  # GeoJSON foreign member: listed, no position to draw
   225	    return fc
   226	
   227	
   228	def write_outline(fc: dict, path: Path) -> None:
   229	    """One feature per line: a rerun is a reviewable diff (OSD-D12)."""
   230	    lines = [json.dumps(f, ensure_ascii=False, separators=(",", ":")) for f in fc["features"]]
   231	    head = '{"type":"FeatureCollection",'
   232	    for k in ("licence", "inputs"):
   233	        if k in fc:
   234	            head += json.dumps(k) + ":" + json.dumps(fc[k], ensure_ascii=False, separators=(",", ":")) + ",\n"
   235	    if fc.get("unplaced"):
   236	        head += '"unplaced":' + json.dumps(fc["unplaced"], ensure_ascii=False) + ",\n"
   237	    path.write_text(head + '"features":[\n' + ",\n".join(lines) + "\n]}\n")
   238	
   239	
   240	# --- the L3 check ------------------------------------------------------------------------------
   241	
   242	def check(rec: dict, outline: dict, rule: dict | None, stored: dict[str, str],
   243	          refused: str | None = None) -> tuple[str, str]:
   244	    """(outcome, detail) of `outline-derived`: pass only when every feature is derived and names
   245	    an input of the collection whose (url, sha256) is a stored input of the record, ids are unique
   246	    and the count reaches the rules' min_features."""
   247	    feats = outline.get("features") or []
   248	    if refused:
   249	        return "fail", f"derivation refused this run: {refused}"
   250	    if not feats:
   251	        return "fail", "no features"
   252	    props = [f.get("properties") or {} for f in feats]
   253	    approx = sum(1 for p in props if p.get("approximate") is not False)
   254	    if approx:
   255	        return "fail", f"{approx} approximate features"
   256	    named = outline.get("inputs") or {}
   257	    lacking = sum(1 for p in props if not (p.get("feature_id") and (named.get(p.get("input")) or {}).get("sha256")))
   258	    if lacking:
   259	        return "fail", f"{lacking} features without feature_id or an input the collection carries"
   260	    dup = [k for k, n in Counter(p["feature_id"] for p in props).items() if n > 1]
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-subsurface-data.org/schema/outline/2",
  "title": "Outline feature properties, version 2",
  "description": "Properties every feature in outlines/<record-id>.geojson carries; $defs.collection is the file's own members. Geometry is WGS84 (EPSG:4326). A feature is one wellbore (Point), one survey or field (Polygon or MultiPolygon) or one line (LineString). Version 2: a derived feature (approximate: false) carries feature_id and the name of its input; the collection carries each input's identity once and the licence once (per feature only where it differs within a file). Every version-1 placeholder still validates.",
  "type": "object",
  "required": [
    "record_id",
    "kind",
    "name",
    "approximate",
    "source"
  ],
  "properties": {
    "record_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "wellbore",
        "survey-3d",
        "survey-2d",
        "field",
        "block",
        "dataset-extent"
      ]
    },
    "name": {
      "type": "string"
    },
    "approximate": {
      "type": "boolean",
      "description": "true when the geometry is a placeholder (centroid, hand-drawn box) and not derived from the data; the map draws it differently and L3 requires false"
    },
    "source": {
      "type": "string",
      "description": "How the geometry was derived: the extractor and the input name of its rule in src/osd/outlines/rules.yaml, or 'hand placed from publisher map' for a placeholder"
    },
    "uwi": {
      "type": "string"
    },
    "publisher_id": {
      "type": "string",
      "description": "The publisher's own identifier for the wellbore or survey"
    },
    "feature_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*#.+$",
      "description": "<record-id>#[<id_scope>/]<publisher_id|uwi>, unique within the collection"
    },
    "licence": {
      "type": "string",
      "description": "The record's licence when it differs within a file; otherwise the collection's licence applies (OSD-D13)"
    },
    "simplified_m": {
      "type": "number",
      "minimum": 0,
      "description": "Douglas-Peucker tolerance in metres applied to a derived polygon's rings (OSD-D16); absent on points and placeholders"
    },
    "input": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "description": "The name of the record input the geometry was derived from: a key of the collection's inputs"
    },
    "rings_dropped": {
      "type": "integer",
      "minimum": 0,
      "description": "Rings of a derived polygon dropped because their area was below simplified_m squared (OSD-D16)"
    }
  },
  "if": {
    "properties": {
      "approximate": {
        "const": false
      }
    },
    "required": [
      "approximate"
    ]
  },
  "then": {
    "required": [
      "feature_id",
      "input"
    ]
  },
  "$defs": {
    "collection": {
      "description": "Members of the FeatureCollection beside type and features",
      "type": "object",
      "properties": {
        "licence": {
          "type": "string",
          "description": "The licence of the record the features were derived from (OSD-D13)"
        },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "additionalProperties": {
            "type": "object",
            "required": [
              "url",
              "sha256"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "format": "uri",
                "description": "The record input's url"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$",
                "description": "sha256 of the input's SHA256SUMS (one sha256sum line per fetched part, in fetch order)"
              }
            }
          }
        },
        "unplaced": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true,
          "description": "feature_ids the publisher lists without a position: not drawn"
        }
      }
    }
  }
}
{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/ophiolite-labs/open-subsurface-data/main/schema/stac-osd.json",
  "title": "Open Subsurface Data (osd) STAC extension, v1.0.0",
  "description": "Collection fields state what our tools established about the whole record (record-level assurance, not per file or per feature). Item fields state how one feature's geometry was obtained. Enums are closed and no other osd: field is allowed. Offline validation maps this URL to schema/stac-osd.json (schema/stac/schema-map.json).",
  "type": "object",
  "oneOf": [
    {
      "$comment": "Item",
      "allOf": [
        {
          "type": "object",
          "required": ["type", "properties"],
          "properties": {
            "type": {"const": "Feature"},
            "properties": {"$ref": "#/definitions/item_fields"}
          }
        },
        {"$ref": "#/definitions/stac_extensions"}
      ]
    },
    {
      "$comment": "Collection",
      "allOf": [
        {"type": "object", "required": ["type"], "properties": {"type": {"const": "Collection"}}},
        {"$ref": "#/definitions/collection_fields"},
        {"$ref": "#/definitions/stac_extensions"}
      ]
    }
  ],
  "definitions": {
    "stac_extensions": {
      "type": "object",
      "required": ["stac_extensions"],
      "properties": {
        "stac_extensions": {
          "type": "array",
          "contains": {"const": "https://raw.githubusercontent.com/ophiolite-labs/open-subsurface-data/main/schema/stac-osd.json"}
        }
      }
    },
    "collection_fields": {
      "type": "object",
      "required": ["osd:level", "osd:checked_at", "osd:access", "osd:redistribution"],
      "properties": {
        "osd:level": {
          "type": "string", "enum": ["L0", "L1", "L2", "L3", "L4"],
          "description": "The record's latest verification level: L0 listed; L1 origin reachable; L2 files checksummed and licence text captured; L3 outlines extracted by a reader; L4 converted with a fidelity record"
        },
        "osd:checked_at": {
          "type": ["string", "null"], "format": "date-time",
          "description": "When that level was established; null when the record was never verified"
        },
        "osd:access": {
          "type": "string", "enum": ["anonymous", "registration", "api", "request"],
          "description": "As the record states it: anonymous, a free account, a documented service, or a human approves"
        },
        "osd:redistribution": {
          "type": "string", "enum": ["allowed", "restricted", "forbidden", "unknown"],
          "description": "May a third party host a copy, as the record states it"
        },
        "osd:blocked_since": {
          "type": "string", "format": "date-time",
          "description": "Present while the origin refuses our runner: the first check of the current blocked run (OSD-D9)"
        }
      },
      "patternProperties": {"^(?!osd:)": {}},
      "additionalProperties": false
    },
    "item_fields": {
      "type": "object",
      "required": ["osd:approximate", "osd:derivation"],
      "properties": {
        "osd:approximate": {
          "type": "boolean",
          "description": "true when the geometry is a placeholder, not derived from the data"
        },
        "osd:derivation": {
          "type": "string", "minLength": 1,
          "description": "How the geometry was derived: the outline feature's source"
        },
        "osd:input_sha256": {
          "type": "string", "pattern": "^[0-9a-f]{64}$",
          "description": "sha256 of the input the geometry was derived from, as the outline collection's inputs state it"
        }
      },
      "patternProperties": {"^(?!osd:)": {}},
      "additionalProperties": false
    }
  }
}
# One target per station. CI runs exactly `make check`.
.PHONY: check check-full test lint validate build verify site serve clean site-deps site-test shot

check: lint test validate build          ## the required CI check (offline, < 2 min)

lint:
	uv run ruff check src tests

test:
	uv run pytest -q

validate:                                ## every record and outline against its schema
	uv run osd validate

build:                                   ## build/catalog/*.json, outlines.pmtiles (tippecanoe) + site/data/
	uv run osd build
	mkdir -p site/data && rm -rf site/data/stac site/data/*.pmtiles && cp -R build/catalog/. site/data/   # stac/ is a tree; tiles only when tippecanoe ran (E15)
	ls site/data | grep -vx files.txt > site/data/files.txt   # the map reads optional files from this list

check-full: build                        ## the whole STAC tree, every Item (OSD-D18; verify workflow on main, not the gate)
	uv run python -c "import sys; from pathlib import Path; from osd import stac; ok, m = stac.validate(Path('site/data/stac/catalog.json')); print(len(m), 'STAC objects', 'valid' if ok else 'INVALID'); sys.exit(not ok)"

verify:                                  ## network: reach origins, record levels (not part of `check`)
	uv run osd verify

site: build                              ## serve the map locally
	python3 -m http.server --directory site 8765

site-deps:                               ## Playwright and Chromium for the site test (not part of `check`)
	npm install --no-audit --no-fund
	npx playwright install chromium

site-test: build                         ## Playwright against the local site (not part of `check` yet)
	npm run --silent site-test

shot: build                              ## desktop and phone screenshots into build/shots/
	mkdir -p build/shots
	node tools/shot.mjs build/shots

clean:
	rm -rf build site/data
## E16 Periods from the publishers — QUEUED · Records · no strategy, no Codex round

Authority: OSD-D14 (STAC Items need a datetime or a bounded interval; Items only where a record
declares a `period`); E04 as merged (record/2 optional `period`).

**Outcome.** A STAC client lists Items, not only Collections: every record whose publisher states
an acquisition, drilling or release period carries it, quoted as the publisher states it, and the
published catalogue has Items for every outlined feature of those records.

**Context today (after E04 merges).** 68 records, none with `period`; the STAC tree has 68
Collections and 0 Items. `period` is `{start, end}` strings (ISO dates or years as the publisher
states them; `records.py` coerces unquoted YAML dates and ints). Outlined records: Sodir, NLOG,
Poseidon, Parihaka, Kerry 3D (derived); F3, Teapot Dome (placeholders).

**The design the lane must map to.**
1. One `period` per record, from the publisher's own page or register (survey year, drilling
   years, release date), with `stated` text in `notes` or the record's existing field where short;
   never inferred from a file name or from another aggregator.
2. Registers (Sodir, NLOG) get the register's own coverage period as the publisher states it
   (first wellbore year to today, or the register's stated range); per-feature dates are E03's
   business, not this lane's.
3. Target: every record whose publisher states a period, expected at least forty of 68; the PR
   lists the records without a stated period and why.

**Acceptance.**
- `uv run osd validate`: 68 records, 0 problems; every `period` has `start <= end` (existing test).
- `make build` then a count: Items emitted for every outlined record with a period; the PR shows
  the Item count per collection for the five derived-outline records.
- The verify comment on the PR shows no level change (periods do not touch levels).
- Hand count in the PR: records with a period, records without, by reason.

**Out of scope.** Schema changes, outlines, levels.

**Ownership and dependencies.** Records lane; paths `records/**`, `docs/program/evidence/e16/**`.
Depends on E04 (merged).

**Evidence to inspect.** The Item counts; the verify comment; a QGIS Item screenshot (owner, with
action 102).
## E03 Outlines from the data — QUEUED · Kernel · strategy at lane open · Codex round done 23 Oct (REWORK, dispositions below; no second round)

Authority: `docs/ARCHITECTURE.md`; owner direction 23 Oct ("display the outlines of known
available wellbores, seismic outlines on a map"); OSD-D11, OSD-D12, OSD-D13.

**Outcome.** Outlines on the map are derived from the publisher's own register or from the data,
with the input identity and derivation named on every feature. Target set, by record id:
`sodir/factpages` (every wellbore and every seismic survey Sodir publishes), `nlog/nlog` (every
borehole and 3D survey NLOG publishes), `terranubis/f3-demo-2020`, `rmotc/teapot-dome`,
`nopims/poseidon`, `nzpam/parihaka`, `nzpam/kerry-3d` (one survey polygon each). A target the
lane cannot reach (login, blocked, undeclared units) is reported by id with the reason and stays
dashed; the epic is DONE when every target is either solid or reported.

**Context today (verified 23 Oct, main e58e2f5).** Five outline files exist, all hand placed with
`approximate: true` (`outlines/*.geojson`). `schema/outline.schema.json` fixes the properties;
`uwi` and `publisher_id` are optional. `src/osd/verify.py` marks `outline-derived` fail when any
feature is approximate and `skip` otherwise (no pass path yet). Outline validation accepts
MultiPolygon without checking coordinates (`src/osd/records.py`). External prerequisites, not
verified in code: Sodir FactMaps serves WFS (asserted in the record), NLOG serves WFS and CSV,
the four SEG-Y surveys carry coordinates in trace headers.

**The design the lane must map to.**
1. Records hold only publisher facts for inputs: an `inputs:` list, each `{name, url, crs,
   format}` as the publisher states them (schema bump to record/2 with a test that every version-1
   file still validates; claimed here, coordinated after E02 merges). Rules live in
   `src/osd/outlines/rules.yaml` keyed by record id (OSD-D11).
2. Fetching happens only through the verifier's injected fetcher (`osd verify --outlines` fetches
   the inputs, stores bytes under `build/inputs/<id>/`, records their sha256); extractors are pure
   functions over local bytes: `register-wfs`, `register-csv`, `segy-hull`, `publisher-file`.
3. Each input is bound to its own CRS, coordinate fields, units and scalar; an input whose CRS or
   units are not declared is refused with a reason (no guessing). Transform with `pyproj`; test
   known coordinates and axis order.
4. A derived feature carries `approximate: false`, `source` (rule), `input_url`,
   `input_sha256`, `feature_id` (collection-scoped: `<record-id>#<publisher_id|uwi>`, required for
   derived features, collisions refused), `licence` (from the record, OSD-D13). Point for
   wellbores, Polygon or MultiPolygon for surveys and fields, LineString for 2D lines; every ring
   validated closed and non-empty.
5. The verifier's `outline-derived` check passes only when every feature of the file is derived,
   the file's `input_sha256` values match the stored inputs, and the feature count is at least the
   count recorded in the rules file for that id (nonempty target). L3 still requires L2.
6. Committed outlines are the contract (OSD-D12); the extractor is rerun on demand and the diff
   reviewed. PMTiles is not produced here (E05 decides its own tiling).

**Acceptance.**
- Sodir: the set of wellbore `publisher_id`s equals the id set of a frozen, paginated fixture of
  the WFS response (exact set equality, unique ids); the live count on the Sodir table page on the
  day of the run is recorded by hand as supplementary evidence.
- NLOG: same shape for boreholes and 3D surveys.
- F3: the hull from an irregular trace-header fixture with a known exact hull (corner coordinates
  listed in the test) matches to 1 m; a mutation that replaces the hull with a bounding box fails
  it; a mutation that swaps the x/y header bytes fails the known-coordinate test.
- Negative cases, each its own test: missing `inputs`, empty response, undeclared CRS, undeclared
  units, a feature with `approximate: true`, a duplicate `feature_id`: none reaches
  `outline-derived pass`.
- After the run, `osd status` shows L3 for every reached target and the PR lists each unreached
  target with its reason.
- Every version-1 record still validates under record/2 (test).

**Out of scope.** Rendering and tiling (E05), STAC items (E04), any dataset not in the target set.

**Stop rules.** A publisher's WFS carries no licence statement for the outlines: stop that
target, add a D item, continue with the rest. A survey's SEG-Y headers do not declare units: report
it, keep it dashed.

**Ownership and dependencies.** Coding lane; paths `src/osd/outlines/**`, `src/osd/verify.py`
(outline checks only, after E02 merges), `src/osd/records.py` (outline validation),
`schema/record.schema.json` (record/2: `inputs`), `schema/outline.schema.json` (new required
properties for derived features), `outlines/**`, `records/<targets>.yaml` (`inputs` only),
`pyproject.toml` (pyproj, segyio), `tests/test_outlines.py`. Depends on E02 (merged).

**Evidence to inspect.** The fixture id sets; the hull test; `osd status`; a screenshot of Norway
with solid outlines.

**Dispositions of the Codex round (23 Oct).** Accepted: record/tool boundary (design 1), fetch
through the verifier (2), per-input CRS binding (3), identifier and geometry contract (4), L3
evidence beyond a rule name (5), committed-output exception made explicit (OSD-D12), licence of
derived geometry (OSD-D13), id-set equality instead of counts, exact-hull fixture and real
mutations, negative cases, named target set, ownership of verify.py/records.py/pyproject, PMTiles
removed. Refuted: "L3 prerequisite L2 undefined": L2 is E02's contract and the ladder stands;
targets that cannot reach L2 are reported, not exempted. Noted: the `outline_path` literal in the
old text was a wording error, fixed.
## E04 STAC catalogue — QUEUED · Kernel · strategy at lane open · Codex round done 23 Oct (REWORK, dispositions below; no second round)

Authority: `docs/ARCHITECTURE.md` ("formats, all standard"); Ophiolite connector doctrine
(SDK or standard, never bespoke); OSD-D14.

**Outcome.** Any STAC client, including the QGIS STAC browser, opens the catalogue by one address
and lists every dataset as a Collection with licence, level, access mode and verification date,
and lists Items for the features whose record declares a period. The catalogue is the
interoperable contract that E06 and E09 read; consuming it in Ophiolite is E09.

**Context today (verified 23 Oct, main e58e2f5).** `build/catalog/collections.json` is a bespoke
wrapper `{"collections": [...]}` whose entries carry `type`, `stac_version`, `id`, `license`,
`extent`, `providers`, `links` and bare `osd:level`/`osd:access` fields (`src/osd/build.py`); no
root catalog, no items, no extension schema, no validation (`osd validate` covers records and
outlines only; `tests/test_build.py` checks one licence string). The builder emits no GeoJSON
`id`; feature identity arrives with E03's `feature_id`. `Makefile` copies `build/catalog/*` flat
into `site/data/`, which Pages publishes.

**The design the lane must map to.**
1. Static STAC 1.0 under `build/catalog/stac/`: `catalog.json` root, one `Collection` per record,
   Items only where OSD-D14 allows (record `period` or a feature date), each Item carrying the
   feature geometry, bbox, `id` = E03's `feature_id`, and `datetime: null` with
   `start_datetime`/`end_datetime` from the period. Collections carry the temporal extent from
   `period` or `[null, null]`.
2. The `osd` extension: schema at `schema/stac-osd.json`, versioned URL mapped to the local file
   for offline validation. Collection-level fields `osd:level`, `osd:checked_at`, `osd:access`,
   `osd:redistribution`, `osd:blocked_since` (record-level assurance, stated as such); Item-level
   `osd:approximate`, `osd:derivation`, `osd:input_sha256`. Enums closed.
3. `license`: the SPDX id when the record has one, else `other` plus a `license` link; `proprietary`
   never appears. A test asserts the mapping for every record.
4. Assets: Collection `links` carry the landing page (`rel: about`) and licence; Collection
   `assets` carry E02's checksummed files (`href`, `file:size`, `file:checksum`), since their
   relation to an individual Item is not established; Items carry no data assets until E06 or E07
   establishes one. Mirror preference stays in E07.
5. Validation offline inside `make check`: `stac-validator` pinned, core and extension schemas
   bundled under `schema/stac/`, schema-map to local files, and a test that runs with network
   access denied (a fetcher that raises).
6. Publication: `Makefile` copies `build/catalog/` recursively; link validation runs over the
   staged `site/data/stac/` tree, the one Pages serves.
7. Identity: `feature_id` is the shared key between `outlines.geojson` features (emitted as
   GeoJSON `id` too) and STAC Items; duplicates fail the build.

**Acceptance.**
- `stac-validator site/data/stac/catalog.json --recursive` passes with the local schema map and
  no network; a mutation that removes one `child` link makes the reachable-set test fail (the test
  asserts the exact reachable collection ids against the record ids).
- Item ids equal the exact set of `feature_id`s of features with a period (fixture with three such
  features and two without); a mutation that drops one Item fails.
- A record with outlines but at L0 yields a collection with its Items and `osd:level: L0`; a record
  with no outlines yields an empty Item list; both asserted in one parametrised test.
- Removing `osd:level` fails validation; setting it to `L9` fails validation; hard-coding every
  level to L0 fails the test that compares collection levels to `records.json`.
- QGIS 3.34 STAC browser opens the staged tree from a local `http.server`, lists collections and
  opens one Item showing licence, level and access (screenshot in the PR).

**Out of scope.** A STAC API, mirrors (E07), manifests (E06), Ophiolite intake (E09), map UI (E05).

**Stop rules.** The STAC extension process requires a registered schema URL: use the repository's
versioned raw URL mapped locally; do not block on registration.

**Ownership and dependencies.** Coding lane; paths `src/osd/stac.py`, `src/osd/build.py`,
`schema/stac-osd.json`, `schema/stac/**` (bundled schemas), `schema/record.schema.json` (optional
`period` only, coordinated with E03's record/2), `pyproject.toml` (stac-validator pinned),
`Makefile` (recursive copy), `tests/test_stac.py`. Depends on E03 (feature ids) and E02 (files).

**Evidence to inspect.** The validator output in CI; the reachable-set and id-set tests; the QGIS
screenshot.

**Dispositions of the Codex round (23 Oct).** Accepted: offline validation with bundled schemas
and a schema map (5), the time contract (OSD-D14, design 1), item eligibility independent of
level (acceptance 3), identity ownership (E03 assigns `feature_id`, E04 emits it in both outputs),
assets at collection level from E02 with no mirror logic, extension semantics by level (2),
recursive publication and staged-tree validation (6), exact-set acceptance tests with named
mutations, licence mapping test, outcome narrowed to publishing the contract (E09 consumes).
Refuted: none.
