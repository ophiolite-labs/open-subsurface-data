   115	def fetch_parts(rec_input: dict, rule: dict, opener, robots) -> list[tuple[str, bytes]]:
   116	    url, fmt = rec_input["url"], rec_input["format"]
   117	    if fmt == "wfs":
   118	        parts = []
   119	        if rule.get("hits", True):
   120	            parts.append(("hits", _get(_with(url, {"resultType": "hits"}), opener, robots)))
   121	        size = int(rule["page_size"])
   122	        for page in range(MAX_PAGES):
   123	            start = page * size
   124	            b = _get(_with(url, {**(rule.get("params") or {}), "count": size, "startIndex": start}), opener, robots)
   125	            parts.append((f"page-{start:06d}", b))
   126	            try:
   127	                served = len(geojson_page(b).get("features") or [])
   128	            except ValueError:
   129	                raise Refused(f"{rec_input['name']}: page at {start} is not GeoJSON: {b[:120]!r}") from None
   130	            if served < size:
   131	                return parts
   132	        raise Refused(f"{rec_input['name']}: more than {MAX_PAGES} pages")
   133	    if fmt == "mdio":
   134	        base = url.rstrip("/") + "/"
   135	        parts = [(".zmetadata", _get(base + ".zmetadata", opener, robots))]
   136	        meta = json.loads(parts[0][1])["metadata"]
   137	        a = meta.get("trace_mask/.zarray") or {}
   138	        if not a:
   139	            raise Refused(f"{rec_input['name']}: MDIO store has no trace_mask")
   140	        (ni, nx), (ci, cx) = a["shape"], a["chunks"]
   141	        for bi in range(-(-ni // ci)):
   142	            for bx in range(-(-nx // cx)):
   143	                parts.append((f"trace_mask/{bi}/{bx}", _get(f"{base}trace_mask/{bi}/{bx}", opener, robots)))
   144	        for name in mdio_header_chunks(dict(parts)):
   145	            parts.append((name, _get(base + name, opener, robots)))
   146	        return parts
   147	    return [("body", _get(url, opener, robots))]
