     1	"""Write and check the static STAC 1.0 catalogue (E04).
     2	
     3	Output (build/catalog/stac/), all links relative so the tree serves from any address:
     4	  catalog.json                    the root Catalog, one `child` link per record
     5	  <cid>/collection.json           one Collection per record: licence, level, access, the files E02
     6	                                   checksummed as assets, temporal extent from the record's `period`
     7	  <cid>/items/<name>.json         one Item per outline feature with a feature_id, only when the record
     8	                                   declares a `period` (OSD-D14); id = the outline's feature_id
     9	
    10	`<cid>` is the record id with '/' replaced by '--'. Collection fields carry record-level assurance
    11	from the verification record; Item fields carry the outline's provenance. Both are the `osd`
    12	extension (schema/stac-osd.json). Validation runs offline against the schemas bundled in
    13	schema/stac/ (schema/stac/schema-map.json).
    14	"""
    15	
    16	from __future__ import annotations
    17	
    18	import calendar
    19	import hashlib
    20	import json
    21	import re
    22	import shutil
    23	from pathlib import Path
    24	
    25	from . import paths
    26	from .records import load_outline
    27	
    28	STAC_VERSION = "1.0.0"
    29	OSD_EXTENSION = ("https://raw.githubusercontent.com/ophiolite-labs/open-subsurface-data/main/"
    30	                 "schema/stac-osd.json")
    31	FILE_EXTENSION = "https://stac-extensions.github.io/file/v2.1.0/schema.json"
    32	ALTERNATE_EXTENSION = "https://stac-extensions.github.io/alternate-assets/v1.2.0/schema.json"
    33	MIRROR_TITLE = "Open Subsurface Data mirror"
    34	SCHEMA_MAP = paths.SCHEMA_DIR / "stac" / "schema-map.json"
    35	WORLD = [-180.0, -90.0, 180.0, 90.0]
    36	
    37	
    38	def collection_id(record_id: str) -> str:
    39	    return record_id.replace("/", "--")
    40	
    41	
    42	def item_file_name(feature_id: str) -> str:
    43	    """The part after '#', path-safe; a lossy name gets a short hash so two ids never collide."""
    44	    local = feature_id.split("#", 1)[1]
    45	    safe = re.sub(r"[^A-Za-z0-9._-]", "_", local).lstrip(".") or "_"
    46	    if safe != local:
    47	        safe += "-" + hashlib.sha256(feature_id.encode()).hexdigest()[:8]
    48	    return safe + ".json"
    49	
    50	
    51	def _instant(date: str, end: bool) -> str:
    52	    """'1993' / '1993-06' / '1993-06-30' to the first (or last) second of it, UTC."""
    53	    parts = [int(x) for x in date.split("-")]
    54	    y, m, d = (parts + [None, None])[:3]
    55	    if end:
    56	        m = m or 12
    57	        d = d or calendar.monthrange(y, m)[1]
    58	        return f"{y:04d}-{m:02d}-{d:02d}T23:59:59Z"
    59	    return f"{y:04d}-{m or 1:02d}-{d or 1:02d}T00:00:00Z"
    60	
    61	
    62	def interval(rec: dict) -> list:
    63	    p = rec.get("period")
    64	    if not p:
    65	        return [None, None]
    66	    start, end = _instant(p["start"], False), _instant(p["end"], True)
    67	    if end < start:
    68	        raise ValueError(f"{rec['id']}: period ends before it starts ({p['start']} > {p['end']})")
    69	    return [start, end]
    70	
    71	
    72	def _positions(c):
    73	    if c and isinstance(c[0], (int, float)):
    74	        yield c
    75	    else:
    76	        for x in c:
    77	            yield from _positions(x)
    78	
    79	
    80	def bbox(geometry: dict) -> list[float]:
    81	    xs, ys = zip(*((p[0], p[1]) for p in _positions(geometry["coordinates"])))
    82	    return [min(xs), min(ys), max(xs), max(ys)]
    83	
    84	
    85	def _union(boxes: list[list[float]]) -> list[float] | None:
    86	    if not boxes:
    87	        return None
    88	    return [min(b[0] for b in boxes), min(b[1] for b in boxes),
    89	            max(b[2] for b in boxes), max(b[3] for b in boxes)]
    90	
    91	
    92	def _assets(verification: dict | None, mirrored: dict[str, str] | None = None) -> dict:
    93	    """E02's checksummed files that carry a fetch address; collection-level, since which Item a
    94	    file belongs to is not established. A file the mirror holds (E07, by sha256) keeps one logical
    95	    asset and one checksum and gains the mirror as an alternate location."""
    96	    out = {}
    97	    for f in (verification or {}).get("files", []):
    98	        if f.get("url"):
    99	            out[f["path"]] = {"href": f["url"], "title": f["path"], "roles": ["data"],
   100	                              "file:size": f["bytes"], "file:checksum": "1220" + f["sha256"]}
   101	            if f["sha256"] in (mirrored or {}):
   102	                out[f["path"]]["alternate"] = {"mirror": {"href": mirrored[f["sha256"]], "title": MIRROR_TITLE}}
   103	    return out
   104	
   105	
   106	def _item(rec: dict, cid: str, feature: dict, inputs: dict, when: list) -> dict:
   107	    p = feature["properties"]
   108	    props = {"title": p["name"], "datetime": None, "start_datetime": when[0], "end_datetime": when[1],
   109	             "osd:approximate": p["approximate"], "osd:derivation": p["source"]}
   110	    sha = inputs.get(p.get("input"), {}).get("sha256")
   111	    if sha:
   112	        props["osd:input_sha256"] = sha
   113	    return {
   114	        "type": "Feature", "stac_version": STAC_VERSION, "stac_extensions": [OSD_EXTENSION],
   115	        "id": p["feature_id"], "collection": cid, "geometry": feature["geometry"],
   116	        "bbox": bbox(feature["geometry"]), "properties": props,
   117	        "links": [{"rel": "root", "href": "../../catalog.json", "type": "application/json"},
   118	                  {"rel": "parent", "href": "../collection.json", "type": "application/json"},
   119	                  {"rel": "collection", "href": "../collection.json", "type": "application/json"}],
   120	        "assets": {},
   121	    }
   122	
   123	
   124	def write_catalog(out_dir: Path, records: list[dict], vdir: Path = paths.VERIFICATION_DIR,
   125	                  outlines_dir: Path = paths.OUTLINES_DIR, mirror_index: list[dict] | None = None) -> list[dict]:
   126	    """Write out_dir/stac/ from the joined records (record fields plus level, checked_at,
   127	    blocked_since as build() joins them) and return the Collections. `mirror_index` is the public
   128	    index of copies the mirror holds (osd.mirror.public_index). A duplicate feature_id
   129	    anywhere in the outlines fails the build: it is the key Items and the map share."""
   130	    root = out_dir / "stac"
   131	    shutil.rmtree(root, ignore_errors=True)
   132	    root.mkdir(parents=True, exist_ok=True)
   133	    seen: set[str] = set()
   134	    collections, children = [], []
   135	    for rec in records:
   136	        rid, cid = rec["id"], collection_id(rec["id"])
   137	        op = outlines_dir / (rid.replace("/", "__") + ".geojson")
   138	        fc = load_outline(op) if op.exists() else {"features": []}
   139	        for f in fc["features"]:
   140	            fid = f["properties"].get("feature_id")
   141	            if fid in seen:
   142	                raise ValueError(f"duplicate feature_id '{fid}'")
   143	            if fid:
   144	                seen.add(fid)
   145	        when = interval(rec)
   146	        items = []
   147	        if rec.get("period"):
   148	            items = [_item(rec, cid, f, fc.get("inputs", {}), when)
   149	                     for f in fc["features"] if f["properties"].get("feature_id")]
   150	        names: dict[str, str] = {}
   151	        for it in items:
   152	            n = item_file_name(it["id"])
   153	            if n in names:
   154	                raise ValueError(f"{rid}: item file {n} for both '{names[n]}' and '{it['id']}'")
   155	            names[n] = it["id"]
   156	        vp = vdir / (rid.replace("/", "__") + ".json")
   157	        mirrored = {c["sha256"]: c["href"] for c in mirror_index or [] if c["record_id"] == rid}
   158	        assets = _assets(json.loads(vp.read_text()) if vp.exists() else None, mirrored)
   159	        alternate = any("alternate" in a for a in assets.values())
   160	        lic = rec["licence"]
   161	        spatial = (rec.get("region", {}).get("bbox")
   162	                   or _union([bbox(f["geometry"]) for f in fc["features"] if f.get("geometry")])
   163	                   or WORLD)
   164	        col = {
   165	            "type": "Collection", "stac_version": STAC_VERSION,
   166	            "stac_extensions": [OSD_EXTENSION] + ([FILE_EXTENSION] if assets else [])
   167	                               + ([ALTERNATE_EXTENSION] if alternate else []),
   168	            "id": cid, "title": rec["title"], "description": rec.get("summary") or rec["title"],
   169	            "license": lic.get("spdx") or "other",
   170	            "keywords": rec["kinds"],
   171	            "providers": [{"name": rec["publisher"]["name"], "roles": ["producer", "licensor"],
   172	                           "url": rec["publisher"]["url"]}],
   173	            "extent": {"spatial": {"bbox": [spatial]}, "temporal": {"interval": [when]}},
   174	            "links": [{"rel": "root", "href": "../catalog.json", "type": "application/json"},
   175	                      {"rel": "parent", "href": "../catalog.json", "type": "application/json"},
   176	                      {"rel": "about", "href": rec["origin"]["url"], "title": "Publisher's page"},
   177	                      {"rel": "license", "href": lic.get("url", rec["origin"]["url"]),
   178	                       "title": lic["name"]}]
   179	                     + [{"rel": "item", "href": f"./items/{n}", "type": "application/geo+json"}
   180	                        for n in names],
   181	            "osd:level": rec["level"], "osd:checked_at": rec["checked_at"],
   182	            "osd:access": rec["origin"]["access"], "osd:redistribution": lic["redistribution"],
   183	        }
   184	        if rec.get("blocked_since"):
   185	            col["osd:blocked_since"] = rec["blocked_since"]
   186	        if assets:
   187	            col["assets"] = assets
   188	        d = root / cid
   189	        (d / "items" if items else d).mkdir(parents=True, exist_ok=True)
   190	        (d / "collection.json").write_text(json.dumps(col, indent=2) + "\n")
   191	        for n, it in zip(names, items):
   192	            (d / "items" / n).write_text(json.dumps(it) + "\n")
   193	        collections.append(col)
   194	        children.append({"rel": "child", "href": f"./{cid}/collection.json",
   195	                         "type": "application/json", "title": rec["title"]})
   196	    catalog = {
   197	        "type": "Catalog", "stac_version": STAC_VERSION, "id": "open-subsurface-data",
   198	        "title": "Open Subsurface Data",
   199	        "description": "Open subsurface datasets as their publishers state them, one Collection per "
   200	                       "record, with the level our tools verified.",
   201	        "links": [{"rel": "root", "href": "./catalog.json", "type": "application/json"}] + children,
   202	    }
   203	    (root / "catalog.json").write_text(json.dumps(catalog, indent=2) + "\n")
   204	    return collections
   205	
   206	
   207	def validate(path: Path, recursive: bool = True, schema_config: Path = SCHEMA_MAP) -> tuple[bool, list]:
   208	    """stac-validator over a local file or tree, against the bundled schemas only."""
   209	    from stac_validator.utilities import fetch_and_parse_schema
   210	    from stac_validator.validate import StacValidate
   211	
   212	    fetch_and_parse_schema.cache_clear()   # a schema map change must not reuse a cached schema
   213	    v = StacValidate(str(path), recursive=recursive, schema_config=str(schema_config))
   214	    ok = v.run()
   215	    return ok and all(m.get("valid_stac") for m in v.message), v.message
   216	
   217	
   218	def _links(path: Path) -> list[dict]:
   219	    return json.loads(path.read_text()).get("links", [])
   220	
   221	
   222	def link_problems(root: Path) -> list[str]:
   223	    """Every relative link in the tree points at a file that exists."""
   224	    out = []
   225	    for p in sorted(root.rglob("*.json")):
   226	        for link in _links(p):
   227	            href = link["href"]
   228	            if "://" not in href and not (p.parent / href).resolve().is_file():
   229	                out.append(f"{p.relative_to(root)}: {link['rel']} -> {href} does not exist")
   230	    return out
   231	
   232	
   233	def reachable(catalog: Path) -> dict[str, set[str]]:
   234	    """Collection and Item ids a client reaches from the root by child and item links."""
   235	    out: dict[str, set[str]] = {"collections": set(), "items": set()}
   236	    todo, seen = [catalog.resolve()], set()
   237	    while todo:
   238	        p = todo.pop()
   239	        if p in seen:
   240	            continue
   241	        seen.add(p)
   242	        doc = json.loads(p.read_text())
   243	        if doc["type"] == "Collection":
   244	            out["collections"].add(doc["id"])
   245	        elif doc["type"] == "Feature":
   246	            out["items"].add(doc["id"])
   247	        todo += [(p.parent / x["href"]).resolve() for x in doc.get("links", [])
   248	                 if x["rel"] in ("child", "item")]
   249	    return out
# Outline extraction rules (OSD-D11): tool configuration, never a record field.
# Keyed by record id, then by the name of an input the record declares. min_features is the
# count the last reviewed run produced; outline-derived fails below it (a shrinking register is
# a finding). Record ids absent here keep their placeholder outline and are reported in E03.
#
# register-wfs: id/uwi/name are property names; kind is a literal or {field, map, default};
#   keep filters features by property; params are added to every page request; hits: true
#   compares the service's numberMatched with the features served; id_scope prefixes the
#   feature_id (<record-id>#<scope>/<id>) where one record holds registers with overlapping ids.
# segy-hull: x_byte/y_byte/scalar_byte (SEG-Y, 1-based) or x_field/y_field/scalar_field (MDIO).
# publisher-file: GeoJSON, or the locn:geometry extent of a publisher's page.
# simplify_m (default 50): Douglas-Peucker tolerance for derived polygons, recorded as
#   simplified_m on each; rings below simplify_m² are dropped; polygon_decimals (default 5) rounds
#   polygon positions; exteriors_only lists kinds written without holes; rings dropped are counted
#   in rings_dropped, and the rules applied are named in the feature's source (OSD-D16 amended,
#   answers E03-2, E03-3). Per record, over `defaults`. Points are never moved. unplaced: report lists features
#   the register serves without a position in the file's "unplaced" member instead of refusing.

defaults:
  simplify_m: 50
  polygon_decimals: 5

sodir/factpages:
  exteriors_only: [survey-2d]   # a 2D survey's holes are artefacts of buffering its line network
  min_features: 11210   # 23 Oct 2026: 9805 wellbores + 1405 surveys drawn; 2589 listed unplaced
  inputs:
    wellbores:
      extractor: register-wfs
      kind: wellbore
      id: NPDID_wellbore
      id_scope: wellbore   # NPDIDs of wellbores and surveys overlap (wellbore 2000, survey 2000)
      name: Wellbore_name
      unplaced: report   # FactMaps serves [nan,nan] for wellbores without a position
      page_size: 1000
      params: {outputFormat: GEOJSON, propertyName: "Wellbore_name,NPDID_wellbore,SHAPE"}
    seismic-finished: &sodir-seismic
      extractor: register-wfs
      kind: {field: Sub_type, map: {"2D": survey-2d}, default: survey-3d}
      id: NPDID_for_survey
      id_scope: survey
      name: Survey_name
      keep: {Net_or_gross: net}   # every survey has one net area; 634 also have a gross area incl. turns
      unplaced: report            # FactMaps serves {"type":"MultiPolygon",} for old surveys without an area
      page_size: 1000
      params: {outputFormat: GEOJSON, propertyName: "Survey_name,NPDID_for_survey,Sub_type,Net_or_gross,SHAPE"}
    seismic-ongoing: *sodir-seismic
    seismic-paused: *sodir-seismic
    # planned, pending and cancelled surveys hold no data and are not outlined

nlog/nlog:
  min_features: 7220    # 23 Oct 2026: 6738 boreholes + 482 3D surveys
  inputs:
    boreholes:
      extractor: register-wfs
      kind: wellbore
      id: BOREHOLE_CODE
      uwi: UWI
      name: BOREHOLE_NAME
      page_size: 1000
      params: {outputFormat: application/json, propertyName: "BOREHOLE_CODE,BOREHOLE_NAME,UWI,GEOMETRY",
               sortBy: BOREHOLE_CODE}
    surveys-3d:
      extractor: register-wfs
      kind: survey-3d
      id: SIGNAL_COLLECTION_ID
      name: SURVEY_ID
      page_size: 1000
      params: {outputFormat: application/json, propertyName: "SIGNAL_COLLECTION_ID,SURVEY_ID,GEOMETRY",
               sortBy: SIGNAL_COLLECTION_ID}

nopims/poseidon:
  min_features: 1
  inputs:
    full-stack-agc:
      extractor: segy-hull
      kind: survey-3d
      x_field: cdp-x
      y_field: cdp-y
      scalar_field: scalar_apply_coords

nzpam/parihaka:
  min_features: 1
  inputs:
    survey-extent: {extractor: publisher-file, kind: survey-3d}

nzpam/kerry-3d:
  min_features: 1
  inputs:
    survey-extent: {extractor: publisher-file, kind: survey-3d}
