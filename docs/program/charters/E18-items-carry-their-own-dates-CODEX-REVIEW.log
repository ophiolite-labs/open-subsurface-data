    70	                raise Refused(f"{rec_input['name']}: a feature has geometry {g.get('type')!r}")
    71	            out.append({"kind": _kind(rule, props), **_ident(rule, props),
    72	                        "geometry": {"type": g["type"], "coordinates": map_positions(g["coordinates"], f)}})
    73	    return out
