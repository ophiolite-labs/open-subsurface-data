   150	def fetch_inputs(rec: dict, rules: dict, opener, inputs_dir: Path = INPUTS_DIR) -> dict[str, str]:
   151	    """Fetch and store every input of the record that has a rule; {input name: input sha256}."""
   152	    from ..verify import _Robots
   153	
   154	    rid, robots = rec["id"], _Robots(opener)
   155	    todo = _inputs_with_rules(rec, rules)
   156	    out, index = {}, []
   157	    for i in todo:
   158	        parts = fetch_parts(i, rules[rid]["inputs"][i["name"]], opener, robots)
   159	        d = _dir(inputs_dir, rid, i["name"])
   160	        if d.exists():
   161	            for old in sorted(d.rglob("*"), reverse=True):
   162	                old.unlink() if old.is_file() else old.rmdir()
   163	        out[i["name"]] = store(d, parts)
   164	        index.append({"name": i["name"], "url": i["url"], "sha256": out[i["name"]]})
   165	    (_dir(inputs_dir, rid) / "inputs.json").write_text(json.dumps(index, indent=2) + "\n")
