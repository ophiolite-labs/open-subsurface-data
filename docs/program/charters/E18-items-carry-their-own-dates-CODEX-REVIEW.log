.github/workflows/verify.yml:40:      - run: uv run osd verify --outline-inputs ${{ steps.ids.outputs.ids }} | tee verify.txt   # L3 compares committed outlines with today's inputs (E03)
     1	# Outline extraction rules (OSD-D11): tool configuration, never a record field.
     2	# Keyed by record id, then by the name of an input the record declares. min_features is the
     3	# count the last reviewed run produced; outline-derived fails below it (a shrinking register is
     4	# a finding). Record ids absent here keep their placeholder outline and are reported in E03.
     5	#
     6	# register-wfs: id/uwi/name are property names; kind is a literal or {field, map, default};
     7	#   keep filters features by property; params are added to every page request; hits: true
     8	#   compares the service's numberMatched with the features served; id_scope prefixes the
     9	#   feature_id (<record-id>#<scope>/<id>) where one record holds registers with overlapping ids.
    10	# segy-hull: x_byte/y_byte/scalar_byte (SEG-Y, 1-based) or x_field/y_field/scalar_field (MDIO).
    11	# publisher-file: GeoJSON, or the locn:geometry extent of a publisher's page.
    12	# simplify_m (default 50): Douglas-Peucker tolerance for derived polygons, recorded as
    13	#   simplified_m on each; rings below simplify_m² are dropped; polygon_decimals (default 5) rounds
    14	#   polygon positions; exteriors_only lists kinds written without holes; rings dropped are counted
    15	#   in rings_dropped, and the rules applied are named in the feature's source (OSD-D16 amended,
    16	#   answers E03-2, E03-3). Per record, over `defaults`. Points are never moved. unplaced: report lists features
    17	#   the register serves without a position in the file's "unplaced" member instead of refusing.
    18	
    19	defaults:
    20	  simplify_m: 50
    21	  polygon_decimals: 5
    22	
    23	sodir/factpages:
    24	  exteriors_only: [survey-2d]   # a 2D survey's holes are artefacts of buffering its line network
    25	  min_features: 11210   # 23 Oct 2026: 9805 wellbores + 1405 surveys drawn; 2589 listed unplaced
    26	  inputs:
    27	    wellbores:
    28	      extractor: register-wfs
    29	      kind: wellbore
    30	      id: NPDID_wellbore
    31	      id_scope: wellbore   # NPDIDs of wellbores and surveys overlap (wellbore 2000, survey 2000)
    32	      name: Wellbore_name
    33	      unplaced: report   # FactMaps serves [nan,nan] for wellbores without a position
    34	      page_size: 1000
    35	      params: {outputFormat: GEOJSON, propertyName: "Wellbore_name,NPDID_wellbore,SHAPE"}
    36	    seismic-finished: &sodir-seismic
    37	      extractor: register-wfs
    38	      kind: {field: Sub_type, map: {"2D": survey-2d}, default: survey-3d}
    39	      id: NPDID_for_survey
    40	      id_scope: survey
    41	      name: Survey_name
    42	      keep: {Net_or_gross: net}   # every survey has one net area; 634 also have a gross area incl. turns
    43	      unplaced: report            # FactMaps serves {"type":"MultiPolygon",} for old surveys without an area
    44	      page_size: 1000
    45	      params: {outputFormat: GEOJSON, propertyName: "Survey_name,NPDID_for_survey,Sub_type,Net_or_gross,SHAPE"}
    46	    seismic-ongoing: *sodir-seismic
    47	    seismic-paused: *sodir-seismic
    48	    # planned, pending and cancelled surveys hold no data and are not outlined
    49	
    50	nlog/nlog:
    51	  min_features: 7220    # 23 Oct 2026: 6738 boreholes + 482 3D surveys
    52	  inputs:
    53	    boreholes:
    54	      extractor: register-wfs
    55	      kind: wellbore
    56	      id: BOREHOLE_CODE
    57	      uwi: UWI
    58	      name: BOREHOLE_NAME
    59	      page_size: 1000
    60	      params: {outputFormat: application/json, propertyName: "BOREHOLE_CODE,BOREHOLE_NAME,UWI,GEOMETRY",
    61	               sortBy: BOREHOLE_CODE}
    62	    surveys-3d:
    63	      extractor: register-wfs
    64	      kind: survey-3d
    65	      id: SIGNAL_COLLECTION_ID
    66	      name: SURVEY_ID
    67	      page_size: 1000
    68	      params: {outputFormat: application/json, propertyName: "SIGNAL_COLLECTION_ID,SURVEY_ID,GEOMETRY",
    69	               sortBy: SIGNAL_COLLECTION_ID}
    70	
    71	nopims/poseidon:
    72	  min_features: 1
    73	  inputs:
    74	    full-stack-agc:
    75	      extractor: segy-hull
    76	      kind: survey-3d
    77	      x_field: cdp-x
    78	      y_field: cdp-y
id: sodir/factpages
title: Sodir FactPages and FactMaps (Norwegian continental shelf)
summary: >-
  The Norwegian Offshore Directorate's register of every wellbore, field, discovery,
  licence and seismic survey on the Norwegian continental shelf, with coordinates and
  map layers. Metadata and outlines, not the underlying logs or seismic.
publisher: {name: Norwegian Offshore Directorate (Sodir), url: https://www.sodir.no, country: "NO"}
origin:
  url: https://factpages.sodir.no
  access: api
  manifest_url: https://factpages.sodir.no/en/wellbore/TableView/Exploration/All
  notes: Tables download as CSV; FactMaps serves WMS/WFS layers.
licence:
  name: Norwegian Licence for Open Government Data 2.0
  spdx: NLOD-2.0
  url: https://data.norge.no/nlod/en/2.0
  redistribution: allowed
  attribution: required
  statement: "Contains data under the Norwegian licence for Open Government data (NLOD) distributed by the Norwegian Offshore Directorate"
kinds: [wellbore-headers, wellbore-paths, tops, production, source-list]
region: {country: "NO", basin: Norwegian continental shelf, bbox: [-2.0, 56.0, 32.0, 74.0]}
listed_by: [publisher]
known_issues:
  - "Geonorge catalogue links NLOD 1.0, the FactPages terms page NLOD 2.0 (23 Oct)"
inputs:
  - name: wellbores
