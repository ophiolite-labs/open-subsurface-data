    47	# --- stored inputs -----------------------------------------------------------------------------
    48	
    49	def _sums(parts: list[tuple[str, bytes]]) -> bytes:
    50	    return "".join(f"{hashlib.sha256(b).hexdigest()}  {n}\n" for n, b in parts).encode()
    51	
    52	
    53	def input_sha256(parts: list[tuple[str, bytes]]) -> str:
    54	    return hashlib.sha256(_sums(parts)).hexdigest()
    55	
    56	
    57	def store(d: Path, parts: list[tuple[str, bytes]]) -> str:
    58	    d.mkdir(parents=True, exist_ok=True)
    59	    for n, b in parts:
    60	        (d / n).parent.mkdir(parents=True, exist_ok=True)
    61	        (d / n).write_bytes(b)
    62	    (d / "SHA256SUMS").write_bytes(_sums(parts))
    63	    return input_sha256(parts)
