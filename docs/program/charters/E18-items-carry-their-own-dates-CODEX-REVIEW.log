    87	def register_wfs(rec_input: dict, rule: dict, parts: list[tuple[str, bytes]]) -> list[dict]:
    88	    """GeoJSON pages of a WFS GetFeature; a stored hit count must equal the features served."""
    89	    pages = [geojson_page(b) for n, b in parts if n.startswith("page-")]
    90	    served = sum(len(p.get("features") or []) for p in pages)
    91	    hits = dict(parts).get("hits")
    92	    if hits is not None:
    93	        m = re.search(rb'numberMatched="(\d+)"', hits)
    94	        if m and int(m.group(1)) != served:
    95	            raise Refused(f"{rec_input['name']}: the service counts {int(m.group(1))} features, the pages "
    96	                          f"served {served}")
    97	    if not served:
    98	        raise Refused(f"{rec_input['name']}: empty response")
    99	    return _features(rec_input, rule, pages)
