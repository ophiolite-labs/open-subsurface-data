51: def _linked_well(data):
52:     """The name of the one well linked to this exact revision that the caller may read, or None."""
53:     client = getattr(data, '_client', None)
54:     if client is None: return None
55:     asset, revision = data.descriptors[0].asset_id, data.descriptors[0].revision
56:     names = {}
57:     for item in client.associations(assets=[asset]):
58:         entity = item.get('entity') or {}
59:         if (item.get('asset_id'), item.get('revision')) != (asset, revision): continue
60:         if entity.get('kind') == 'well': names[entity['entity_id']] = entity['name']
61:         elif entity.get('kind') == 'wellbore':
62:             try: well = client.entity(entity['entity_id']).well()  # None when its well is hidden from you
63:             except Busy: raise  # a busy service says nothing about the well: never a different WELL
64:             except (PermissionRefused, Unavailable): continue
65:             if well is not None: names[well.entity_id] = well.name
66:     return next(iter(names.values())) if len(names) == 1 else None
