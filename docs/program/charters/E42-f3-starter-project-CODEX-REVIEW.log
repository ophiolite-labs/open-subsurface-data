33: def _exact(curve):
34:     """A LASFile curve's samples as 64-bit floats, refusing any a 64-bit float cannot hold exactly (E126a: nothing is rounded)."""
35:     import numpy as np
36:     data = np.asarray(curve.data)
37:     if data.dtype.kind not in 'fiu': raise ValidationFailed([f'Curve {curve.mnemonic} is not numeric; write numbers only.'])
38:     if data.dtype.kind == 'f' and data.dtype.itemsize > 8:
39:         raise ValidationFailed([f'Curve {curve.mnemonic} is wider than a 64-bit float and cannot be written exactly; nothing is rounded.'])
40:     if data.dtype.kind in 'iu':
41:         for v in data.tolist():
42:             if int(float(v)) != v: raise ValidationFailed([f'{v} in {curve.mnemonic} cannot be written exactly; nothing is rounded.'])
43:     return [float(v) for v in data.tolist()]
