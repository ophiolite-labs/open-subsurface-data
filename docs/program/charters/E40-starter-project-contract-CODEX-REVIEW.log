# One target per station. CI runs exactly `make check`.
.PHONY: check check-full test lint validate build verify site serve clean site-deps site-test shot

check:                                   ## the required CI check (offline, < 2 min)
	$(MAKE) lint
	$(MAKE) -j3 --output-sync=target test validate build   # side by side (E36): the build's tiling is the long one

lint:
	uv run ruff check src tests

test:
	uv run pytest -q

validate:                                ## every record and outline against its schema
	uv run osd validate

build:                                   ## build/catalog/*.json, outlines.pmtiles (tippecanoe) + site/data/
	uv run osd build
	mkdir -p site/data && rm -rf site/data/stac site/data/*.pmtiles && cp -R build/catalog/. site/data/   # stac/ is a tree; tiles only when tippecanoe ran (E15)
	ls site/data | grep -vx files.txt > site/data/files.txt   # the map reads optional files from this list

check-full: build                        ## the whole STAC tree, every Item (OSD-D18), the full tile comparison (E36); verify workflow on main, not the gate
	uv run pytest -q -m full
	uv run python -c "import sys; from pathlib import Path; from osd import stac; ok, m = stac.validate(Path('site/data/stac/catalog.json')); print(len(m), 'STAC objects', 'valid' if ok else 'INVALID'); sys.exit(not ok)"

verify:                                  ## network: reach origins, record levels (not part of `check`)
	uv run osd verify

site: build                              ## serve the map locally
	python3 -m http.server --directory site 8765

site-deps:                               ## Playwright and Chromium for the site test (not part of `check`)
	npm install --no-audit --no-fund
	npx playwright install chromium

site-test: build                         ## Playwright against the local site (not part of `check` yet)
	npm run --silent site-test

shot: build                              ## desktop and phone screenshots into build/shots/
	mkdir -p build/shots
	node tools/shot.mjs build/shots

clean:
	rm -rf build site/data
"""E09: fidelity/1 and the L4 rule (charter docs/program/charters/E09-ophiolite-reads-the-catalogue.md,
strategy E09-ophiolite-reads-the-catalogue-STRATEGY.md). The fixture is two synthetic LAS files, a
record, its verification at L3 and the fidelity record a workspace would write for them; nothing
leaves the machine."""

import copy
import hashlib
import json
import shutil
from datetime import UTC, datetime
from pathlib import Path

import pytest
import yaml

from osd import cli, verify
from osd.build import build

ROOT = Path(__file__).resolve().parents[1]
FIDELITY = ROOT / "tests" / "fixtures" / "fidelity"
RID = "acme/two-wells"
NOW = datetime(2026, 10, 23, 12, tzinfo=UTC)


def snapshot(tmp_path: Path, vdir: Path = FIDELITY / "verification") -> Path:
    """The fixture catalogue as `osd build` writes it, at a fixed time and fixed commits."""
    out = tmp_path / "catalog"
    build(out, vdir, now=NOW, mirror_dir=tmp_path / "no-mirror", records_dir=FIDELITY / "records",
          source_commit="1" * 40, verification_commit="2" * 40)
    return out


def catalog_of(cat_dir: Path) -> dict:
    return json.loads((cat_dir / "records.json").read_text())["catalog"]


def fixture() -> dict:
    return json.loads((FIDELITY / "fidelity.json").read_text())


def verification() -> dict:
    return json.loads((FIDELITY / "verification" / "acme__two-wells.json").read_text())


def apply(tmp_path, doc, v=None, rid=RID):
    return verify.apply_fidelity(rid, doc, verification() if v is None else v)


def conversion(v: dict) -> dict:
    (c,) = [c for c in v["checks"] if c["name"] == "canonical-conversion"]
    return c


def assert_rejected(tmp_path, doc, fragment, v=None):
    out, reasons = apply(tmp_path, doc, v)
    assert any(fragment in r for r in reasons), reasons
    assert out["level"] == "L3"
    c = conversion(out)
    assert c["outcome"] == "fail" and fragment in c["detail"]
    return reasons


# --- the fixture -----------------------------------------------------------------------------------

def test_fixture_is_valid_and_names_the_fixture_snapshot(tmp_path):
    doc = fixture()
    assert verify.fidelity_problems(doc) == []
    assert doc["catalog"] == catalog_of(snapshot(tmp_path))
    hashed = {f["path"]: f["sha256"] for f in verification()["files"]}
    assert hashed == {p.name: hashlib.sha256(p.read_bytes()).hexdigest() for p in sorted(FIDELITY.glob("*.las"))}


def test_fixture_fidelity_awards_l4_two_of_two(tmp_path):
    before = verification()
    out, reasons = apply(tmp_path, fixture(), before)
"""E19: vocabulary from the records lanes (charter docs/program/charters/E19-vocabulary-from-the-records-lanes.md,
strategy E19-vocabulary-from-the-records-lanes-STRATEGY.md): record/3, the stac-osd v2 access value, the
status expiry note, the scaffold's comment lists and the six record edits. E26 (charter
E26-vocabulary-kinds-the-records-lanes-asked-for.md): record/4's five kinds, record/3 compatibility and the
scaffold's kinds comment. E29 (charter E29-outlines-from-the-map-services.md): record/5's `arcgis` input
format and record/4 compatibility."""

import copy
import gzip
import hashlib
import json
import socket
from datetime import UTC, date, datetime
from pathlib import Path

import pytest
import yaml
from jsonschema import Draft7Validator, Draft202012Validator, FormatChecker, ValidationError

from osd import cli, new, paths, stac
from osd.records import load_record, load_records, record_files, validate_records
from osd.verify import Fetched, verify_record

ROOT = Path(__file__).resolve().parents[1]
FROZEN = ROOT / "tests" / "fixtures" / "schema"
NOW = datetime(2026, 10, 23, 12, tzinfo=UTC)
TERMS = {"stated": "a purchase is a licence to use the data for at most 10 years",
         "duration": "at most 10 years from purchase", "review_before_publication": True, "expires": None}
V1_URL = "https://raw.githubusercontent.com/ophiolite-labs/open-subsurface-data/main/schema/stac-osd.json"


def _v(schema: dict) -> Draft202012Validator:
    return Draft202012Validator(schema, format_checker=FormatChecker())


RECORD = _v(json.loads((paths.SCHEMA_DIR / "record.schema.json").read_text()))   # the live schema, record/5 (E29)
RECORD_4 = _v(json.loads((FROZEN / "record-4.schema.json").read_text()))
RECORD_3 = _v(json.loads((FROZEN / "record-3.schema.json").read_text()))
RECORD_2 = _v(json.loads((FROZEN / "record-2.schema.json").read_text()))
NEW_KINDS = ["velocity-model", "geological-model", "airborne-em", "radiometrics", "stress"]   # E26, literal


def _base(**kw) -> dict:
    rec = {"id": "acme/demo", "title": "Demo set", "publisher": {"name": "Acme", "url": "https://acme.example"},
           "origin": {"url": "https://acme.example/demo", "access": "anonymous"},
           "licence": {"name": "Acme terms", "spdx": None, "redistribution": "forbidden", "attribution": "unknown"},
           "kinds": ["seismic-3d"], "region": {"country": "NL"}, "listed_by": ["publisher"], "added": "2026-10-23"}
    for k, x in kw.items():
        if k == "access":
            rec["origin"]["access"] = x
        elif k == "terms":
            rec["licence"]["terms"] = x
        else:
            rec[k] = x
    return rec


def _errors(rec: dict) -> list:
    return list(RECORD.iter_errors(rec))


# --- record/3 --------------------------------------------------------------------------------------

def test_record_ids_are_versioned():
    assert RECORD.schema["$id"].endswith("/record/5") and RECORD_4.schema["$id"].endswith("/record/4")
    assert RECORD_3.schema["$id"].endswith("/record/3")
    assert RECORD_2.schema["$id"].endswith("/record/2")


def test_record_3_admits_the_new_values():
    assert _errors(_base(kinds=["potential-fields"])) == []
    assert _errors(_base(access="purchase")) == []
    assert _errors(_base(access="purchase", terms=TERMS)) == []
    assert _errors(_base(terms={"stated": "Licence runs until 31 December 2030.", "expires": "2030-12-31"})) == []
    assert _errors(_base(terms={"stated": "Terms as published.", "duration": None,
                                "review_before_publication": None, "expires": None})) == []
    assert _errors(_base(terms={"stated": "Only the words."})) == []


