        "spdx": {"type": ["string", "null"]},
        "url": {"type": "string", "format": "uri"},
        "redistribution": {"enum": ["allowed", "restricted", "forbidden", "unknown"]},
        "attribution": {"enum": ["required", "not-required", "unknown", null],
                        "description": "v3 admits null: the source states no value; a reader treats it as not stated and supplies no default"},
        "share_alike": {"type": "boolean"},
        "statement": {"type": "string", "maxLength": 300},
        "terms": {"type": "object", "additionalProperties": false, "required": ["stated"],
                  "description": "v4. The record's licence.terms (record/3), copied whole: the keys the record states, nothing added",
                  "properties": {
