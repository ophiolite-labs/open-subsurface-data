        "item_id": {"type": ["string", "null"], "description": "Item selection: the STAC Item id, or null when the feature has no Item"},
        "feature_id": {"type": "string", "description": "Item selection: the map feature that was selected"},
        "title": {"type": "string"},
        "origin_url": {"type": "string", "format": "uri", "description": "The publisher's page; the to-do address when assets are empty"},
        "access": {"enum": ["anonymous", "registration", "api", "request", "purchase"], "description": "purchase is v4 only"},
        "licence": {"$ref": "#/$defs/licence"},
