"""E125 slice 0, C3: what each direction can do on the pinned OpendTect (`data/matrix.json`, frozen from `probe.py`).

Each row has two axes (disposition 9): `availability` (supported or refused; the only one dispatch reads) and
`evidence` (proven or unproven; carried into a refusal's technical details). Allowed pairs: supported+proven (with
the qualified `profile`, `literals` and the `outside_profile` sentence), refused+proven and refused+unproven (with
the `sentence` and its `detail`). The rows are exactly the nine directions in ROWS, once each. `validate` mirrors
`data/matrix-schema.json` without a schema library, so the installed connector checks its own matrix.
"""
import json

from . import resources

ROWS = ('well get', 'well send', 'log get', 'log send', 'horizon get', 'horizon send', 'fault get', 'fault send',
        'cube get')
PAIRS = {('supported', 'proven'), ('refused', 'proven'), ('refused', 'unproven')}
REQUIRED = {
    'well send': ('head_fields', 'track_keys', 'depth_unit'),
    'log get': ('mnemonic', 'depth_unit', 'value_unit', 'layout', 'head_position_check', 'depth_basis'),
    'log send': ('mnemonic', 'depth_unit', 'value_unit', 'layout'),
    'horizon get': ('grid', 'z_domain', 'z_unit', 'dtype', 'null'),
    'horizon send': ('grid', 'z_domain', 'z_unit', 'dtype', 'null'),
    'cube get': ('sampling', 'z_domain', 'z_unit', 'dtype', 'layout'),
}
FIELDS = {'row', 'availability', 'evidence', 'sentence', 'detail', 'profile', 'literals', 'outside_profile'}


def text(v):
    return isinstance(v, str) and bool(v.strip())


def validate(document):
    """[problem] for every way `document` is not a valid matrix; [] when it is."""
    problems = []
    if document.get('schema') != 'ophiolite.opendtect-matrix/1': problems.append('schema is not ophiolite.opendtect-matrix/1')
    rows = document.get('rows')
    if not isinstance(rows, list): return problems + ['rows is not a list']
    keys = [r.get('row') for r in rows]
    for k in sorted(set(keys) - set(ROWS), key=str): problems.append('%r is not a direction' % k)
    for k in ROWS:
        if keys.count(k) != 1: problems.append('%r appears %d times' % (k, keys.count(k)))
    for r in rows:
        k, pair = r.get('row'), (r.get('availability'), r.get('evidence'))
        if set(r) - FIELDS: problems.append('%s: unknown fields %s' % (k, sorted(set(r) - FIELDS)))
        if pair not in PAIRS: problems.append('%s: %s+%s is not an allowed pair' % (k, *pair)); continue
        if pair[0] == 'supported':
            for f in ('profile', 'literals'):
                if not isinstance(r.get(f), dict) or not r[f]: problems.append('%s: no %s' % (k, f))
            if not text(r.get('outside_profile')): problems.append('%s: no outside_profile sentence' % k)
            missing = [f for f in REQUIRED.get(k, ()) if f not in (r.get('profile') or {})]
            if missing: problems.append('%s: profile lacks %s' % (k, ', '.join(missing)))
        else:
            for f in ('sentence', 'detail'):
                if not text(r.get(f)): problems.append('%s: no %s' % (k, f))
    return problems


def unique(pairs):
    """json object_pairs_hook: a key given twice in one object is an error, not a silent overwrite."""
    seen = {}
    for k, v in pairs:
        if k in seen: raise ValueError('%r is given twice' % k)
        seen[k] = v
    return seen


