schema/record.schema.json:5:  "description": "One dataset as published by its owner. Facts about the dataset, never facts produced by our tools: verification levels, checksums and outlines live in build output, not here. Version 2 adds `inputs` and the optional `period` (E04, additive); every version-1 record is a valid version-2 record. Version 3 (E19, additive) adds the kind `potential-fields`, the access `purchase` and the optional `licence.terms`; every version-2 record is a valid version-3 record. Version 4 (E26, additive) adds the kinds `velocity-model`, `geological-model`, `airborne-em`, `radiometrics` and `stress`; every version-3 record is a valid version-4 record.",
schema/record.schema.json:8:  "required": ["id", "title", "publisher", "origin", "licence", "kinds", "region", "listed_by", "added"],
schema/record.schema.json:31:        "manifest_url": {"type": "string", "format": "uri", "description": "Optional machine-readable listing of files (index, API, bucket listing) the verifier can checksum against."},
schema/record.schema.json:35:    "licence": {
schema/record.schema.json:38:        "name": {"type": "string", "description": "The licence as the publisher names it."},
schema/record.schema.json:39:        "spdx": {"type": ["string", "null"], "description": "SPDX identifier when one exists (CC-BY-4.0, CC-BY-SA-4.0, OGL-UK-3.0, NLOD-2.0); null for bespoke licences."},
schema/record.schema.json:42:                           "description": "May a third party host a copy? Decides whether the mirror store may hold this dataset."},
schema/record.schema.json:44:        "share_alike": {"type": "boolean", "description": "Derived products must carry the same licence (CC BY-SA and kin)."},
schema/record.schema.json:48:          "description": "Record/3. What the publisher's terms say about how long a licence runs and review before publication, as the publisher states it. Never computed: a duration stays the publisher's conditional wording, and `expires` is set only when the publisher states an absolute calendar date. Absent keys are not stated.",
schema/record.schema.json:51:            "duration": {"type": ["string", "null"], "minLength": 1, "description": "The publisher's wording of how long a licence runs, e.g. 'at most 10 years from purchase'; null when the terms state none."},
