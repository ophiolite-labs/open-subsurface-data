   244	def arcgis_out_fields(rule: dict, oid: str) -> str:
   245	    """The fields a page asks for: the object id and every field the rule reads, in that order."""
   246	    kind = rule.get("kind")
   247	    names = [oid, rule.get("uwi"), rule.get("name"), kind.get("field") if isinstance(kind, dict) else None,
   248	             *(rule.get("period_fields") or {}).values(), *(rule.get("keep") or {})]
   249	    return ",".join(dict.fromkeys(n for n in names if n))
