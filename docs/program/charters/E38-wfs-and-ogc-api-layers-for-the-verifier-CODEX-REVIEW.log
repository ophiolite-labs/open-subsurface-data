   382	class _Robots:
   383	    """robots.txt per host: 2xx is obeyed, 4xx allows everything, anything else (5xx, no answer) is
   384	    unreadable and treated as disallow (RFC 9309 section 2.3.1.4); `unread` says why, per host."""
   385	
   386	    def __init__(self, opener: Opener):
   387	        self.opener, self.hosts, self.unread = opener, {}, {}
   388	
   389	    def allowed(self, url: str) -> bool:
   390	        u = urlsplit(url)
   391	        key = f"{u.scheme}://{u.netloc}"
   392	        if key not in self.hosts:
   393	            rp = urllib.robotparser.RobotFileParser()
   394	            try:
   395	                rp.parse(_read(self.opener(key + "/robots.txt"), 512 * 1024).decode("utf-8", "replace").splitlines())
   396	            except FetchError as e:
   397	                if 400 <= e.status < 500:
   398	                    rp.allow_all = True
   399	                else:
   400	                    rp.disallow_all = True
   401	                    self.unread[key] = f"HTTP {e.status}" if e.status else (e.error or "no answer")
   402	            self.hosts[key] = rp
   403	        return self.hosts[key].can_fetch(USER_AGENT, url)
   404	
   405	    def refusal(self, url: str, what: str) -> str:
   406	        """Why `url` is not fetched: an unreadable robots.txt (H1 design 9) or an explicit disallow."""
   407	        u = urlsplit(url)
   408	        if why := self.unread.get(f"{u.scheme}://{u.netloc}"):
   409	            return f"robots.txt unreadable ({why}), treated as disallow (RFC 9309 section 2.3.1.4): {what} not fetched"
   410	        return f"robots.txt disallows {what}"
