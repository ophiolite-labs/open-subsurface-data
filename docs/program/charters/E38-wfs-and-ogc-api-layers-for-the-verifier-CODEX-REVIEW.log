   146	NAN_POSITION = re.compile(rb"\[\s*nan\s*,\s*nan\s*\]")
   147	EMPTY_GEOMETRY = re.compile(rb'\{"type":"(\w+)",\}')
   148	
   149	
   150	def geojson_page(b: bytes) -> dict:
   151	    """A GeoJSON page. FactMaps writes two things that are not JSON: `[nan,nan]` for a wellbore
   152	    without a position and `{"type":"MultiPolygon",}` for a survey without an area; both read as
   153	    a geometry without coordinates (the rule decides: unplaced: report, or refuse)."""
   154	    return json.loads(EMPTY_GEOMETRY.sub(rb'{"type":"\1","coordinates":null}', NAN_POSITION.sub(b"null", b)))
   155	
