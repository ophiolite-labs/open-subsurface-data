   172	# --- ArcGIS Map/Feature Server layers (E29) ------------------------------------------------------
   173	
   174	ARCGIS_MAX_FEATURES = 50_000   # charter design 4: a layer is read in full or refused; larger ones get no input
   175	ARCGIS_MAX_PAGES = 200
   176	
   177	
   178	def _json(b: bytes, what: str):
   179	    try:
   180	        return json.loads(b)
   181	    except ValueError:
   182	        raise Refused(f"{what} is not JSON: {b[:120]!r}") from None
   183	
   184	
   185	def _arcgis_error(doc, what: str) -> None:
   186	    if not isinstance(doc, dict):
   187	        raise Refused(f"{what} is not a JSON object")
   188	    if "error" in doc:
   189	        e = doc["error"] if isinstance(doc["error"], dict) else {"message": doc["error"]}
   190	        raise Refused(f"{what} answered an error: {e.get('code', '')} {e.get('message', '')}".strip())
   191	
   192	
   193	def arcgis_layer(b: bytes) -> tuple[str, int]:
   194	    """(object id field, maxRecordCount) from a layer description (?f=json); refused unless the
   195	    layer pages (supportsPagination) and names its object id field (objectIdField, else the one
   196	    field of type esriFieldTypeOID)."""
   197	    d = _json(b, "the layer description")
   198	    _arcgis_error(d, "the layer description")
   199	    pages = (d.get("advancedQueryCapabilities") or {}).get("supportsPagination", d.get("supportsPagination"))
   200	    if pages is not True:
   201	        raise Refused("the layer does not state supportsPagination: true; it cannot be read in full")
   202	    oid = d.get("objectIdField")
   203	    if not oid:
   204	        oids = [f.get("name") for f in d.get("fields") or [] if f.get("type") == "esriFieldTypeOID"]
   205	        oid = oids[0] if len(oids) == 1 else None
   206	    if not oid:
   207	        raise Refused("the layer names no object id field (objectIdField or one esriFieldTypeOID field)")
   208	    size = d.get("maxRecordCount")
   209	    if not isinstance(size, int) or isinstance(size, bool) or size < 1:
   210	        raise Refused(f"the layer states no maxRecordCount ({size!r})")
   211	    return oid, size
   212	
   213	
   214	def arcgis_layer_facts(b: bytes) -> bytes:
   215	    """The stored layer part: the description reduced to the facts the derivation reads, canonical.
   216	    The whole description is not an identity: load-balanced nodes serve different `drawingInfo`
   217	    (WA SLIP, 23 Oct), which would change the input sha256 with no change to any feature."""
   218	    d = _json(b, "the layer description")
   219	    _arcgis_error(d, "the layer description")
   220	    aq = d.get("advancedQueryCapabilities") or {}
   221	    facts = {k: d[k] for k in ("supportsPagination", "objectIdField", "maxRecordCount", "geometryType",
   222	                               "spatialReference") if k in d}
   223	    if "supportsPagination" in aq:
   224	        facts["advancedQueryCapabilities"] = {"supportsPagination": aq["supportsPagination"]}
   225	    facts["fields"] = [{"name": f.get("name"), "type": f.get("type")} for f in d.get("fields") or []
   226	                       if isinstance(f, dict) and f.get("type") == "esriFieldTypeOID"]
   227	    return json.dumps(facts, sort_keys=True, separators=(",", ":")).encode()
   228	
   229	
   230	def arcgis_count(b: bytes) -> int:
   231	    """The layer's feature count on the day (returnCountOnly=true), within the cap."""
   232	    d = _json(b, "the count")
   233	    _arcgis_error(d, "the count")
   234	    n = d.get("count")
   235	    if not isinstance(n, int) or isinstance(n, bool) or n < 0:
   236	        raise Refused(f"the count response states no count: {b[:120]!r}")
   237	    if n == 0:
   238	        raise Refused("empty response: the layer counts 0 features")
   239	    if n > ARCGIS_MAX_FEATURES:
   240	        raise Refused(f"the layer counts {n} features, above the {ARCGIS_MAX_FEATURES} an input is read in full to")
   241	    return n
