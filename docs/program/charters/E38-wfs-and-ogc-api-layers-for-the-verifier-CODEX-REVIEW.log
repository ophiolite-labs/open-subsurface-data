   278	def read_listing(body: bytes, base: str, content_type: str = "") -> Listing:
   279	    """The files a listing names. Raises ListingError for an error body or an unrecognised format."""
   280	    text = body.decode("utf-8", "replace")
   281	    head = text.lstrip()[:600]
   282	    if head.startswith(("{", "[")):
   283	        try:
   284	            doc = json.loads(text)
   285	        except ValueError as e:
   286	            raise ListingError(f"listing is not valid JSON ({e})") from None
   287	        if (err := _error(doc)) is not None:
   288	            raise ListingError(f"the listing is an error response: {err[:200]}")
   289	        for reader in JSON_READERS:
   290	            if (got := reader(doc, base)) is not None:
   291	                return got
   292	        out: list[Entry] = []
   293	        _json_walk(doc, base, out)
   294	        return Listing("json", out)
   295	    if "<ListBucketResult" in head:
   296	        u = urlsplit(base)
   297	        prefix = f"{u.scheme}://{u.netloc}{u.path.rstrip('/')}/"
   298	        out = []
   299	        for c in re.findall(r"<Contents>(.*?)</Contents>", text, re.DOTALL):
   300	            key = html.unescape(re.search(r"<Key>(.*?)</Key>", c, re.DOTALL).group(1))
   301	            size = re.search(r"<Size>(\d+)</Size>", c)
   302	            out.append(Entry(key, prefix + quote(key), int(size.group(1)) if size else None))
   303	        return Listing("s3", out)
   304	    if head.startswith("<"):
   305	        if (got := _arcgis_page(text, base)) is not None:
   306	            return got
   307	        p = _Links()
   308	        p.feed(text)
   309	        if re.search(r"<title>\s*Index of ", head, re.IGNORECASE):   # a server directory index: no parent, no sort links
   310	            return Listing("directory-index", [Entry(unquote(h), urljoin(base, h)) for h in p.hrefs
   140	                raise Refused(f"{rec_input['name']}: a feature has geometry {g.get('type')!r}")
   141	            out.append({"kind": _kind(rule, props), **_ident(rule, props), **_period(rule, props),
   142	                        "geometry": split_antimeridian({"type": g["type"], "coordinates": map_positions(g["coordinates"], f)})})
   143	    return out
