   157	def register_wfs(rec_input: dict, rule: dict, parts: list[tuple[str, bytes]]) -> list[dict]:
   158	    """GeoJSON pages of a WFS GetFeature; a stored hit count must equal the features served."""
   159	    pages = [geojson_page(b) for n, b in parts if n.startswith("page-")]
   160	    served = sum(len(p.get("features") or []) for p in pages)
   161	    hits = dict(parts).get("hits")
   162	    if hits is not None:
   163	        m = re.search(rb'numberMatched="(\d+)"', hits)
   164	        if m and int(m.group(1)) != served:
   165	            raise Refused(f"{rec_input['name']}: the service counts {int(m.group(1))} features, the pages "
   166	                          f"served {served}")
   167	    if not served:
   168	        raise Refused(f"{rec_input['name']}: empty response")
   169	    return _features(rec_input, rule, pages)
