   241	class _Links(HTMLParser):
   242	    def __init__(self):
   243	        super().__init__()
   244	        self.hrefs: list[str] = []
   245	
   246	    def handle_starttag(self, tag, attrs):
   247	        if tag == "a":
   248	            href = dict(attrs).get("href")
   249	            if href and not href.startswith(("#", "mailto:", "javascript:")):
   250	                self.hrefs.append(href)
