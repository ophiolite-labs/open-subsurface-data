   202	def _error(d) -> str | None:
   203	    if isinstance(d, dict) and d.get("success") is False:
   204	        e = d.get("error")
   205	        return str(e.get("message") if isinstance(e, dict) else e)
   206	    if isinstance(d, dict) and isinstance(d.get("error"), dict) and set(d) <= {"error"}:
