   316	def register_arcgis(rec_input: dict, rule: dict, parts: list[tuple[str, bytes]]) -> list[dict]:
   317	    """The pages of an ArcGIS layer query, reassembled: every page the count calls for is there,
   318	    none short but the last, none answered an error, each states the record's CRS, the object ids
   319	    are unique and as many as the layer counted. Positions are native and transformed from the
   320	    record's crs as the WFS path does; the object id is the feature's key."""
   321	    by = dict(parts)
   322	    name = rec_input["name"]
   323	    if "layer" not in by or "count" not in by:
   324	        raise Refused(f"{name}: the layer description or the count was not fetched")
   325	    oid, size = arcgis_layer(by["layer"])
   326	    count = arcgis_count(by["count"])
   327	    feats, seen = [], set()
   328	    offsets = page_offsets(count, size)
   329	    for k, off in enumerate(offsets):
   330	        what = f"{name}: page at offset {off}"
   331	        if f"page-{off:06d}" not in by:
   332	            raise Refused(f"{what} is missing")
   333	        page = _json(by[f"page-{off:06d}"], what)
   334	        _arcgis_error(page, what)
   335	        served = _wkids(page.get("spatialReference"))
