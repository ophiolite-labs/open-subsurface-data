   258	
   259	def _signed_area(ring: list) -> float:
   260	    return sum(a[0] * b[1] - b[0] * a[1] for a, b in itertools.pairwise(ring)) / 2
   261	
   262	
   263	def _inside(p: list, ring: list) -> bool:
   264	    x, y, hit = p[0], p[1], False
   265	    for a, b in itertools.pairwise(ring):
   266	        if (a[1] > y) != (b[1] > y) and x < a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1]):
   267	            hit = not hit
   268	    return hit
   269	
   270	
   271	def _number(v) -> bool:
   272	    return isinstance(v, (int, float)) and not isinstance(v, bool) and not math.isnan(v)
   273	
   274	
   275	def esri_geometry(g: dict | None) -> dict | None:
   276	    """An Esri JSON geometry as a GeoJSON geometry in the same (native) coordinates; None when the
   277	    feature has no position. Polygons: Esri writes exterior rings clockwise and holes
   278	    counter-clockwise; each hole belongs to the exterior that contains it, and GeoJSON (RFC 7946)
   279	    gets exteriors counter-clockwise and holes clockwise."""
   280	    if not g:
   281	        return None
   282	    if "x" in g:
   283	        if not (_number(g.get("x")) and _number(g.get("y"))):
   284	            return None
   285	        return {"type": "Point", "coordinates": [g["x"], g["y"]]}
   286	    if "points" in g:
   287	        pts = [p[:2] for p in g.get("points") or []]
   288	        return {"type": "MultiPoint", "coordinates": pts} if pts else None
   289	    if "paths" in g:
   290	        paths = [[p[:2] for p in path] for path in g.get("paths") or [] if path]
   291	        if not paths:
   292	            return None
   293	        return ({"type": "LineString", "coordinates": paths[0]} if len(paths) == 1
   294	                else {"type": "MultiLineString", "coordinates": paths})
   295	    if "rings" in g:
   296	        rings = [[p[:2] for p in r] for r in g.get("rings") or [] if r]
   297	        if not rings:
   298	            return None
   299	        exteriors = [[r[::-1]] for r in rings if _signed_area(r) < 0]   # clockwise: an exterior
   300	        for h in (r for r in rings if _signed_area(r) >= 0):
   301	            owner = [poly for poly in exteriors if _inside(h[0], poly[0])]
   302	            if not owner:
   303	                raise Refused("a polygon hole (counter-clockwise ring) lies inside no exterior ring")
   304	            min(owner, key=lambda poly: abs(_signed_area(poly[0]))).append(h[::-1])   # the innermost exterior
   305	        if not exteriors:
   306	            raise Refused("a polygon has no exterior (clockwise) ring")
   307	        return ({"type": "Polygon", "coordinates": exteriors[0]} if len(exteriors) == 1
   308	                else {"type": "MultiPolygon", "coordinates": exteriors})
   309	    raise Refused(f"an Esri geometry of no known type: {sorted(g)}")
   310	
   311	
   312	def _wkids(sr: dict | None) -> set[str]:
   313	    return {f"EPSG:{sr[k]}" for k in ("wkid", "latestWkid") if isinstance(sr, dict) and isinstance(sr.get(k), int)}
   314	
