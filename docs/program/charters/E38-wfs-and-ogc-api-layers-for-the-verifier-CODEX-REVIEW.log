   251	
   252	def page_offsets(count: int, size: int) -> list[int]:
   253	    offsets = list(range(0, count, size))
   254	    if len(offsets) > ARCGIS_MAX_PAGES:
   255	        raise Refused(f"{count} features at {size} per page is more than {ARCGIS_MAX_PAGES} pages")
   256	    return offsets
