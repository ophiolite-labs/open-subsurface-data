   253	def _arcgis_page(text: str, base: str) -> Listing | None:
   254	    """The ArcGIS REST services directory page of one layer (a layer URL without ?f=json)."""
   255	    m = re.search(r"Max Record Count:</b>\s*(\d+)", text)
   256	    if not (m and re.search(r"<title>\s*Layer:", text) and re.search(r"Type:</b>\s*(Feature Layer|Table)", text)):
   257	        return None
   258	    u = urlsplit(base)
   259	    when = re.search(r"Last Edit Date:</b>\s*(\d{1,2})/(\d{1,2})/(\d{4})", text)
   260	    listed = f"{when.group(3)}-{int(when.group(1)):02d}-{int(when.group(2)):02d}" if when else None
   261	    return Listing("arcgis-layer", [_arcgis_export(f"{u.scheme}://{u.netloc}{u.path}", int(m.group(1)))], listed)
   262	
