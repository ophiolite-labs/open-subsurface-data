   264	def names_a_file(content_type: str, disposition: str = "") -> bool:
   265	    """H1 design 8: the response is a data file, not a listing; decided from the headers alone. An
   266	    unstated content type is not a file (the body's shape decides, as before)."""
   267	    if disposition.split(";", 1)[0].strip().lower() == "attachment":
   268	        return True
   269	    t = content_type.split(";", 1)[0].strip().lower()
   270	    return bool(t) and t not in LISTING_TYPES and not t.endswith(("+json", "+xml"))
   271	
