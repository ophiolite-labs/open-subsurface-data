   215	def _json_walk(node, base: str, out: list[Entry]) -> None:
   216	    """E02's generic reader: GitHub contents, STAC hrefs, name lists."""
   217	    if isinstance(node, list):
   218	        for x in node:
   219	            if isinstance(x, str):
   220	                out.append(Entry(x, urljoin(base, x)))
   221	            else:
   222	                _json_walk(x, base, out)
   223	    elif isinstance(node, dict):
   224	        name = node.get("path") or node.get("name") or node.get("key")
   225	        size = node.get("size") if isinstance(node.get("size"), int) else None
   226	        if "download_url" in node:  # GitHub contents API: directories have none
   227	            if isinstance(node["download_url"], str):
   228	                out.append(Entry(name or node["download_url"], node["download_url"], size))
   229	            return
   230	        for k in ("href", "url"):
   231	            if isinstance(node.get(k), str):
   232	                out.append(Entry(name if isinstance(name, str) else node[k], urljoin(base, node[k]), size))
   233	                break
   234	        for v in node.values():
   235	            if isinstance(v, (list, dict)):
   236	                _json_walk(v, base, out)
