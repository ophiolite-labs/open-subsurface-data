   214	def arcgis_layer_facts(b: bytes) -> bytes:
   215	    """The stored layer part: the description reduced to the facts the derivation reads, canonical.
   216	    The whole description is not an identity: load-balanced nodes serve different `drawingInfo`
   217	    (WA SLIP, 23 Oct), which would change the input sha256 with no change to any feature."""
   218	    d = _json(b, "the layer description")
   219	    _arcgis_error(d, "the layer description")
   220	    aq = d.get("advancedQueryCapabilities") or {}
   221	    facts = {k: d[k] for k in ("supportsPagination", "objectIdField", "maxRecordCount", "geometryType",
   222	                               "spatialReference") if k in d}
   223	    if "supportsPagination" in aq:
   224	        facts["advancedQueryCapabilities"] = {"supportsPagination": aq["supportsPagination"]}
   225	    facts["fields"] = [{"name": f.get("name"), "type": f.get("type")} for f in d.get("fields") or []
   226	                       if isinstance(f, dict) and f.get("type") == "esriFieldTypeOID"]
   227	    return json.dumps(facts, sort_keys=True, separators=(",", ":")).encode()
