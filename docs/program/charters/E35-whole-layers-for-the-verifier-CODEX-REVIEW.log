   193	def arcgis_layer(b: bytes) -> tuple[str, int]:
   194	    """(object id field, maxRecordCount) from a layer description (?f=json); refused unless the
   195	    layer pages (supportsPagination) and names its object id field (objectIdField, else the one
   196	    field of type esriFieldTypeOID)."""
   197	    d = _json(b, "the layer description")
   198	    _arcgis_error(d, "the layer description")
   199	    pages = (d.get("advancedQueryCapabilities") or {}).get("supportsPagination", d.get("supportsPagination"))
   200	    if pages is not True:
   201	        raise Refused("the layer does not state supportsPagination: true; it cannot be read in full")
   202	    oid = d.get("objectIdField")
   203	    if not oid:
   204	        oids = [f.get("name") for f in d.get("fields") or [] if f.get("type") == "esriFieldTypeOID"]
   205	        oid = oids[0] if len(oids) == 1 else None
   206	    if not oid:
   207	        raise Refused("the layer names no object id field (objectIdField or one esriFieldTypeOID field)")
   208	    size = d.get("maxRecordCount")
   209	    if not isinstance(size, int) or isinstance(size, bool) or size < 1:
   210	        raise Refused(f"the layer states no maxRecordCount ({size!r})")
   211	    return oid, size
