   343	def _digest(stream: Iterable[bytes], budget: ByteBudget, algorithms: Iterable[str] = (),
   344	            watch: bool = False) -> tuple[str, int, dict[str, str], bool]:
   345	    """SHA-256, byte count, the publisher's algorithms over the same stream, and whether a generated
   346	    export said the server truncated it (`"exceededTransferLimit": true`, across chunk borders)."""
   347	    h, n = hashlib.sha256(), 0
   348	    more = {a: hashlib.new(COMPARABLE[a]) for a in algorithms}
   349	    truncated, tail = False, b""
   350	    for chunk in stream:
   351	        if len(chunk) > budget.remaining:
   352	            budget.exhaust()
   353	            raise _OverBudget
   354	        budget.add(len(chunk))
   355	        h.update(chunk)
   356	        for x in more.values():
   357	            x.update(chunk)
   358	        if watch and not truncated:
   359	            truncated = bool(TRUNCATED.search(tail + chunk))
   360	            tail = (tail + chunk)[-64:]
   361	        n += len(chunk)
   362	    return h.hexdigest(), n, {a: x.hexdigest() for a, x in more.items()}, truncated
