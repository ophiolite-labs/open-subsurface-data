   301	        self.used += n
   302	
   303	    def exhaust(self) -> None:
   304	        self.used = self.limit
   305	
   306	    def share(self, cap: int) -> ByteBudget:
   307	        """A record's share: at most `cap` bytes, every byte also drawn from this budget."""
   308	        return _Share(self, cap)
   309	
   310	
   311	class _Share(ByteBudget):
   312	    def __init__(self, parent: ByteBudget, cap: int):
   313	        super().__init__(cap)
   314	        self.parent = parent
   315	
   316	    @property
   317	    def remaining(self) -> int:
   318	        return min(self.limit - self.used, self.parent.remaining)
   319	
   320	    def add(self, n: int) -> None:
   321	        self.used += n
   322	        self.parent.add(n)
