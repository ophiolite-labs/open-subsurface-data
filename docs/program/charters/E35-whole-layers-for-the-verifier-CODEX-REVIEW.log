   291	    """Bytes hashed (or abandoned mid-stream) in one run, shared across records."""
   292	
   293	    def __init__(self, limit: int = RUN_BYTE_BUDGET):
   294	        self.limit, self.used = limit, 0
   295	
   296	    @property
   297	    def remaining(self) -> int:
   298	        return self.limit - self.used
   299	
