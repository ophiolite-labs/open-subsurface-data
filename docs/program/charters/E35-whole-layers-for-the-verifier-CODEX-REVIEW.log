    70	def stated_checksum(value) -> dict | None:
    71	    """A publisher's checksum as stated: "md5:…", {"type": "MD5", "value": …}, or bare hex."""
    72	    if isinstance(value, dict):
    73	        alg = value.get("type") or value.get("algorithm") or ""
    74	        dig = value.get("value") or value.get("digest") or ""
    75	        return {"algorithm": str(alg)[:64], "digest": str(dig)[:256]} if dig else None
    76	    if not isinstance(value, str) or not value.strip():
    77	        return None
    78	    value = value.strip()
    79	    if ":" in value:
    80	        alg, dig = value.split(":", 1)
    81	        return {"algorithm": alg[:64], "digest": dig[:256]}
    82	    alg = {32: "md5", 40: "sha1", 64: "sha256"}.get(len(value)) if re.fullmatch(r"[0-9a-fA-F]+", value) else None
    83	    return {"algorithm": alg or "unstated", "digest": value[:256]}
