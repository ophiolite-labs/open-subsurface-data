     1	"""`osd new <url>`: scaffold a record from records/_template.yaml and the page's title.
     2	
     3	A maintainer runs it on a "Suggest a dataset" issue. It writes only what the address and the page
     4	title state (id, title, origin, the publisher's site, listed_by, added) and leaves every field a
     5	human must read from the publisher's page as `null` or empty, so `osd validate` lists exactly
     6	those until they are filled: publisher name, access, licence name, redistribution, attribution
     7	and kinds. It reads one page, once; `--title` skips even that.
     8	"""
     9	
    10	from __future__ import annotations
    11	
    12	import html
    13	import json
    14	import re
    15	from datetime import date
    16	from pathlib import Path
    17	from urllib.parse import urlsplit
    18	
    19	from . import paths
    20	from .verify import Fetcher, http_fetch
    21	
    22	TEMPLATE = paths.RECORDS_DIR / "_template.yaml"
    23	
    24	
    25	def page_title(body: bytes) -> str | None:
    26	    m = re.search(rb"<title[^>]*>(.*?)</title>", body, re.IGNORECASE | re.DOTALL)
    27	    if not m:
    28	        return None
    29	    t = " ".join(html.unescape(m.group(1).decode("utf-8", "replace")).split())
    30	    return t[:120] or None
    31	
    32	
    33	def _slug(s: str) -> str:
    34	    return re.sub(r"[^a-z0-9]+", "-", s.lower()).strip("-")
    35	
    36	
    37	def record_id(url: str) -> str:
    38	    """example.org/x -> example/x; data.equinor.com/volve.html -> equinor/volve."""
    39	    u = urlsplit(url)
    40	    labels = (u.hostname or "").removeprefix("www.").split(".")
    41	    publisher = _slug(labels[-2] if len(labels) >= 2 else labels[0]) or "publisher"
    42	    segments = [s for s in u.path.split("/") if s]
    43	    dataset = _slug(segments[-1].rsplit(".", 1)[0]) if segments else ""
    44	    return f"{publisher}/{dataset or 'dataset'}"
    45	
    46	
    47	def scaffold(url: str, title: str | None, rid: str, today: date) -> str:
    48	    u = urlsplit(url)
    49	    header = [line for line in TEMPLATE.read_text().splitlines() if line.startswith("#")]
    50	    q = json.dumps  # a JSON string is a YAML string, whatever the title holds
    51	    return "\n".join([
    52	        *header,
    53	        f"# Scaffolded by `osd new` on {today.isoformat()}. Every null or empty value below is for a",
    54	        "# human to fill from the publisher's page; `osd validate` lists them until they are.",
    55	        f"id: {rid}",
    56	        f"title: {q(title) if title else 'null'}" + ("" if title else "   # fill: the dataset's name"),
    57	        "publisher:",
    58	        "  name: null                                      # fill: the publisher as it names itself",
    59	        f"  url: {u.scheme}://{u.netloc}",
    60	        "origin:",
    61	        f"  url: {q(url)}",
    62	        "  access: null                                    # fill: anonymous | registration | api | request",
    63	        "licence:",
    64	        "  name: null                                      # fill: the licence as the publisher names it",
    65	        "  spdx: null                                      # CC-BY-4.0, CC-BY-SA-4.0, OGL-UK-3.0, NLOD-2.0 or null",
    66	        "  redistribution: null                            # fill: allowed | restricted | forbidden | unknown",
    67	        "  attribution: null                               # fill: required | not-required | unknown",
    68	        "kinds: []                                         # fill: see schema/record.schema.json",
    69	        "region: {}                                        # country, basin, bbox when the publisher states them",
    70	        "listed_by: [community]                            # seg-wiki | publisher | osdu | community",
    71	        f"added: {today.isoformat()}",
    72	        "",
    73	    ])
    74	
    75	
    76	def new_record(url: str, *, title: str | None = None, rid: str | None = None,
    77	               fetch: Fetcher | None = None, records_dir: Path = paths.RECORDS_DIR,
    78	               today: date | None = None) -> Path:
    79	    """Write records/<id>.yaml and return its path; refuses to overwrite an existing record."""
    80	    rid = rid or record_id(url)
    81	    out = records_dir / f"{rid}.yaml"
    82	    if out.exists():
    83	        raise FileExistsError(f"{out} exists")
    84	    if title is None:
    85	        f = (fetch or http_fetch)(url)
    86	        title = page_title(f.body) if 200 <= f.status < 400 else None
    87	    out.parent.mkdir(parents=True, exist_ok=True)
    88	    out.write_text(scaffold(url, title, rid, today or date.today()))
    89	    return out
     1	"""Dead-link report: which records fell from L1 or higher to a dead origin since the last stored run.
     2	
     3	Reads two verification directories (the stored results before a run, the results after it) and
     4	the titles of the issues already open. Returns one issue per newly dead record, titled
     5	"origin dead: <id>", with the HTTP class and the date it died. Never one for:
     6	  blocked  a 403, 429 or challenge page awards no level and is not dead (OSD-D9)
     7	  L0 before  it was not reachable last time either: the death is not new
     8	  reported  an issue with the same title is already open
     9	No network here: the `verify` workflow lists the open issues and creates the new ones.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	import json
    15	from pathlib import Path
    16	
    17	TITLE = "origin dead: {}"
    18	LABEL = "origin-dead"
    19	
    20	
    21	def _results(vdir: Path) -> dict[str, dict]:
    22	    out = {}
    23	    for p in sorted(vdir.glob("*.json")) if vdir.is_dir() else []:
    24	        v = json.loads(p.read_text())
    25	        out[v["record_id"]] = v
    26	    return out
    27	
    28	
    29	def _l1(v: dict) -> str:
    30	    return next((c.get("detail", "") for c in v.get("checks", []) if c["name"] == "origin-reachable"), "")
    31	
    32	
    33	def http_class(v: dict) -> str:
    34	    """HTTP 404 (4xx), HTTP 503 (5xx), or the failure with no HTTP answer (dns, timeout, connection)."""
    35	    status = v.get("origin", {}).get("http_status") or 0
    36	    if status:
    37	        return f"HTTP {status} ({status // 100}xx)"
    38	    kind = _l1(v).split(" at ", 1)[0] or "error"
    39	    return f"no HTTP answer ({kind})"
    40	
    41	
    42	def _body(rid: str, before: dict, after: dict) -> str:
    43	    o = after.get("origin", {})
    44	    return "\n".join([
    45	        f"The origin of `{rid}` stopped answering: **{http_class(after)}** on **{after['checked_at'][:10]}**.",
    46	        "",
    47	        "| | level | checked | origin |",
    48	        "|---|---|---|---|",
    49	        f"| before | {before['level']} | {before['checked_at']} | {_l1(before)} |",
    50	        f"| now | {after['level']} | {after['checked_at']} | {_l1(after)} |",
    51	        "",
    52	        f"Final URL: {o.get('final_url', '')}",
    53	        "",
    54	        ("Opened by the dead-link report of the `verify` workflow (`osd report`). If the publisher "
    55	        "moved the data, update `origin.url` in the record; if it is gone, add a `known_issues` "
    56	        "line. Close this issue when a later verify run reaches the origin again."),
    57	    ])
    58	
    59	
    60	def dead_reports(before_dir: Path, after_dir: Path, open_titles: set[str] = frozenset()) -> dict:
    61	    """{"open": [issue...], "reported": [id...], "blocked": [id...]}, each sorted by record id."""
    62	    before, after = _results(before_dir), _results(after_dir)
    63	    out: dict[str, list] = {"open": [], "reported": [], "blocked": []}
    64	    for rid, a in sorted(after.items()):
    65	        b = before.get(rid)
    66	        if not b or b.get("level", "L0") == "L0":
    67	            continue  # never verified before, or not reachable last time either
    68	        reach = a.get("origin", {}).get("reachability")
    69	        if reach == "blocked":
    70	            out["blocked"].append(rid)
    71	            continue
    72	        if reach != "dead" or a["level"] != "L0":
    73	            continue
    74	        title = TITLE.format(rid)
    75	        if title in open_titles:
    76	            out["reported"].append(rid)
    77	            continue
    78	        out["open"].append({"record_id": rid, "title": title, "http_class": http_class(a),
    79	                            "died": a["checked_at"][:10], "label": LABEL, "body": _body(rid, b, a)})
    80	    return out
    81	
    82	
    83	def report_lines(r: dict, dry_run: bool) -> list[str]:
    84	    verb = "would open" if dry_run else "open"
    85	    n = len(r["open"])
    86	    lines = [(f"dead-link report{' (dry run)' if dry_run else ''}: {n} issue{'s' * (n != 1)} to open, "
    87	             f"{len(r['reported'])} already reported, {len(r['blocked'])} blocked (no issue, OSD-D9)")]
    88	    lines += [f"  {verb}  \"{i['title']}\"  {i['http_class']} on {i['died']}" for i in r["open"]]
    89	    lines += [f"  skip  {rid}: an open issue already names it" for rid in r["reported"]]
    90	    lines += [f"  skip  {rid}: blocked, not dead" for rid in r["blocked"]]
    91	    return lines
    75	    n = build_mod.build()
    76	    print(f"built {n} -> {paths.CATALOG_DIR}")
    77	    return 0
    78	
    79	
    80	def status_lines(vdir: Path = paths.VERIFICATION_DIR, now: datetime | None = None,
    81	                 records_dir: Path = paths.RECORDS_DIR) -> list[str]:
    82	    """The levels `osd build` publishes, read from the same verification directory; an L4 shows
    83	    its coverage beside it, "L4 (2 of 2 converted)" (E09)."""
    84	    rows = []
    85	    for rid, r in load_records(records_dir).items():
    86	        v = build_mod.latest_verification(rid, vdir)
    87	        lv, checked = (v["level"], v["checked_at"]) if v else ("L0", None)
    88	        coverage = conversion_coverage(v)
    89	        lv += f" ({coverage})" if coverage else ""
    90	        when = (checked or "never")[:10] + (" stale" if is_stale(checked, now) else "")
    91	        blocked = (v or {}).get("origin", {}).get("blocked_since")
    92	        when += f" blocked since {blocked[:10]}" if blocked else ""
    93	        rows.append((lv, (f"{rid:36} {when:36} {r['origin']['access']:12} "
    94	                          f"{r['licence']['redistribution']:14} {','.join(r['kinds'])}")))
    95	    w = max([5] + [len(lv) for lv, _ in rows])
    96	    return ([f"{'level':{w}} {'id':36} {'checked':36} {'access':12} {'redistribution':14} kinds"]
    97	            + [f"{lv:{w}} {rest}" for lv, rest in rows])
    98	
    99	
   100	def cmd_status(_: argparse.Namespace) -> int:
   101	    print("\n".join(status_lines()))
   102	    return 0
