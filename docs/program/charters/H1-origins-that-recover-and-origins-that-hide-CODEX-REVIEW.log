    62	    before, after = _results(before_dir), _results(after_dir)
    63	    out: dict[str, list] = {"open": [], "reported": [], "blocked": []}
    64	    for rid, a in sorted(after.items()):
    65	        b = before.get(rid)
    66	        if not b or b.get("level", "L0") == "L0":
    67	            continue  # never verified before, or not reachable last time either
    68	        reach = a.get("origin", {}).get("reachability")
    69	        if reach == "blocked":
    70	            out["blocked"].append(rid)
    71	            continue
    72	        if reach != "dead" or a["level"] != "L0":
    73	            continue
    74	        title = TITLE.format(rid)
    75	        if title in open_titles:
    76	            out["reported"].append(rid)
    77	            continue
    78	        out["open"].append({"record_id": rid, "title": title, "http_class": http_class(a),
    79	                            "died": a["checked_at"][:10], "label": LABEL, "body": _body(rid, b, a)})
    80	    return out
    81	
    82	
    83	def report_lines(r: dict, dry_run: bool) -> list[str]:
    84	    verb = "would open" if dry_run else "open"
    85	    n = len(r["open"])
    86	    lines = [(f"dead-link report{' (dry run)' if dry_run else ''}: {n} issue{'s' * (n != 1)} to open, "
    87	             f"{len(r['reported'])} already reported, {len(r['blocked'])} blocked (no issue, OSD-D9)")]
    88	    lines += [f"  {verb}  \"{i['title']}\"  {i['http_class']} on {i['died']}" for i in r["open"]]
    89	    lines += [f"  skip  {rid}: an open issue already names it" for rid in r["reported"]]
    90	    lines += [f"  skip  {rid}: blocked, not dead" for rid in r["blocked"]]
    91	    return lines
     1	# Network verification. Never a required check: a publisher's outage must not stop merges.
     2	# Pull requests touching records: verify the changed records, comment the levels.
     3	# Dispatch on main: verify (all or some), store the results on the `verification-results`
     4	# branch (OSD-D5: no bucket, no secret), then republish the site so the map shows them.
     5	name: verify
     6	on:
     7	  workflow_dispatch:
     8	    inputs:
     9	      ids: { description: "record ids, space separated (empty = all)", required: false, default: "" }
    10	  pull_request:
    11	    paths: ["records/**", "outlines/**"]
    12	jobs:
    13	  verify:
    14	    runs-on: ubuntu-24.04
    15	    timeout-minutes: 60   # L2 hashes up to 2 GB per run, 2 s pause per host
    16	    permissions: { contents: write, pull-requests: write, actions: write, issues: write }
    17	    steps:
    18	      - uses: actions/checkout@v4
    19	        with: { fetch-depth: 0 }
    20	      - uses: astral-sh/setup-uv@v3
    21	        with: { python-version: "3.12" }
    22	      - run: uv sync
    23	      - name: earlier results (so a partial run keeps the others)
    24	        run: |
    25	          if git ls-remote --exit-code origin verification-results >/dev/null; then
    26	            git fetch -q origin verification-results
    27	            mkdir -p build/verification
    28	            git archive origin/verification-results | tar -x -C build/verification
    29	          fi
    30	          mkdir -p build/verification && cp -r build/verification build/verification-before
    31	      - name: pick ids
    32	        id: ids
    33	        run: |
    34	          if [ "${{ github.event_name }}" = "pull_request" ]; then
    35	            ids=$(git diff --name-only origin/${{ github.base_ref }}...HEAD -- records | sed -n 's|^records/\(.*\)\.yaml$|\1|p' | grep -v '^_' | tr '\n' ' ')
    36	          else
    37	            ids="${{ inputs.ids }}"
    38	          fi
    39	          echo "ids=$ids" >> "$GITHUB_OUTPUT"
    40	      - run: uv run osd verify --outline-inputs ${{ steps.ids.outputs.ids }} | tee verify.txt   # L3 compares committed outlines with today's inputs (E03)
    41	      - name: levels as published (the same levels records.json carries after the republish)
    42	        run: |
    43	          uv run osd status | tee status.txt
    44	          { echo '### osd status'; echo '```'; cat status.txt; echo '```'; } >> "$GITHUB_STEP_SUMMARY"
    45	      - name: dead-link report (issues on a dispatch on main, a dry run otherwise)
    46	        continue-on-error: true
    47	        env: { GH_TOKEN: "${{ github.token }}", GH_REPO: "${{ github.repository }}" }
    48	        run: |
    49	          gh issue list --state open --limit 1000 --json title --jq '.[].title' > open-titles.txt || : > open-titles.txt
    50	          dry=--dry-run
    51	          if [ "${{ github.event_name }}" = "workflow_dispatch" ] && [ "${{ github.ref }}" = "refs/heads/main" ]; then dry=; fi
    52	          uv run osd report --before build/verification-before --after build/verification \
    53	            --open-titles open-titles.txt --out dead.json $dry | tee dead.txt
    54	          { echo '### dead-link report'; echo '```'; cat dead.txt; echo '```'; } >> "$GITHUB_STEP_SUMMARY"
    55	          if [ -z "$dry" ] && [ "$(jq length dead.json)" -gt 0 ]; then
    56	            gh label create origin-dead --color d93f0b --description "Opened by the dead-link report: an origin fell from L1+ to dead" --force
    57	            jq -c '.[]' dead.json | while read -r issue; do
    58	              gh issue create --title "$(jq -r .title <<<"$issue")" --body "$(jq -r .body <<<"$issue")" --label origin-dead
    59	            done
    60	          fi
    61	      - uses: actions/upload-artifact@v4
    62	        with: { name: verification, path: build/verification }
    63	      - name: comment on the pull request
    64	        if: github.event_name == 'pull_request'
    65	        env: { GH_TOKEN: "${{ github.token }}" }
    66	        run: |
    67	          { echo '### Verification'; echo '```'; cat verify.txt; echo '```'; echo '### osd status'; echo '```'; cat status.txt; echo '```'
    68	            echo '### dead-link report'; echo '```'; cat dead.txt 2>/dev/null || echo 'not run'; echo '```'; } > body.md
    69	          gh pr comment ${{ github.event.pull_request.number }} --body-file body.md || true
    70	      - name: full STAC tree (OSD-D18; the gate validates a sample of Items)
    71	        if: github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main'
    72	        run: make check-full
    73	      - name: store results and republish
    74	        if: github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main'
    75	        env: { GH_TOKEN: "${{ github.token }}" }
    76	        run: |
    77	          cd build/verification
    78	          git init -q -b verification-results
    79	          git config user.name "osd-verifier"; git config user.email "osd-verifier@users.noreply.github.com"
    80	          git add -A
    81	          git commit -q -m "verification $(date -u +%FT%TZ) run ${{ github.run_id }}"
    82	          git push -f "https://x-access-token:${GH_TOKEN}@github.com/${{ github.repository }}.git" verification-results
    83	          gh workflow run pages.yml --repo ${{ github.repository }} --ref main
