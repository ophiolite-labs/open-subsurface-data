    94	        "record_id": rec["id"],
    95	        "checked_at": (now or datetime.now(UTC)).isoformat(timespec="seconds"),
    96	        "tool_version": __version__,
    97	        "level": level_from_checks(checks),
    98	        "checks": checks,
    99	        "origin": origin,
