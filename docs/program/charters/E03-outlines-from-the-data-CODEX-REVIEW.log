testpaths = ["tests"]
import json
from datetime import UTC, datetime

from jsonschema import Draft202012Validator

from osd import paths
from osd.records import load_record
from osd.verify import Fetched, level_from_checks, verify_record

NOW = datetime(2026, 10, 23, 12, 0, tzinfo=UTC)
REC = load_record(paths.RECORDS_DIR / "terranubis" / "f3-demo-2020.yaml")


def fetch_ok(url):
    return Fetched(200, url, "text/html", 12)


def fetch_dead(url):
    return Fetched(404, url, "", 12)


def test_reachable_origin_with_placeholder_outline_is_L1():
    outline = json.loads(paths.outline_path(REC["id"]).read_text())
    v = verify_record(REC, fetch_ok, outline, now=NOW)
    assert v["level"] == "L1"
    names = {c["name"]: c["outcome"] for c in v["checks"]}
    assert names["origin-reachable"] == "pass"
    assert names["outline-derived"] == "fail"  # approximate: true


def test_dead_origin_is_L0():
    v = verify_record(REC, fetch_dead, None, now=NOW)
    assert v["level"] == "L0"


def test_verification_record_matches_schema():
    schema = json.loads((paths.SCHEMA_DIR / "verification.schema.json").read_text())
    v = verify_record(REC, fetch_ok, None, now=NOW)
    Draft202012Validator(schema).validate(v)


def test_level_ladder_has_no_gaps():
    # L2 passing cannot lift the level over a failed L1
    checks = [{"name": "a", "level": "L1", "outcome": "fail"},
              {"name": "b", "level": "L2", "outcome": "pass"}]
    assert level_from_checks(checks) == "L0"
    checks[0]["outcome"] = "pass"
    assert level_from_checks(checks) == "L2"
    # a skipped check at a level stops the ladder there
    checks.append({"name": "c", "level": "L3", "outcome": "skip"})
    assert level_from_checks(checks) == "L2"
"""Validity is three tests, each with its own mutation (a single check can pass vacuously)."""
from osd.records import validate_outlines, validate_records


def test_repository_records_and_outlines_are_valid():
    assert validate_records() == []
    assert validate_outlines() == []


def test_schema_violation_is_reported(tmp_records):
    p = tmp_records / "acme" / "demo.yaml"
    p.write_text(p.read_text().replace("access: anonymous", "access: sometimes"))
    msgs = [str(x) for x in validate_records(tmp_records)]
    assert any("origin/access" in m for m in msgs), msgs


def test_id_must_match_path(tmp_records):
    p = tmp_records / "acme" / "demo.yaml"
    p.write_text(p.read_text().replace("id: acme/demo", "id: acme/other"))
    msgs = [str(x) for x in validate_records(tmp_records)]
    assert any("does not match the file path" in m for m in msgs), msgs


def test_outline_must_name_its_record(tmp_records, tmp_outlines):
    assert validate_outlines(tmp_outlines, tmp_records) == []
    bad = tmp_outlines / "acme__demo.geojson"
    bad.write_text(bad.read_text().replace('"record_id": "acme/demo"', '"record_id": "acme/nope"'))
    msgs = [str(x) for x in validate_outlines(tmp_outlines, tmp_records)]
    assert any("record_id" in m for m in msgs), msgs


def test_outline_without_record_is_reported(tmp_records, tmp_outlines):
    (tmp_outlines / "acme__ghost.geojson").write_text('{"type":"FeatureCollection","features":[]}')
    msgs = [str(x) for x in validate_outlines(tmp_outlines, tmp_records)]
    assert any("no record 'acme/ghost'" in m for m in msgs), msgs

