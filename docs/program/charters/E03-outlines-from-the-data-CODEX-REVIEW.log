    31	
    32	def record_files(records_dir: Path = paths.RECORDS_DIR) -> list[Path]:
    33	    return sorted(records_dir.glob("*/*.yaml"))
    34	
    35	
    36	def load_record(path: Path) -> dict:
    37	    data = yaml.safe_load(path.read_text())
    38	    if not isinstance(data, dict):
    39	        raise TypeError(f"{path}: not a mapping")
    40	    # dates: yaml parses 2026-10-23 into a date; the schema wants the ISO string
    41	    if "added" in data and not isinstance(data["added"], str):
    42	        data["added"] = data["added"].isoformat()
    43	    return data
    44	
    45	
    46	def load_records(records_dir: Path = paths.RECORDS_DIR) -> dict[str, dict]:
    47	    out: dict[str, dict] = {}
    48	    for p in record_files(records_dir):
    49	        rec = load_record(p)
    50	        out[rec.get("id", str(p))] = rec
    51	    return out
    52	
    53	
    54	def validate_records(records_dir: Path = paths.RECORDS_DIR) -> list[Problem]:
    55	    """Schema validity plus the two consistency rules a schema cannot express."""
    56	    problems: list[Problem] = []
    57	    v = _validator("record")
    58	    seen: dict[str, Path] = {}
    59	    for p in record_files(records_dir):
    60	        rel = str(p.relative_to(records_dir))
    61	        try:
    62	            rec = load_record(p)
    63	        except (OSError, TypeError, yaml.YAMLError) as e:
    64	            problems.append(Problem(rel, f"unreadable: {e}"))
    65	            continue
    66	        for err in sorted(v.iter_errors(rec), key=lambda e: list(e.path)):
    67	            where = "/".join(str(x) for x in err.path) or "<root>"
    68	            problems.append(Problem(rel, f"{where}: {err.message}"))
    69	        rid = rec.get("id")
    70	        if isinstance(rid, str):
    71	            if rid + ".yaml" != rel:
    72	                problems.append(Problem(rel, f"id '{rid}' does not match the file path"))
    73	            if rid in seen:
    74	                problems.append(Problem(rel, f"duplicate id '{rid}' (also {seen[rid].name})"))
    75	            seen[rid] = p
    76	        lic = rec.get("licence", {})
    77	        if lic.get("share_alike") and lic.get("redistribution") == "forbidden":
    78	            problems.append(Problem(rel, "share_alike with redistribution forbidden is contradictory"))
    79	    return problems
    80	
