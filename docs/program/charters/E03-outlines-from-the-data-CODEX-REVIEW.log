    86	def validate_outlines(
    87	    outlines_dir: Path = paths.OUTLINES_DIR, records_dir: Path = paths.RECORDS_DIR
    88	) -> list[Problem]:
    89	    """Each outline file is a FeatureCollection whose features carry the outline properties
    90	    and name an existing record; the file name must match that record."""
    91	    problems: list[Problem] = []
    92	    v = _validator("outline")
    93	    known = set(load_records(records_dir))
    94	    for p in sorted(outlines_dir.glob("*.geojson")):
    95	        rel = p.name
    96	        try:
    97	            fc = load_outline(p)
    98	        except (OSError, ValueError) as e:
    99	            problems.append(Problem(rel, f"unreadable: {e}"))
   100	            continue
   101	        if fc.get("type") != "FeatureCollection":
   102	            problems.append(Problem(rel, "not a FeatureCollection"))
   103	            continue
   104	        expected_id = p.stem.replace("__", "/")
   105	        if expected_id not in known:
   106	            problems.append(Problem(rel, f"no record '{expected_id}' for this outline file"))
   107	        for i, f in enumerate(fc.get("features", [])):
   108	            props = f.get("properties", {})
   109	            for err in v.iter_errors(props):
   110	                problems.append(Problem(rel, f"feature {i}: {err.message}"))
   111	            if props.get("record_id") != expected_id:
   112	                problems.append(
   113	                    Problem(rel, f"feature {i}: record_id '{props.get('record_id')}' != '{expected_id}'")
   114	                )
   115	            g = f.get("geometry") or {}
   116	            if g.get("type") not in {"Point", "Polygon", "LineString", "MultiPolygon"}:
   117	                problems.append(Problem(rel, f"feature {i}: geometry type {g.get('type')!r} not allowed"))
   118	    return problems
