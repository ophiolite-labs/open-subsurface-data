   103	def verify_all(ids: list[str] | None = None, fetch: Fetcher = http_fetch,
   104	               out_dir: Path = paths.VERIFICATION_DIR) -> list[dict]:
   105	    recs = load_records()
   106	    out_dir.mkdir(parents=True, exist_ok=True)
   107	    results = []
   108	    for rid, rec in recs.items():
   109	        if ids and rid not in ids:
   110	            continue
   111	        op = paths.outline_path(rid)
   112	        outline = load_outline(op) if op.exists() else None
   113	        v = verify_record(rec, fetch, outline)
   114	        (out_dir / (rid.replace("/", "__") + ".json")).write_text(json.dumps(v, indent=2) + "\n")
