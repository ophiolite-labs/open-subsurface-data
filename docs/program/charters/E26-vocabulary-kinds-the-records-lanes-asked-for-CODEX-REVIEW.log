schema/manifest.schema.json:74:        "attribution": {"enum": ["required", "not-required", "unknown", null],
schema/manifest.schema.json:79:                  "description": "v4. The record's licence.terms (record/3), copied whole: the keys the record states, nothing added",
schema/manifest.schema.json:98:        "access": {"enum": ["anonymous", "registration", "api", "request", "purchase"], "description": "purchase is v4 only"},
schema/manifest.schema.json:104:        "coverage": {"enum": ["sampled", "complete"], "description": "sampled: the files the verifier hashed, not the whole dataset"},
