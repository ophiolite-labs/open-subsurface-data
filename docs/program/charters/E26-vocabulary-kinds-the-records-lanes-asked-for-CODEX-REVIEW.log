schema/manifest.schema.json:2:  "$schema": "https://json-schema.org/draft/2020-12/schema",
schema/manifest.schema.json:3:  "$id": "https://open-subsurface-data.org/schema/manifest/4",
schema/manifest.schema.json:4:  "title": "Retrieval manifest, version 4 (osd.manifest/4; osd.manifest/1, /2 and /3 still validate)",
schema/manifest.schema.json:5:  "description": "What a person selected from the catalogue and where its files are. Written by `osd manifest` (and, later, the site), read by `osd get` and `osd.manifest.read`. Assets are the STAC Collection assets, which are the files the verifier hashed: a sample, never the whole dataset unless `coverage` says complete. Never carries credentials. v2 (E07): an asset may name `alternates`, other locations of the same bytes (the mirror), tried before `href`; a manifest with alternates says osd.manifest/2, one without may stay osd.manifest/1. v3 (E09): `metadata.catalog` names the catalogue snapshot the manifest was written from (records.json `catalog`, copied whole); a /3 manifest carries it, /1 and /2 must not. A /3 licence may state `attribution: null` (the source states no value), which /1 and /2 refuse. v4 (E19): the record/3 vocabulary travels: an entry may say `access: purchase` and its licence may carry `terms`, copied whole (absent keys stay absent); a /4 manifest carries `metadata.catalog` like /3, and /1 to /3 refuse both new values, so an old manifest means what it meant. A manifest is written as /4 only when an entry needs it.",
schema/manifest.schema.json:10:    "format": {"enum": ["osd.manifest/1", "osd.manifest/2", "osd.manifest/3", "osd.manifest/4"]},
schema/manifest.schema.json:13:    "selection": {"enum": ["collections", "items"], "description": "Collection selection or Item selection, never a mix"},
schema/manifest.schema.json:20:    {"if": {"properties": {"format": {"const": "osd.manifest/1"}}},
schema/manifest.schema.json:23:    {"if": {"properties": {"format": {"enum": ["osd.manifest/3", "osd.manifest/4"]}}},
schema/manifest.schema.json:28:    {"if": {"properties": {"format": {"const": "osd.manifest/4"}}},
