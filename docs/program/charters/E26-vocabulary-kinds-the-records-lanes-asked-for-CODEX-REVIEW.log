    91	def test_record_2_files_validate_under_record_2():
    92	    """Every record/2 file is a record/3 file; every current record without its record/3 values is a
    93	    record/2 file under the frozen record/2 schema."""
    94	    assert not list(RECORD_2.iter_errors(_base())) and not _errors(_base())
    95	    assert list(RECORD_2.iter_errors(_base(access="purchase")))     # the frozen copy is the old contract
    96	    old = 0
    97	    for p in record_files():
    98	        rec = load_record(p)
    99	        assert not list(RECORD_3.iter_errors(rec)), p
   100	        if (rec["origin"]["access"] == "purchase" or "potential-fields" in rec["kinds"]
   101	                or "terms" in rec["licence"]):
   102	            continue
   103	        assert not list(RECORD_2.iter_errors(rec)), p
   104	        old += 1
   105	    assert old >= 89   # at least 96 records (E20), seven carry record/3 values
