def test_static_manifest_3_fixtures_equal_what_osd_manifest_writes(tmp_path, rid):
    """Ophiolite E127 reads tests/fixtures/fidelity/manifest-*.json by path (pinned to a commit):
    each must stay exactly what `osd manifest <rid>` writes from the fixture catalogue."""
    out = tmp_path / "catalog"
    build(out, FIDELITY / "verification", now=NOW, mirror_dir=tmp_path / "no-mirror",
          records_dir=FIDELITY / "records", source_commit="1" * 40, verification_commit="2" * 40)
    written = mf.write(mf.from_catalog([rid], out, now=NOW), tmp_path / "manifest.json")
    committed = FIDELITY / f"manifest-{rid.split('/')[1]}.json"
    assert json.loads(committed.read_text()) == json.loads(written.read_text()), (
        f"{committed.name} drifted from osd manifest; regenerate it and tell E127 the new pin")
    assert mf.read(committed).catalog == mf.Catalog(**json.loads((FIDELITY / "fidelity.json").read_text())["catalog"])

"""how.html's three cards run as written, against a local server instead of the live site.

Offline: the catalogue is built into a temporary directory and served on 127.0.0.1.
"""

import html
import json
import re
import shutil
import subprocess
import sys
import threading
import urllib.request
from functools import partial
from http.server import SimpleHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

import pytest

from osd.build import build

ROOT = Path(__file__).resolve().parents[2]
LIVE = "https://opensubsurfacedata.org/"


def snippets():
    page = (ROOT / "site" / "how.html").read_text()
    found = re.findall(r'<pre data-snippet="(\w+)">(.*?)</pre>', page, re.DOTALL)
    return [(kind, html.unescape(body)) for kind, body in found]


@pytest.fixture(scope="module")
def site(tmp_path_factory):
    root = tmp_path_factory.mktemp("site")
    for f in ("index.html", "how.html", "app.js", "style.css"):
        shutil.copy(ROOT / "site" / f, root / f)
    build(root / "data", tmp_path_factory.mktemp("verification"))
    handler = partial(type("Quiet", (SimpleHTTPRequestHandler,), {"log_message": lambda *a: None}),
                      directory=str(root))
    server = ThreadingHTTPServer(("127.0.0.1", 0), handler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    yield f"http://127.0.0.1:{server.server_port}/"
    server.shutdown()


def test_how_page_has_the_three_cards():
    kinds = [k for k, _ in snippets()]
    assert kinds == ["url", "python", "python"]
    assert all(LIVE in body for _, body in snippets())


@pytest.mark.parametrize("i", range(3))
def test_snippet_runs_as_written(site, i):
    kind, body = snippets()[i]
    body = body.replace(LIVE, site)
    if kind == "url":
        fc = json.load(urllib.request.urlopen(body.strip()))
        assert fc["type"] == "FeatureCollection" and fc["features"]
        assert all("record_id" in f["properties"] for f in fc["features"])
    else:
        run = subprocess.run([sys.executable, "-c", body], check=False, capture_output=True, text=True, timeout=30)
        assert run.returncode == 0, run.stderr
        assert run.stdout.strip() and not run.stdout.startswith("0 ")

