    21	def cmd_validate(_: argparse.Namespace) -> int:
    22	    problems = validate_records() + validate_outlines()
    23	    for p in problems:
    24	        print(f"  {p}")
    25	    n = len(load_records())
    26	    print(f"{n} records, {len(problems)} problems")
    27	    return 1 if problems else 0
    28	
    29	
    30	def cmd_verify(a: argparse.Namespace) -> int:
    31	    results = verify_all(ids=a.ids or None, derive=a.outlines, fetch_inputs=a.outline_inputs)
    32	    for v in results:
    33	        o = v["origin"]
    34	        l2 = "; ".join(f"{c['name']}: {c['outcome']} ({c.get('detail', '')})" for c in v["checks"] if c["level"] == "L2")
    35	        l3 = "; ".join(f"{c['name']}: {c['outcome']} ({c.get('detail', '')})" for c in v["checks"] if c["level"] == "L3")
    36	        print(f"  {v['level']}  {v['record_id']}  (origin {o.get('reachability')} HTTP {o.get('http_status')}; {l2}; {l3})")
    37	    print(f"{len(results)} verified -> {paths.VERIFICATION_DIR}")
    38	    return 0
    39	
    40	
    41	def cmd_build(_: argparse.Namespace) -> int:
    42	    n = build_mod.build()
    43	    print(f"built {n} -> {paths.CATALOG_DIR}")
    44	    return 0
    45	
