    47	def status_lines(vdir: Path = paths.VERIFICATION_DIR, now: datetime | None = None) -> list[str]:
    48	    """The levels `osd build` publishes, read from the same verification directory."""
    49	    lines = [f"{'level':5} {'id':36} {'checked':36} {'access':12} {'redistribution':14} kinds"]
    50	    for rid, r in load_records().items():
    51	        v = build_mod.latest_verification(rid, vdir)
    52	        lv, checked = (v["level"], v["checked_at"]) if v else ("L0", None)
    53	        when = (checked or "never")[:10] + (" stale" if is_stale(checked, now) else "")
    54	        blocked = (v or {}).get("origin", {}).get("blocked_since")
    55	        when += f" blocked since {blocked[:10]}" if blocked else ""
    56	        lines.append(f"{lv:5} {rid:36} {when:36} {r['origin']['access']:12} "
    57	                     f"{r['licence']['redistribution']:14} {','.join(r['kinds'])}")
    58	    return lines
