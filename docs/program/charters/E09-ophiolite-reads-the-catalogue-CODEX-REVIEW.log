   118	def main(argv: list[str] | None = None) -> int:
   119	    ap = argparse.ArgumentParser(prog="osd", description=__doc__)
   120	    sub = ap.add_subparsers(dest="cmd", required=True)
   121	    sub.add_parser("validate", help="records and outlines against their schemas").set_defaults(fn=cmd_validate)
   122	    pv = sub.add_parser("verify", help="network: reach each origin, write verification records")
   123	    pv.add_argument("ids", nargs="*")
   124	    pv.add_argument("--outlines", action="store_true",
   125	                    help="also fetch outline inputs and rewrite outlines/ (osd.outlines, E03)")
   126	    pv.add_argument("--outline-inputs", action="store_true",
   127	                    help="also fetch outline inputs and check the committed outlines against them (CI)")
   128	    pv.set_defaults(fn=cmd_verify)
   129	    sub.add_parser("build", help="write build/catalog").set_defaults(fn=cmd_build)
   130	    sub.add_parser("status", help="one line per record").set_defaults(fn=cmd_status)
   131	    pn = sub.add_parser("new", help="scaffold records/<id>.yaml from a dataset page (reads its title)")
   132	    pn.add_argument("url")
   133	    pn.add_argument("--id", help="publisher/dataset (default: from the address)")
