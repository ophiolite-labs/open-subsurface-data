     1	"""Verification: what our tools can establish about a record today.
     2	
     3	L1 (origin reachable), L2 (sample files checksummed, licence text captured) and L3 (outlines
     4	derived from the data, E03: see osd.outlines) are implemented. L4 (canonical conversion) is a
     5	chartered epic; its check is declared here with outcome "skip" so the ladder stays stable.
     6	
     7	Reachability is one of four closed, exclusive classes, decided on the final response:
     8	  blocked  HTTP 403 or 429, or a challenge page at any status: a separate observation that awards
     9	           no level (OSD-D9); `blocked_since` keeps the first date of an unbroken blocked run
    10	  ok       2xx/3xx with the origin's host
    11	  moved    2xx/3xx on another host: passes, the detail suggests a record update
    12	  dead     anything else: status 0 (DNS, timeout, refused), 401, 404, 410, other 4xx, 5xx;
    13	           timeouts, refused connections and 5xx are retried once first
    14	Sampling policy (which listed files L2 hashes) is tool configuration in verifier/samples.yaml,
    15	keyed by record id, never a record field (OSD-D11).
    16	
    17	The network is injected twice: a Fetcher probes an origin (first 16 KB), an Opener streams a
    18	body in chunks and raises FetchError. Tests pass fakes, so the required CI check stays offline.
    19	"""
    20	
    21	from __future__ import annotations
    22	
    23	import hashlib
    24	import html
    25	import json
    26	import re
    27	import socket
    28	import time
    29	import urllib.error
    30	import urllib.request
    31	import urllib.robotparser
    32	from collections.abc import Callable, Iterable
    33	from dataclasses import dataclass
    34	from datetime import UTC, datetime, timedelta
    35	from fnmatch import fnmatchcase
    36	from functools import cache
    37	from html.parser import HTMLParser
    38	from pathlib import Path
    39	from urllib.parse import quote, urljoin, urlsplit
    40	
    41	import yaml
    42	from jsonschema import Draft202012Validator
    43	
    44	from . import __version__, outlines, paths
    45	from .records import load_outline, load_records
    46	
    47	SAMPLES_PATH = Path(__file__).parent / "verifier" / "samples.yaml"
    48	
    49	LEVELS = ["L0", "L1", "L2", "L3", "L4"]
    50	USER_AGENT = ("open-subsurface-data-verifier/" + __version__
    51	              + " (+https://github.com/ophiolite-labs/open-subsurface-data)")
    52	PROBE_BYTES = 16384
    53	CHUNK = 1 << 20
    54	RUN_BYTE_BUDGET = 2 * 1024**3  # charter: never hash more than 2 GB per run
    55	LISTING_BYTES = 32 * 1024**2
    56	LICENCE_BYTES = 8 * 1024**2
    57	LICENCE_TEXT_CHARS = 100_000  # stored with its hash in the results store
    58	PAUSE_S = 2.0
    59	STALE_DAYS = 30
    60	CHALLENGE_MARKERS = (b"cf-chl", b"challenge-platform", b"Just a moment...",
    61	                     b"Attention Required! | Cloudflare", b"_Incapsula_Resource")
    62	
    63	
    64	@dataclass(frozen=True)
    65	class Fetched:
    66	    status: int
    67	    final_url: str
    68	    content_type: str
    69	    elapsed_ms: int
    70	    body: bytes = b""
    71	    error: str = ""  # "", "timeout", "dns" or "connection" when status is 0
    72	
    73	
    74	class FetchError(Exception):
    75	    def __init__(self, url: str, status: int = 0, error: str = ""):
    76	        self.url, self.status, self.error = url, status, error
    77	        super().__init__(f"HTTP {status} from {url}" if status else f"{error or 'error'} at {url}")
    78	
    79	
    80	Fetcher = Callable[[str], Fetched]
    81	Opener = Callable[[str], Iterable[bytes]]
    82	
    83	
    84	# --- network (only used outside tests) ---------------------------------------------------
    85	
    86	def _error_kind(e: BaseException) -> str:
    87	    reason = getattr(e, "reason", e)
    88	    if isinstance(reason, socket.gaierror):
    89	        return "dns"
    90	    if isinstance(reason, TimeoutError) or "timed out" in str(reason):
    91	        return "timeout"
    92	    return "connection"
    93	
    94	
    95	def http_fetch(url: str, timeout: float = 20.0) -> Fetched:
    96	    """GET the first 16 KB; HEAD is refused by too many publishers to be useful."""
    97	    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Range": f"bytes=0-{PROBE_BYTES - 1}"})
    98	    t0 = time.monotonic()
    99	    ms = lambda: int((time.monotonic() - t0) * 1000)
   100	    try:
   101	        with urllib.request.urlopen(req, timeout=timeout) as resp:
   102	            body = resp.read(PROBE_BYTES)
   103	            return Fetched(resp.status, resp.geturl(), resp.headers.get("Content-Type", ""), ms(), body)
   104	    except urllib.error.HTTPError as e:
   105	        try:
   106	            body = e.read(PROBE_BYTES)
   107	        except OSError:
   108	            body = b""
   109	        return Fetched(e.code, url, e.headers.get("Content-Type", "") if e.headers else "", ms(), body)
   110	    except (urllib.error.URLError, TimeoutError, OSError) as e:
   111	        return Fetched(0, url, "", ms(), error=_error_kind(e))
   112	
   113	
   114	def http_open(url: str, timeout: float = 60.0) -> Iterable[bytes]:
   115	    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
     1	"""Build the published catalogue from records, outlines and verification records.
     2	
     3	Outputs (build/catalog/):
     4	  records.json    every record, joined with its latest verification level, the date it was
     5	                   established, `stale` when that date is over 30 days old (or absent) and
     6	                   `blocked_since` while the origin refuses this runner (OSD-D9)
     7	  outlines.geojson one FeatureCollection, every feature joined with record title, kinds,
     8	                   licence and level so the map needs no second lookup
     9	  stac/            the static STAC catalogue (src/osd/stac.py)
    10	  collections.json {"collections": [...]}, the same STAC Collections in one file
    11	  outlines.pmtiles the same features as vector tiles, z0-12, when tippecanoe is installed (E15)
    12	"""
    13	
    14	from __future__ import annotations
    15	
    16	import json
    17	from datetime import datetime
    18	from pathlib import Path
    19	
    20	from . import __version__, paths, stac
    21	from .records import load_outline, load_records
    22	from .verify import is_stale
    23	
    24	
    25	def latest_verification(rid: str, vdir: Path = paths.VERIFICATION_DIR) -> dict | None:
    26	    p = vdir / (rid.replace("/", "__") + ".json")
    27	    return json.loads(p.read_text()) if p.exists() else None
    28	
    29	
    30	def build(out_dir: Path = paths.CATALOG_DIR, vdir: Path = paths.VERIFICATION_DIR,
    31	          now: datetime | None = None) -> dict:
    32	    out_dir.mkdir(parents=True, exist_ok=True)
    33	    recs = load_records()
    34	    records_out = []
    35	    features = []
    36	    for rid, rec in recs.items():
    37	        v = latest_verification(rid, vdir)
    38	        level = v["level"] if v else "L0"
    39	        checked = v["checked_at"] if v else None
    40	        blocked = (v or {}).get("origin", {}).get("blocked_since")
    41	        joined = dict(rec, level=level, checked_at=checked, stale=is_stale(checked, now), blocked_since=blocked)
    42	        records_out.append(joined)
    43	        op = paths.outline_path(rid)
    44	        if op.exists():
    45	            for f in load_outline(op)["features"]:
    46	                props = dict(f["properties"])
    47	                props.update({
    48	                    "title": rec["title"], "publisher": rec["publisher"]["name"],
    49	                    "kinds": rec["kinds"], "licence": rec["licence"]["name"],
    50	                    "redistribution": rec["licence"]["redistribution"], "level": level,
    51	                })
    52	                fid = {"id": props["feature_id"]} if "feature_id" in props else {}
    53	                features.append({"type": "Feature", **fid, "properties": props, "geometry": f["geometry"]})
    54	    (out_dir / "records.json").write_text(json.dumps(
    55	        {"tool_version": __version__, "count": len(records_out), "records": records_out}, indent=2) + "\n")
    56	    (out_dir / "outlines.geojson").write_text(json.dumps(
    57	        {"type": "FeatureCollection", "features": features}) + "\n")
    58	    collections = stac.write_catalog(out_dir, records_out, vdir)
    59	    (out_dir / "collections.json").write_text(json.dumps({"collections": collections}, indent=2) + "\n")
    60	    write_tiles(out_dir) if out_dir == paths.CATALOG_DIR else None  # test builds into tmp dirs skip tiling
    61	    return {"records": len(records_out), "features": len(features), "collections": len(collections)}
    62	
    63	
    64	# Tiling (E15). One source layer, "outlines", every GeoJSON property kept. Points are kept at every
    65	# zoom (-r1) and clustered by the page; polygons are simplified by tippecanoe below zoom 8 only, so
    66	# z0-7 and z8-12 are two runs joined. Pinned in CI: Ubuntu 24.04 tippecanoe 2.49.0-1build1.
    67	TIPPECANOE_PIN = "2.49.0"
    68	TILE_RUNS = (
    69	    ["-Z0", "-z7"],
    70	    ["-Z8", "-z12", "--no-line-simplification"],
    71	)
    72	TILE_COMMON = ["-q", "-f", "-l", "outlines", "-r1", "--no-feature-limit", "--no-tile-size-limit",
    73	               "--no-tiny-polygon-reduction"]
    74	
    75	
    76	def write_tiles(out_dir: Path, cache_dir: Path = paths.BUILD_DIR / "tiles") -> Path | None:
    77	    """out_dir/outlines.pmtiles from out_dir/outlines.geojson, or None with a notice when
    78	    tippecanoe is absent (the page then reads the GeoJSON whole). Cached by input and tool version,
    79	    so a second build of the same outlines (the site test's) costs a copy."""
    80	    import hashlib
    81	    import shutil
    82	    import subprocess
    83	    import sys
    84	    import tempfile
    85	
    86	    src, dst = out_dir / "outlines.geojson", out_dir / "outlines.pmtiles"
    87	    dst.unlink(missing_ok=True)
    88	    if not (shutil.which("tippecanoe") and shutil.which("tile-join")):
    89	        print("notice: tippecanoe not found, outlines.pmtiles not written; the map reads outlines.geojson "
    90	              f"whole (install tippecanoe {TIPPECANOE_PIN}, see .github/workflows/ci.yml)", file=sys.stderr)
    91	        return None
    92	    version = subprocess.run(["tippecanoe", "--version"], capture_output=True, text=True, check=False).stderr.strip()
    93	    key = hashlib.sha256(src.read_bytes())
    94	    key.update(json.dumps([version, TILE_RUNS, TILE_COMMON]).encode())
    95	    cached = cache_dir / f"outlines-{key.hexdigest()[:16]}.pmtiles"
    96	    if not cached.exists():
    97	        cache_dir.mkdir(parents=True, exist_ok=True)
    98	        with tempfile.TemporaryDirectory() as tmp:
    99	            parts = [Path(tmp) / f"z{i}.pmtiles" for i in range(len(TILE_RUNS))]
   100	            runs = [subprocess.Popen(["tippecanoe", *TILE_COMMON, *zooms, "-o", str(part), str(src)],
   101	                                     stderr=subprocess.PIPE, text=True) for zooms, part in zip(TILE_RUNS, parts)]
   102	            for r in runs:
   103	                err = r.communicate()[1]
   104	                if r.returncode:
   105	                    raise RuntimeError(f"tippecanoe failed: {err}")
   106	            joined = Path(tmp) / "outlines.pmtiles"
   107	            j = subprocess.run(["tile-join", "-q", "-f", "--no-tile-size-limit", "-o", str(joined), *map(str, parts)],
   108	                               capture_output=True, text=True, check=False)
   109	            if j.returncode:
   110	                raise RuntimeError(f"tile-join failed: {j.stderr}")
   111	            for old in cache_dir.glob("outlines-*.pmtiles"):
   112	                old.unlink()
   113	            shutil.move(joined, cached)
   114	    shutil.copyfile(cached, dst)
   115	    note = "" if TIPPECANOE_PIN in version else f" (CI pins {TIPPECANOE_PIN})"
   116	    print(f"tiles: {dst.name} {dst.stat().st_size / 1e6:.1f} MB, z0-12, {version}{note}", file=sys.stderr)
   117	    return dst
