     1	"""Dead-link report: which records fell from L1 or higher to a dead origin since the last stored run.
     2	
     3	Reads two verification directories (the stored results before a run, the results after it) and
     4	the titles of the issues already open. Returns one issue per newly dead record, titled
     5	"origin dead: <id>", with the HTTP class and the date it died. Never one for:
     6	  blocked  a 403, 429 or challenge page awards no level and is not dead (OSD-D9)
     7	  L0 before  it was not reachable last time either: the death is not new
     8	  reported  an issue with the same title is already open
     9	No network here: the `verify` workflow lists the open issues and creates the new ones.
    10	"""
    11	
    12	from __future__ import annotations
    13	
    14	import json
    15	from pathlib import Path
    16	
    17	TITLE = "origin dead: {}"
    18	LABEL = "origin-dead"
    19	
    20	
    21	def _results(vdir: Path) -> dict[str, dict]:
    22	    out = {}
    23	    for p in sorted(vdir.glob("*.json")) if vdir.is_dir() else []:
    24	        v = json.loads(p.read_text())
    25	        out[v["record_id"]] = v
    26	    return out
    27	
    28	
    29	def _l1(v: dict) -> str:
    30	    return next((c.get("detail", "") for c in v.get("checks", []) if c["name"] == "origin-reachable"), "")
    31	
    32	
    33	def http_class(v: dict) -> str:
    34	    """HTTP 404 (4xx), HTTP 503 (5xx), or the failure with no HTTP answer (dns, timeout, connection)."""
    35	    status = v.get("origin", {}).get("http_status") or 0
    36	    if status:
    37	        return f"HTTP {status} ({status // 100}xx)"
    38	    kind = _l1(v).split(" at ", 1)[0] or "error"
    39	    return f"no HTTP answer ({kind})"
    40	
    41	
    42	def _body(rid: str, before: dict, after: dict) -> str:
    43	    o = after.get("origin", {})
    44	    return "\n".join([
    45	        f"The origin of `{rid}` stopped answering: **{http_class(after)}** on **{after['checked_at'][:10]}**.",
    46	        "",
    47	        "| | level | checked | origin |",
    48	        "|---|---|---|---|",
    49	        f"| before | {before['level']} | {before['checked_at']} | {_l1(before)} |",
    50	        f"| now | {after['level']} | {after['checked_at']} | {_l1(after)} |",
    51	        "",
    52	        f"Final URL: {o.get('final_url', '')}",
    53	        "",
    54	        ("Opened by the dead-link report of the `verify` workflow (`osd report`). If the publisher "
    55	        "moved the data, update `origin.url` in the record; if it is gone, add a `known_issues` "
    56	        "line. Close this issue when a later verify run reaches the origin again."),
    57	    ])
    58	
    59	
    60	def dead_reports(before_dir: Path, after_dir: Path, open_titles: set[str] = frozenset()) -> dict:
    61	    """{"open": [issue...], "reported": [id...], "blocked": [id...]}, each sorted by record id."""
    62	    before, after = _results(before_dir), _results(after_dir)
    63	    out: dict[str, list] = {"open": [], "reported": [], "blocked": []}
    64	    for rid, a in sorted(after.items()):
    65	        b = before.get(rid)
    66	        if not b or b.get("level", "L0") == "L0":
    67	            continue  # never verified before, or not reachable last time either
    68	        reach = a.get("origin", {}).get("reachability")
    69	        if reach == "blocked":
    70	            out["blocked"].append(rid)
    71	            continue
    72	        if reach != "dead" or a["level"] != "L0":
    73	            continue
    74	        title = TITLE.format(rid)
    75	        if title in open_titles:
    76	            out["reported"].append(rid)
