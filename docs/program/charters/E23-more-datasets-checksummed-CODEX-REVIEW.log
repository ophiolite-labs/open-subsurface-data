   133	        return 1
   134	    rel = str(out.relative_to(paths.RECORDS_DIR))
   135	    todo: dict[str, str] = {}  # field -> its last problem (an enum's choices beat "not a string")
   136	    for p in validate_records(paths.RECORDS_DIR):
   137	        if p.path == rel:
   138	            field, _, why = p.message.partition(": ")
   139	            todo[field] = why
   140	    print(f"wrote {out}; {len(todo)} fields for a human to fill from the publisher's page:")
   141	    for field, why in todo.items():
   142	        print(f"  {field}: {why}")
