   100	def status_lines(vdir: Path = paths.VERIFICATION_DIR, now: datetime | None = None,
   101	                 records_dir: Path = paths.RECORDS_DIR) -> list[str]:
   102	    """The levels `osd build` publishes, read from the same verification directory; an L4 shows
   103	    its coverage beside it, "L4 (2 of 2 converted)" (E09), and a stated expiry of the terms,
   104	    "L1 (terms expire 2027-01-01)" (E19)."""
   105	    rows = []
   106	    for rid, r in load_records(records_dir).items():
   107	        v = build_mod.latest_verification(rid, vdir)
   108	        lv, checked = (v["level"], v["checked_at"]) if v else ("L0", None)
   109	        coverage = conversion_coverage(v)
   110	        lv += f" ({coverage})" if coverage else ""
   111	        terms = terms_note(r, now)
   112	        lv += f" ({terms})" if terms else ""
   113	        when = (checked or "never")[:10] + (" stale" if is_stale(checked, now) else "")
   114	        blocked = (v or {}).get("origin", {}).get("blocked_since")
   115	        when += f" blocked since {blocked[:10]}" if blocked else ""
   116	        rows.append((lv, (f"{rid:36} {when:36} {r['origin']['access']:12} "
   117	                          f"{r['licence']['redistribution']:14} {','.join(r['kinds'])}")))
   118	    w = max([5] + [len(lv) for lv, _ in rows])
   119	    return ([f"{'level':{w}} {'id':36} {'checked':36} {'access':12} {'redistribution':14} kinds"]
   120	            + [f"{lv:{w}} {rest}" for lv, rest in rows])
   121	
