    71	
    72	def inventory(rec: dict, rule: list[str], opener: Opener, budget: ByteBudget,
    73	              known: list[dict] = ()) -> tuple[list[dict], dict | None]:
    74	    """Hash every listing entry the rule selects; files already hashed in this run (`known`, by url)
    75	    are reused. Returns (files, inventory), or ([], None) when the listing cannot be read."""
    76	    listing = rec["origin"].get("manifest_url")
    77	    if not listing:
    78	        return [], None
    79	    robots = _Robots(opener)
    80	    try:
    81	        if not robots.allowed(listing):
    82	            return [], None
    83	        entries = parse_listing(_read(opener(listing), LISTING_BYTES), listing)
    84	    except (FetchError, ValueError):
    85	        return [], None
    86	    selected, seen = [], set()
    87	    for e in entries:
    88	        if e.url not in seen and any(fnmatchcase(e.name, p) or fnmatchcase(e.url, p) for p in rule):
    89	            selected.append(e)
    90	            seen.add(e.url)
    91	    have = {f["url"]: f for f in known if f.get("url")}
    92	    files = []
    93	    for e in selected:
    94	        if e.url in have:
    95	            files.append(dict(have[e.url], path=e.name))
    96	            continue
    97	        if budget.remaining <= 0 or not robots.allowed(e.url):
    98	            continue
    99	        try:
   100	            digest, n = _hash(opener(e.url), budget)
   101	        except (_OverBudget, FetchError):
   102	            continue
   103	        files.append({"path": e.name, "url": e.url, "bytes": n, "sha256": digest})
   104	    complete = len(files) == len(selected) and bool(selected)
   105	    return files, {"rule": list(rule), "listed": len(entries), "selected": [e.name for e in selected],
   106	                   "coverage": "complete" if complete else "partial"}
