# Verifier sampling policy (OSD-D11): tool configuration, never a record field.
# Keyed by record id; the record must declare origin.manifest_url. Each value lists shell globs
# matched against every entry of that listing, as listed or as an absolute URL. Matching files
# are hashed for L2, at most 2 GB per run across all records.
sodir/factpages: ["*rs:Format=CSV*"]          # the CSV export of the exploration wellbore table
opm/norne: ["*.DATA"]                          # the simulation deck
nopims/poseidon: ["*/.zattrs", "*/.zgroup"]    # MDIO metadata objects, a few hundred bytes
nlog/nlog: ["*thematische_data_boringen.zip"]   # the borehole page's thematic data download, ~57 MB

# Mirror rules (E07): the files `osd mirror put` copies, keyed by record id. The verifier hashes every
# entry of the listing a rule selects (its `inventory`), within the same 2 GB run budget in slice 1.
# A record is mirrored only when eligible (OSD-D6; osd.mirror.eligibility). Norne only in slice 1.
mirror:
  opm/norne: ["norne/*"]                       # the five files of the norne/ listing (not INCLUDE/)
