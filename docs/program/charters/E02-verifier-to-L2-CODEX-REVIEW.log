     1	"""Build the published catalogue from records, outlines and verification records.
     2	
     3	Outputs (build/catalog/):
     4	  records.json    every record, joined with its latest verification level
     5	  outlines.geojson one FeatureCollection, every feature joined with record title, kinds,
     6	                   licence and level so the map needs no second lookup
     7	  collections.json STAC-shaped collections, one per record (full STAC validity is E04)
     8	"""
     9	
    10	from __future__ import annotations
    11	
    12	import json
    13	from pathlib import Path
    14	
    15	from . import __version__, paths
    16	from .records import load_outline, load_records
    17	
    18	
    19	def latest_verification(rid: str, vdir: Path = paths.VERIFICATION_DIR) -> dict | None:
    20	    p = vdir / (rid.replace("/", "__") + ".json")
    21	    return json.loads(p.read_text()) if p.exists() else None
    22	
    23	
    24	def build(out_dir: Path = paths.CATALOG_DIR, vdir: Path = paths.VERIFICATION_DIR) -> dict:
    25	    out_dir.mkdir(parents=True, exist_ok=True)
    26	    recs = load_records()
    27	    records_out = []
    28	    features = []
    29	    collections = []
    30	    for rid, rec in recs.items():
    31	        v = latest_verification(rid, vdir)
    32	        level = v["level"] if v else "L0"
    33	        checked = v["checked_at"] if v else None
    34	        joined = dict(rec, level=level, checked_at=checked)
    35	        records_out.append(joined)
    36	        op = paths.outline_path(rid)
    37	        if op.exists():
    38	            for f in load_outline(op)["features"]:
    39	                props = dict(f["properties"])
    40	                props.update({
    41	                    "title": rec["title"], "publisher": rec["publisher"]["name"],
    42	                    "kinds": rec["kinds"], "licence": rec["licence"]["name"],
    43	                    "redistribution": rec["licence"]["redistribution"], "level": level,
    44	                })
    45	                features.append({"type": "Feature", "properties": props, "geometry": f["geometry"]})
    46	        bbox = rec.get("region", {}).get("bbox")
    47	        collections.append({
    48	            "type": "Collection", "stac_version": "1.0.0", "id": rid.replace("/", "--"),
    49	            "title": rec["title"], "description": rec.get("summary", ""),
    50	            "license": rec["licence"].get("spdx") or "proprietary",
    51	            "extent": {"spatial": {"bbox": [bbox] if bbox else []}, "temporal": {"interval": [[None, None]]}},
    52	            "keywords": rec["kinds"],
    53	            "providers": [{"name": rec["publisher"]["name"], "roles": ["producer", "licensor"],
    54	                           "url": rec["publisher"]["url"]}],
    55	            "links": [{"rel": "about", "href": rec["origin"]["url"]},
    56	                      {"rel": "license", "href": rec["licence"].get("url", rec["origin"]["url"])}],
    57	            "osd:level": level, "osd:access": rec["origin"]["access"],
    58	        })
    59	    (out_dir / "records.json").write_text(json.dumps(
    60	        {"tool_version": __version__, "count": len(records_out), "records": records_out}, indent=2) + "\n")
    61	    (out_dir / "outlines.geojson").write_text(json.dumps(
    62	        {"type": "FeatureCollection", "features": features}) + "\n")
    63	    (out_dir / "collections.json").write_text(json.dumps({"collections": collections}, indent=2) + "\n")
    64	    return {"records": len(records_out), "features": len(features), "collections": len(collections)}
