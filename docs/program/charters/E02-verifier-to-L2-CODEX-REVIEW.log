     1	# Network verification. Never a required check: a publisher's outage must not stop merges.
     2	# Pull requests touching records: verify the changed records, comment the levels.
     3	# Dispatch on main: verify (all or some), store the results on the `verification-results`
     4	# branch (OSD-D5: no bucket, no secret), then republish the site so the map shows them.
     5	name: verify
     6	on:
     7	  workflow_dispatch:
     8	    inputs:
     9	      ids: { description: "record ids, space separated (empty = all)", required: false, default: "" }
    10	  pull_request:
    11	    paths: ["records/**", "outlines/**"]
    12	jobs:
    13	  verify:
    14	    runs-on: ubuntu-24.04
    15	    timeout-minutes: 20
    16	    permissions: { contents: write, pull-requests: write, actions: write }
    17	    steps:
    18	      - uses: actions/checkout@v4
    19	        with: { fetch-depth: 0 }
    20	      - uses: astral-sh/setup-uv@v3
    21	        with: { python-version: "3.12" }
    22	      - run: uv sync
    23	      - name: earlier results (so a partial run keeps the others)
    24	        run: |
    25	          if git ls-remote --exit-code origin verification-results >/dev/null; then
    26	            git fetch -q origin verification-results
    27	            mkdir -p build/verification
    28	            git archive origin/verification-results | tar -x -C build/verification
    29	          fi
    30	      - name: pick ids
    31	        id: ids
    32	        run: |
    33	          if [ "${{ github.event_name }}" = "pull_request" ]; then
    34	            ids=$(git diff --name-only origin/${{ github.base_ref }}...HEAD -- records | sed -n 's|^records/\(.*\)\.yaml$|\1|p' | grep -v '^_' | tr '\n' ' ')
    35	          else
    36	            ids="${{ inputs.ids }}"
    37	          fi
    38	          echo "ids=$ids" >> "$GITHUB_OUTPUT"
    39	      - run: uv run osd verify ${{ steps.ids.outputs.ids }} | tee verify.txt
    40	      - uses: actions/upload-artifact@v4
    41	        with: { name: verification, path: build/verification }
    42	      - name: comment on the pull request
    43	        if: github.event_name == 'pull_request'
    44	        env: { GH_TOKEN: "${{ github.token }}" }
    45	        run: |
    46	          { echo '### Verification'; echo '```'; cat verify.txt; echo '```'; } > body.md
    47	          gh pr comment ${{ github.event.pull_request.number }} --body-file body.md || true
    48	      - name: store results and republish
    49	        if: github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main'
