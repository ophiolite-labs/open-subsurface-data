    35	
    36	
    37	def cmd_status(_: argparse.Namespace) -> int:
    38	    recs = load_records()
    39	    print(f"{'level':5} {'id':28} {'access':12} {'redistribution':14} kinds")
    40	    for rid, r in recs.items():
    41	        v = build_mod.latest_verification(rid)
    42	        lv = v["level"] if v else "L0"
    43	        print(f"{lv:5} {rid:28} {r['origin']['access']:12} {r['licence']['redistribution']:14} "
    44	              f"{','.join(r['kinds'])}")
    45	    return 0
    46	
    47	
    48	def main(argv: list[str] | None = None) -> int:
    49	    ap = argparse.ArgumentParser(prog="osd", description=__doc__)
    50	    sub = ap.add_subparsers(dest="cmd", required=True)
    51	    sub.add_parser("validate", help="records and outlines against their schemas").set_defaults(fn=cmd_validate)
    52	    pv = sub.add_parser("verify", help="network: reach each origin, write verification records")
    53	    pv.add_argument("ids", nargs="*")
    54	    pv.set_defaults(fn=cmd_verify)
    55	    sub.add_parser("build", help="write build/catalog").set_defaults(fn=cmd_build)
    56	    sub.add_parser("status", help="one line per record").set_defaults(fn=cmd_status)
    57	    a = ap.parse_args(argv)
    58	    return a.fn(a)
    59	
    60	
    61	if __name__ == "__main__":
    62	    sys.exit(main())
