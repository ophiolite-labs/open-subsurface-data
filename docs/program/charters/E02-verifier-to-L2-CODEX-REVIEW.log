    42	def test_level_ladder_has_no_gaps():
    43	    # L2 passing cannot lift the level over a failed L1
    44	    checks = [{"name": "a", "level": "L1", "outcome": "fail"},
    45	              {"name": "b", "level": "L2", "outcome": "pass"}]
    46	    assert level_from_checks(checks) == "L0"
    47	    checks[0]["outcome"] = "pass"
    48	    assert level_from_checks(checks) == "L2"
    49	    # a skipped check at a level stops the ladder there
    50	    checks.append({"name": "c", "level": "L3", "outcome": "skip"})
    51	    assert level_from_checks(checks) == "L2"
