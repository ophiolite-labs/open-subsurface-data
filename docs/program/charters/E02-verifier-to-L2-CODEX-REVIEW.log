    40	def http_fetch(url: str, timeout: float = 20.0) -> Fetched:
    41	    """GET with a small read; HEAD is refused by too many publishers to be useful."""
    42	    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Range": "bytes=0-0"})
    43	    t0 = time.monotonic()
    44	    try:
    45	        with urllib.request.urlopen(req, timeout=timeout) as resp:
    46	            return Fetched(
    47	                resp.status, resp.geturl(), resp.headers.get("Content-Type", ""),
    48	                int((time.monotonic() - t0) * 1000),
    49	            )
    50	    except urllib.error.HTTPError as e:
    51	        return Fetched(e.code, url, "", int((time.monotonic() - t0) * 1000))
    52	    except (urllib.error.URLError, TimeoutError, OSError) as e:
    53	        return Fetched(0, url, str(e)[:120], int((time.monotonic() - t0) * 1000))
