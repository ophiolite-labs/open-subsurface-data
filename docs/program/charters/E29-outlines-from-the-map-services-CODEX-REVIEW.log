   129	def _arcgis(d, base):
   130	    if not (isinstance(d, dict) and d.get("type") in ("Feature Layer", "Table")
   131	            and isinstance(d.get("maxRecordCount"), int) and isinstance(d.get("fields"), list)):
   132	        return None
   133	    u = urlsplit(base)
   134	    layer = f"{u.scheme}://{u.netloc}{u.path}"
   135	    edited = (d.get("editingInfo") or {}).get("lastEditDate")
   136	    return Listing("arcgis-layer", [_arcgis_export(layer, d["maxRecordCount"])], _date(edited, 1000))
