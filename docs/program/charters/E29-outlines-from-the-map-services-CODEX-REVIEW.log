   140	def write_catalog(out_dir: Path, records: list[dict], vdir: Path = paths.VERIFICATION_DIR,
   141	                  outlines_dir: Path = paths.OUTLINES_DIR, mirror_index: list[dict] | None = None) -> list[dict]:
   142	    """Write out_dir/stac/ from the joined records (record fields plus level, checked_at,
   143	    blocked_since as build() joins them) and return the Collections. `mirror_index` is the public
   144	    index of copies the mirror holds (osd.mirror.public_index). A duplicate feature_id
   145	    anywhere in the outlines fails the build: it is the key Items and the map share."""
   146	    root = out_dir / "stac"
   147	    shutil.rmtree(root, ignore_errors=True)
   148	    root.mkdir(parents=True, exist_ok=True)
   149	    seen: set[str] = set()
   150	    collections, children = [], []
   151	    for rec in records:
   152	        rid, cid = rec["id"], collection_id(rec["id"])
   153	        op = outlines_dir / (rid.replace("/", "__") + ".geojson")
   154	        fc = load_outline(op) if op.exists() else {"features": []}
   155	        for f in fc["features"]:
   156	            fid = f["properties"].get("feature_id")
   157	            if fid in seen:
   158	                raise ValueError(f"duplicate feature_id '{fid}'")
   159	            if fid:
   160	                seen.add(fid)
   161	        when = interval(rec)
   162	        items = []
   163	        if rec.get("period"):
   164	            items = [_item(rec, cid, f, fc.get("inputs", {}), when)
   165	                     for f in fc["features"] if f["properties"].get("feature_id")]
   166	        names: dict[str, str] = {}
   167	        for it in items:
   168	            n = item_file_name(it["id"])
   169	            if n in names:
   170	                raise ValueError(f"{rid}: item file {n} for both '{names[n]}' and '{it['id']}'")
   171	            names[n] = it["id"]
   172	        vp = vdir / (rid.replace("/", "__") + ".json")
   173	        mirrored = {c["sha256"]: c["href"] for c in mirror_index or [] if c["record_id"] == rid}
   174	        assets = _assets(json.loads(vp.read_text()) if vp.exists() else None, mirrored)
   175	        alternate = any("alternate" in a for a in assets.values())
   176	        lic = rec["licence"]
   177	        spatial = (rec.get("region", {}).get("bbox")
   178	                   or _union([bbox(f["geometry"]) for f in fc["features"] if f.get("geometry")])
   179	                   or WORLD)
   180	        col = {
   181	            "type": "Collection", "stac_version": STAC_VERSION,
   182	            "stac_extensions": [OSD_EXTENSION] + ([FILE_EXTENSION] if assets else [])
   183	                               + ([ALTERNATE_EXTENSION] if alternate else []),
   184	            "id": cid, "title": rec["title"], "description": rec.get("summary") or rec["title"],
   185	            "license": lic.get("spdx") or "other",
   186	            "keywords": rec["kinds"],
   187	            "providers": [{"name": rec["publisher"]["name"], "roles": ["producer", "licensor"],
   188	                           "url": rec["publisher"]["url"]}],
   189	            "extent": {"spatial": {"bbox": [spatial]}, "temporal": {"interval": [when]}},
   190	            "links": [{"rel": "root", "href": "../catalog.json", "type": "application/json"},
   191	                      {"rel": "parent", "href": "../catalog.json", "type": "application/json"},
   192	                      {"rel": "about", "href": rec["origin"]["url"], "title": "Publisher's page"},
   193	                      {"rel": "license", "href": lic.get("url", rec["origin"]["url"]),
   194	                       "title": lic["name"]}]
   195	                     + [{"rel": "item", "href": f"./items/{n}", "type": "application/geo+json"}
   196	                        for n in names],
   197	            "osd:level": rec["level"], "osd:checked_at": rec["checked_at"],
   198	            "osd:access": rec["origin"]["access"], "osd:redistribution": lic["redistribution"],
   199	        }
   200	        if rec.get("blocked_since"):
   201	            col["osd:blocked_since"] = rec["blocked_since"]
   202	        if assets:
   203	            col["assets"] = assets
   204	        d = root / cid
   205	        (d / "items" if items else d).mkdir(parents=True, exist_ok=True)
   206	        (d / "collection.json").write_text(json.dumps(col, indent=2) + "\n")
   207	        for n, it in zip(names, items):
   208	            (d / "items" / n).write_text(json.dumps(it) + "\n")
   209	        collections.append(col)
   210	        children.append({"rel": "child", "href": f"./{cid}/collection.json",
   211	                         "type": "application/json", "title": rec["title"]})
   212	    catalog = {
   213	        "type": "Catalog", "stac_version": STAC_VERSION, "id": "open-subsurface-data",
   214	        "title": "Open Subsurface Data",
   215	        "description": "Open subsurface datasets as their publishers state them, one Collection per "
   216	                       "record, with the level our tools verified.",
   217	        "links": [{"rel": "root", "href": "./catalog.json", "type": "application/json"}] + children,
   218	    }
   219	    (root / "catalog.json").write_text(json.dumps(catalog, indent=2) + "\n")
   220	    return collections
