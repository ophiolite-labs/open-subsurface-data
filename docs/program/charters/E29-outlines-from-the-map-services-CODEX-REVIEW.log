   191	    decimals = rules[rid].get("polygon_decimals", defaults.get("polygon_decimals", POLYGON_DECIMALS))
   192	    exteriors = set(rules[rid].get("exteriors_only") or [])
   193	    for i in _inputs_with_rules(rec, rules):
   194	        rule = rules[rid]["inputs"][i["name"]]
   195	        parts = read_parts(_dir(inputs_dir, rid, i["name"]))
   196	        used[i["name"]] = {"url": i["url"], "sha256": input_sha256(parts)}
   197	        if rule.get("period_fields"):  # outline/3: the service properties the dates were read from
   198	            used[i["name"]]["period_fields"] = dict(rule["period_fields"])
   199	        for f in EXTRACTORS[rule["extractor"]](i, rule, parts):
   200	            g = f.pop("geometry")
   201	            key = f.get("publisher_id") or f.get("uwi") or i["name"]
   202	            if rule.get("id_scope"):  # a publisher numbering several registers from one sequence
   203	                key = f"{rule['id_scope']}/{key}"
   204	            if g is None:  # the register lists it without a position (rule unplaced: report)
   205	                unplaced.append(f"{rid}#{key}")
   206	                continue
   207	            how = ""
   208	            if g["type"] in ("Polygon", "MultiPolygon"):  # OSD-D16; points stay exact
