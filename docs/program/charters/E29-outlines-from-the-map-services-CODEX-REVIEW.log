   123	    period, source = item_period(p, when)
   124	    props = {"title": p["name"], "datetime": None, "start_datetime": period[0], "end_datetime": period[1],
   125	             "osd:period_source": source, "osd:approximate": p["approximate"], "osd:derivation": p["source"]}
   126	    sha = inputs.get(p.get("input"), {}).get("sha256")
