   130	        "type": "Feature", "stac_version": STAC_VERSION, "stac_extensions": [OSD_EXTENSION],
   131	        "id": p["feature_id"], "collection": cid, "geometry": feature["geometry"],
   132	        "bbox": bbox(feature["geometry"]), "properties": props,
   133	        "links": [{"rel": "root", "href": "../../catalog.json", "type": "application/json"},
   134	                  {"rel": "parent", "href": "../collection.json", "type": "application/json"},
   135	                  {"rel": "collection", "href": "../collection.json", "type": "application/json"}],
   136	        "assets": {},
   137	    }
