   210	                g, f["rings_dropped"] = simplify(g, tolerance, ext, decimals)
   211	                f["simplified_m"] = tolerance
   212	                how = f", simplified {tolerance} m{', exterior only' if ext else ''}, {decimals} decimals"
   213	            bad = geometry_problems(g)
   214	            if bad:
   215	                raise Refused(f"{i['name']}: {f.get('publisher_id') or f['name']}: {bad[0]}")
   216	            props = {"record_id": rid, "kind": f.pop("kind"), "name": f.pop("name"), "approximate": False,
   217	                     "source": f"{rule['extractor']} ({i['name']}){how}", **f, "feature_id": f"{rid}#{key}",
   218	                     "input": i["name"]}
   219	            feats.append({"type": "Feature", "properties": props, "geometry": g})
   220	    dup = [k for k, n in Counter([f["properties"]["feature_id"] for f in feats] + unplaced).items() if n > 1]
   221	    if dup:
