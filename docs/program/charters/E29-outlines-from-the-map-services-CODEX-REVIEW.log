   109	def item_period(props: dict, collection: list) -> tuple[list, str]:
   110	    """(interval, osd:period_source) of one outline feature in a Collection with that interval:
   111	    the feature's own normalised start and end when both are there in order; its start and the
   112	    Collection's end when it states no usable end and starts by then; otherwise the Collection's."""
   113	    start, end = props.get("osd:period_start"), props.get("osd:period_end")
   114	    if start and end and start <= end:
   115	        return [start, end], "feature"
   116	    if start and not end and collection[1] and start <= collection[1]:
   117	        return [start, collection[1]], "feature-start,collection-end"
   118	    return list(collection), "collection"
