   123	def _arcgis_export(layer_url: str, max_records: int) -> Entry:
   124	    url = (f"{layer_url.rstrip('/')}/query?where=1%3D1&outFields=*&f=geojson"
   125	           f"&resultRecordCount={max_records}")
   126	    return Entry(f"query export (geojson, at most {max_records} features)", url, generated=True)
   127	
