   135	NAN_POSITION = re.compile(rb"\[\s*nan\s*,\s*nan\s*\]")
   136	EMPTY_GEOMETRY = re.compile(rb'\{"type":"(\w+)",\}')
   137	
   138	
   139	def geojson_page(b: bytes) -> dict:
   140	    """A GeoJSON page. FactMaps writes two things that are not JSON: `[nan,nan]` for a wellbore
   141	    without a position and `{"type":"MultiPolygon",}` for a survey without an area; both read as
   142	    a geometry without coordinates (the rule decides: unplaced: report, or refuse)."""
   143	    return json.loads(EMPTY_GEOMETRY.sub(rb'{"type":"\1","coordinates":null}', NAN_POSITION.sub(b"null", b)))
