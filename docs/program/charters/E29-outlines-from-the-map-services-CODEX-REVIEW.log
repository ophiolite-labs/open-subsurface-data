    95	def _assets(verification: dict | None, mirrored: dict[str, str] | None = None) -> dict:
    96	    """E02's checksummed files that carry a fetch address; collection-level, since which Item a
    97	    file belongs to is not established. A file the mirror holds (E07, by sha256) keeps one logical
    98	    asset and one checksum and gains the mirror as an alternate location."""
    99	    out = {}
   100	    for f in (verification or {}).get("files", []):
   101	        if f.get("url"):
   102	            out[f["path"]] = {"href": f["url"], "title": f["path"], "roles": ["data"],
   103	                              "file:size": f["bytes"], "file:checksum": "1220" + f["sha256"]}
   104	            if f["sha256"] in (mirrored or {}):
   105	                out[f["path"]]["alternate"] = {"mirror": {"href": mirrored[f["sha256"]], "title": MIRROR_TITLE}}
   106	    return out
