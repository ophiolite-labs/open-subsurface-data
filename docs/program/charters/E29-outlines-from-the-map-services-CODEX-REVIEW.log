   161	def register_csv(rec_input: dict, rule: dict, parts: list[tuple[str, bytes]]) -> list[dict]:
   162	    """A register table with one row per wellbore and its coordinate columns named in the rule."""
   163	    text = parts[0][1].decode(rule.get("encoding", "utf-8-sig"))
   164	    rows = list(csv.DictReader(io.StringIO(text), delimiter=rule.get("delimiter", ",")))
   165	    if not rows:
   166	        raise Refused(f"{rec_input['name']}: empty response")
   167	    feats = []
   168	    for i, row in enumerate(rows):
   169	        try:
   170	            x, y = float(row[rule["x"]]), float(row[rule["y"]])
   171	        except (KeyError, TypeError, ValueError):
   172	            raise Refused(f"{rec_input['name']}: row {i + 1} has no {rule['x']}/{rule['y']} coordinate") from None
   173	        feats.append({"type": "Feature", "properties": row, "geometry": {"type": "Point", "coordinates": [x, y]}})
   174	    return _features(rec_input, rule, [{"features": feats}])
