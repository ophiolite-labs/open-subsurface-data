     1	# Outline extraction rules (OSD-D11): tool configuration, never a record field.
     2	# Keyed by record id, then by the name of an input the record declares. min_features is the
     3	# count the last reviewed run produced; outline-derived fails below it (a shrinking register is
     4	# a finding). Record ids absent here keep their placeholder outline and are reported in E03.
     5	#
     6	# register-wfs: id/uwi/name are property names; kind is a literal or {field, map, default};
     7	#   keep filters features by property; params are added to every page request; hits: true
     8	#   compares the service's numberMatched with the features served; id_scope prefixes the
     9	#   feature_id (<record-id>#<scope>/<id>) where one record holds registers with overlapping ids.
    10	# segy-hull: x_byte/y_byte/scalar_byte (SEG-Y, 1-based) or x_field/y_field/scalar_field (MDIO).
    11	# publisher-file: GeoJSON, or the locn:geometry extent of a publisher's page.
    12	# simplify_m (default 50): Douglas-Peucker tolerance for derived polygons, recorded as
    13	#   simplified_m on each; rings below simplify_m² are dropped; polygon_decimals (default 5) rounds
    14	#   polygon positions; exteriors_only lists kinds written without holes; rings dropped are counted
    15	#   in rings_dropped, and the rules applied are named in the feature's source (OSD-D16 amended,
    16	#   answers E03-2, E03-3). Per record, over `defaults`. Points are never moved. unplaced: report lists features
    17	#   the register serves without a position in the file's "unplaced" member instead of refusing.
    18	# period_fields {start, end} (E18): the service properties holding the feature's own dates, also
    19	#   named in params.propertyName; period_format the string form the service writes (iso, the
    20	#   default, or m/d/y for M/D/YYYY[ h:mm:ss AM|PM]); period_placeholders values that mean "no
    21	#   date". An input without period_fields keeps its record's period on every Item. Field names
    22	#   confirmed on the live services 23 Oct 2026: docs/program/evidence/e18/fields.md.
    23	
    24	defaults:
    25	  simplify_m: 50
    26	  polygon_decimals: 5
    27	
    28	sodir/factpages:
    29	  exteriors_only: [survey-2d]   # a 2D survey's holes are artefacts of buffering its line network
    30	  min_features: 11210   # 23 Oct 2026: 9805 wellbores + 1405 surveys drawn; 2589 listed unplaced
    31	  inputs:
    32	    wellbores:
    33	      extractor: register-wfs
    34	      kind: wellbore
    35	      id: NPDID_wellbore
    36	      id_scope: wellbore   # NPDIDs of wellbores and surveys overlap (wellbore 2000, survey 2000)
    37	      name: Wellbore_name
    38	      unplaced: report   # FactMaps serves [nan,nan] for wellbores without a position
    39	      period_fields: {start: Entered_date, end: Completed_date}
    40	      period_format: m/d/y   # xsd:dateTime written as 2/15/1983 in the GeoJSON
    41	      page_size: 1000
    42	      params: {outputFormat: GEOJSON, propertyName: "Wellbore_name,NPDID_wellbore,Entered_date,Completed_date,SHAPE"}
    43	    seismic-finished: &sodir-seismic
    44	      extractor: register-wfs
    45	      kind: {field: Sub_type, map: {"2D": survey-2d}, default: survey-3d}
    46	      id: NPDID_for_survey
    47	      id_scope: survey
    48	      name: Survey_name
    49	      keep: {Net_or_gross: net}   # every survey has one net area; 634 also have a gross area incl. turns
    50	      unplaced: report            # FactMaps serves {"type":"MultiPolygon",} for old surveys without an area
    51	      period_fields: {start: Start_date, end: Completed_date}   # not the ___planned dates
    52	      period_format: m/d/y        # 5/1/2021 2:19:33 PM
