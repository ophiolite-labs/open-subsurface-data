   146	def register_wfs(rec_input: dict, rule: dict, parts: list[tuple[str, bytes]]) -> list[dict]:
   147	    """GeoJSON pages of a WFS GetFeature; a stored hit count must equal the features served."""
   148	    pages = [geojson_page(b) for n, b in parts if n.startswith("page-")]
   149	    served = sum(len(p.get("features") or []) for p in pages)
   150	    hits = dict(parts).get("hits")
   151	    if hits is not None:
   152	        m = re.search(rb'numberMatched="(\d+)"', hits)
   153	        if m and int(m.group(1)) != served:
   154	            raise Refused(f"{rec_input['name']}: the service counts {int(m.group(1))} features, the pages "
   155	                          f"served {served}")
   156	    if not served:
   157	        raise Refused(f"{rec_input['name']}: empty response")
   158	    return _features(rec_input, rule, pages)
   159	
