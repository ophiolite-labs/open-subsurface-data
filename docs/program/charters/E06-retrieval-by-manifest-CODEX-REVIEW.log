   400	def check_licence(rec: dict, opener: Opener, previous: dict | None) -> tuple[dict, str | None, str | None]:
   401	    def check(outcome: str, detail: str) -> dict:
   402	        return {"name": "licence-text-captured", "level": "L2", "outcome": outcome, "detail": detail[:500]}
   403	
   404	    url = rec["licence"].get("url")
   405	    if not url:
   406	        return check("skip", "no licence.url"), None, None
   407	    try:
   408	        body = _read(opener(url), LICENCE_BYTES)
   409	    except FetchError as e:
   410	        return check("fail", f"blocked from this runner ({e})" if e.status in (403, 429) else str(e)), None, None
   411	    if _challenge(body):
   412	        return check("fail", f"blocked from this runner (challenge page at {url})"), None, None
   413	    text = licence_text(body)[:LICENCE_TEXT_CHARS]
   414	    if not text:
   415	        return check("fail", f"no text at {url}"), None, None
   416	    sha = hashlib.sha256(text.encode()).hexdigest()
   417	    before = (previous or {}).get("licence_text_sha256")
   418	    if before and before != sha:
   419	        return check("pass", f"licence text changed since {previous['checked_at'][:10]}"), sha, text
   420	    return check("pass", f"{len(text)} characters captured from {url}"), sha, text
