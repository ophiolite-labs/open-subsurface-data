   109	        "type": "Feature", "stac_version": STAC_VERSION, "stac_extensions": [OSD_EXTENSION],
   110	        "id": p["feature_id"], "collection": cid, "geometry": feature["geometry"],
   111	        "bbox": bbox(feature["geometry"]), "properties": props,
   112	        "links": [{"rel": "root", "href": "../../catalog.json", "type": "application/json"},
   113	                  {"rel": "parent", "href": "../collection.json", "type": "application/json"},
   114	                  {"rel": "collection", "href": "../collection.json", "type": "application/json"}],
   115	        "assets": {},
   116	    }
