   390	def licence_text(body: bytes) -> str:
   391	    """The visible text, whitespace collapsed: markup and script churn is not a licence change."""
   392	    text = body.decode("utf-8", "replace")
   393	    if re.match(r"\s*(<!doctype|<html|<\?xml|<head|<body)", text, re.IGNORECASE):
   394	        p = _Text()
   395	        p.feed(text)
   396	        text = " ".join(p.parts)
   397	    return " ".join(text.split())
