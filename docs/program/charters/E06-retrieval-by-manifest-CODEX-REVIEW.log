    49	def _instant(date: str, end: bool) -> str:
    50	    """'1993' / '1993-06' / '1993-06-30' to the first (or last) second of it, UTC."""
    51	    parts = [int(x) for x in date.split("-")]
    52	    y, m, d = (parts + [None, None])[:3]
    53	    if end:
    54	        m = m or 12
    55	        d = d or calendar.monthrange(y, m)[1]
    56	        return f"{y:04d}-{m:02d}-{d:02d}T23:59:59Z"
    57	    return f"{y:04d}-{m or 1:02d}-{d or 1:02d}T00:00:00Z"
