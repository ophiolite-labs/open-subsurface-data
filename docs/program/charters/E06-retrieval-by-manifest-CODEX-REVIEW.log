    19	def cmd_validate(_: argparse.Namespace) -> int:
    20	    problems = validate_records() + validate_outlines()
    21	    for p in problems:
    22	        print(f"  {p}")
    23	    n = len(load_records())
    24	    print(f"{n} records, {len(problems)} problems")
    25	    return 1 if problems else 0
    26	
    27	
    28	def cmd_verify(a: argparse.Namespace) -> int:
    29	    results = verify_all(ids=a.ids or None, derive=a.outlines, fetch_inputs=a.outline_inputs)
    30	    for v in results:
    31	        o = v["origin"]
    32	        l2 = "; ".join(f"{c['name']}: {c['outcome']} ({c.get('detail', '')})" for c in v["checks"] if c["level"] == "L2")
    33	        l3 = "; ".join(f"{c['name']}: {c['outcome']} ({c.get('detail', '')})" for c in v["checks"] if c["level"] == "L3")
    34	        print(f"  {v['level']}  {v['record_id']}  (origin {o.get('reachability')} HTTP {o.get('http_status')}; {l2}; {l3})")
    35	    print(f"{len(results)} verified -> {paths.VERIFICATION_DIR}")
    36	    return 0
    37	
    38	
    39	def cmd_build(_: argparse.Namespace) -> int:
    40	    n = build_mod.build()
    41	    print(f"built {n} -> {paths.CATALOG_DIR}")
    42	    return 0
    43	
    44	
    45	def status_lines(vdir: Path = paths.VERIFICATION_DIR, now: datetime | None = None) -> list[str]:
    46	    """The levels `osd build` publishes, read from the same verification directory."""
    47	    lines = [f"{'level':5} {'id':36} {'checked':36} {'access':12} {'redistribution':14} kinds"]
    48	    for rid, r in load_records().items():
    49	        v = build_mod.latest_verification(rid, vdir)
    50	        lv, checked = (v["level"], v["checked_at"]) if v else ("L0", None)
    51	        when = (checked or "never")[:10] + (" stale" if is_stale(checked, now) else "")
    52	        blocked = (v or {}).get("origin", {}).get("blocked_since")
    53	        when += f" blocked since {blocked[:10]}" if blocked else ""
    54	        lines.append(f"{lv:5} {rid:36} {when:36} {r['origin']['access']:12} "
    55	                     f"{r['licence']['redistribution']:14} {','.join(r['kinds'])}")
    56	    return lines
    57	
    58	
    59	def cmd_status(_: argparse.Namespace) -> int:
    60	    print("\n".join(status_lines()))
    61	    return 0
    62	
    63	
    64	def cmd_new(a: argparse.Namespace) -> int:
    65	    try:
    66	        out = new_mod.new_record(a.url, title=a.title, rid=a.id, records_dir=paths.RECORDS_DIR)
    67	    except FileExistsError as e:
    68	        print(f"refused: {e}")
    69	        return 1
    70	    rel = str(out.relative_to(paths.RECORDS_DIR))
    71	    todo: dict[str, str] = {}  # field -> its last problem (an enum's choices beat "not a string")
    72	    for p in validate_records(paths.RECORDS_DIR):
    73	        if p.path == rel:
    74	            field, _, why = p.message.partition(": ")
    75	            todo[field] = why
    76	    print(f"wrote {out}; {len(todo)} fields for a human to fill from the publisher's page:")
    77	    for field, why in todo.items():
    78	        print(f"  {field}: {why}")
    79	    return 0
    80	
    81	
    82	def cmd_report(a: argparse.Namespace) -> int:
    83	    titles = set(Path(a.open_titles).read_text().splitlines()) if a.open_titles else set()
    84	    r = report_mod.dead_reports(Path(a.before), Path(a.after), titles)
    85	    print("\n".join(report_mod.report_lines(r, a.dry_run)))
    86	    if a.out:
    87	        Path(a.out).write_text(json.dumps(r["open"], indent=2) + "\n")
    88	    return 0
    89	
    90	
    91	def main(argv: list[str] | None = None) -> int:
    92	    ap = argparse.ArgumentParser(prog="osd", description=__doc__)
    93	    sub = ap.add_subparsers(dest="cmd", required=True)
    94	    sub.add_parser("validate", help="records and outlines against their schemas").set_defaults(fn=cmd_validate)
    95	    pv = sub.add_parser("verify", help="network: reach each origin, write verification records")
    96	    pv.add_argument("ids", nargs="*")
    97	    pv.add_argument("--outlines", action="store_true",
    98	                    help="also fetch outline inputs and rewrite outlines/ (osd.outlines, E03)")
    99	    pv.add_argument("--outline-inputs", action="store_true",
   100	                    help="also fetch outline inputs and check the committed outlines against them (CI)")
   101	    pv.set_defaults(fn=cmd_verify)
   102	    sub.add_parser("build", help="write build/catalog").set_defaults(fn=cmd_build)
   103	    sub.add_parser("status", help="one line per record").set_defaults(fn=cmd_status)
   104	    pn = sub.add_parser("new", help="scaffold records/<id>.yaml from a dataset page (reads its title)")
   105	    pn.add_argument("url")
   106	    pn.add_argument("--id", help="publisher/dataset (default: from the address)")
   107	    pn.add_argument("--title", help="skip reading the page")
   108	    pn.set_defaults(fn=cmd_new)
   109	    pr = sub.add_parser("report", help="dead-link report: records that fell from L1+ to a dead origin")
   110	    pr.add_argument("--before", required=True, help="verification results stored before the run")
   111	    pr.add_argument("--after", default=str(paths.VERIFICATION_DIR), help="results after the run")
   112	    pr.add_argument("--open-titles", help="file with the titles of open issues, one per line")
   113	    pr.add_argument("--out", help="write the issues to open as JSON")
   114	    pr.add_argument("--dry-run", action="store_true", help="say 'would open'; the workflow opens nothing")
   115	    pr.set_defaults(fn=cmd_report)
   116	    a = ap.parse_args(argv)
   117	    return a.fn(a)
   118	
   119	
   120	if __name__ == "__main__":
   121	    sys.exit(main())
## E07 Mirror store and custody — QUEUED · Kernel · strategy at lane open · one Codex round

Authority: `DECISIONS.md` OSD-D6 (mirror policy); Ophiolite E35 (custody registry of every copy).

**Outcome.** Small datasets whose licence allows redistribution download from the catalogue at
full speed with a checksum, and every copy we hold has a custody record saying what it is, where
it came from, under which licence, and how to ask for its removal.

**Context today (verified 23 Oct).** Nothing is mirrored. Two Hetzner S3 buckets exist for the
Ophiolite program; none for this project, and its keys must never reach this one. Records carry
`licence.redistribution`; four of nine are `allowed`.

**The design the lane must map to.**
1. Eligibility is a function, tested: `redistribution == allowed` and estimated size under 20 GB
   (OSD-D6) and `origin` reachable at L2 with checksums. Nothing else is ever copied.
2. Layout: `s3://<bucket>/mirror/<record-id>/<sha256-prefix>/<filename>`, public read, no listing.
3. Custody record `build/custody/<record-id>.json`: files, sha256, bytes, copied_at, origin href,
   licence snapshot (name, url, text sha from E02), takedown contact (a repository issue template).
4. STAC assets (E04) gain a second href with `roles: ["mirror"]`; `osd get` prefers the mirror
   when its checksum matches the origin's.
5. Takedown: an issue with the template removes the files and marks the custody record
   `removed_at`; the catalogue keeps the record at its level with `assets` pointing at origin.
6. Cost line in the PR: bytes mirrored and the monthly storage and egress estimate at Hetzner
   prices, by hand.

**Acceptance.**
- Eligibility test: F3 (allowed, 1.3 GB) eligible; Volve (unknown) not; NDR (unknown, TB) not;
  a fixture with `allowed` and 25 GB not.
- Mutation: flipping the size cap to 30 GB makes the 25 GB fixture eligible (shown, restored).
- After mirroring F3: `osd get` for F3 reports every asset `verified` from the mirror href.
- The custody record validates against `schema/custody.schema.json`.
- Takedown dry run on the fixture removes the mirror href and writes `removed_at`.

**Out of scope.** Seismic chunking (E10), anything with `redistribution: unknown` even if the
licence looks permissive.

**Stop rules.** The bucket needs a key in CI: ask the owner for the repository secret (owner
action), continue with a local directory backend meanwhile.

**Ownership and dependencies.** Coding lane; paths `src/osd/mirror.py`, `schema/custody.schema.json`,
`.github/ISSUE_TEMPLATE/takedown.yml`, `tests/test_mirror.py`. Depends on E06 and OSD-D6; the bucket
and its key on E11.

**Evidence to inspect.** The cost line; the custody record for F3; the `osd get` transcript.
## E09 Ophiolite reads the catalogue — QUEUED · Kernel, cross-repo · strategy at lane open · one Codex round

Authority: owner direction 23 Oct ("verified bits … pull into their workspace"); Ophiolite E85
(one intake), E35 (rights-basis), E55 (kind registry), E122 (provenance).

**Outcome.** In an Ophiolite project a person pastes a manifest or STAC collection address into
the intake, the files land through the normal upload run, every landed item carries a
rights-basis filled from the record's licence, and the fidelity record says which files converted
to which canonical type and which did not. That is level L4.

**Context today (verified 23 Oct for this repository; Ophiolite side from program memory, to be
re-verified at lane open).** Ophiolite's E85 intake accepts "an address" as a drop; E35
rights-basis/1 exists on uploads; E57 reads LAS 1.2/3.0 and DLIS; E123 reads ZGY. The Ophiolite
monorepo is private; this repository's reader interface is `osd.manifest.read` (E06). Ophiolite
ships an NLOG sample in its try-it image (E79).

**The design the lane must map to.**
1. Two halves, two repositories, one interface: here, the manifest and STAC are the contract and
   gain nothing Ophiolite-specific; there, an intake address handler recognises `osd.manifest/1`
   and STAC collections.
2. Rights: `licence.{name, spdx, url, statement, share_alike}` map to Ophiolite's rights-basis
   fields; `redistribution: unknown` becomes the rights-basis state that refuses publication
   (E35's refusal state) while allowing private use.
3. Fidelity record: written by the Ophiolite run, exported back as `verification` check
   `canonical-conversion` with detail "<n> of <m> files to <kinds>", so this repository's
   verifier can read it from a file the Ophiolite run publishes (no live coupling).
4. Provenance: each landed item's E122 record names the catalogue item id and the catalogue
   version (git commit of this repository at build time, written into `records.json`).
5. The NLOG sample in E79 and the `nlog/nlog` record agree on kinds and licence text.

**Acceptance.**
- Here: `records.json` carries `catalog_version` (commit); a manifest fixture round-trips through
  `osd.manifest.read` with every licence field intact (test).
- There (Ophiolite journey test): intake of the F3 manifest lands 4 LAS files as wellbore-logs,
  rights-basis shows CC-BY-SA-4.0 with the statement, and a publish attempt of an item from a
  `redistribution: unknown` record is refused with E35's plain-words reason.
- Fidelity: the exported check file validates against `schema/verification.schema.json` and
  `osd status` shows L4 for F3 after `osd verify --fidelity-from <file>`.
- Mutation: removing `statement` from the manifest makes the rights-basis test fail.

**Out of scope.** Workspace references without copying (E12), seismic (E10), any change to
Ophiolite's canonical types.

**Stop rules.** Ophiolite's E85 is not merged at lane open: build the half here, leave the
Ophiolite half as a charter in the Ophiolite queue, mark this epic PARTIAL.

**Ownership and dependencies.** Coding lane here (paths `src/osd/manifest.py`, `src/osd/build.py`,
`src/osd/verify.py`, tests) plus one Ophiolite lane chartered in the Ophiolite program by its
planner. Depends on E06 and Ophiolite E85.

**Evidence to inspect.** The Ophiolite journey test run; the fidelity file; `osd status`.
## E04 STAC catalogue — QUEUED · Kernel · strategy at lane open · Codex round done 23 Oct (REWORK, dispositions below; no second round)

Authority: `docs/ARCHITECTURE.md` ("formats, all standard"); Ophiolite connector doctrine
(SDK or standard, never bespoke); OSD-D14.

**Outcome.** Any STAC client, including the QGIS STAC browser, opens the catalogue by one address
and lists every dataset as a Collection with licence, level, access mode and verification date,
and lists Items for the features whose record declares a period. The catalogue is the
interoperable contract that E06 and E09 read; consuming it in Ophiolite is E09.

**Context today (verified 23 Oct, main e58e2f5).** `build/catalog/collections.json` is a bespoke
wrapper `{"collections": [...]}` whose entries carry `type`, `stac_version`, `id`, `license`,
`extent`, `providers`, `links` and bare `osd:level`/`osd:access` fields (`src/osd/build.py`); no
root catalog, no items, no extension schema, no validation (`osd validate` covers records and
outlines only; `tests/test_build.py` checks one licence string). The builder emits no GeoJSON
`id`; feature identity arrives with E03's `feature_id`. `Makefile` copies `build/catalog/*` flat
into `site/data/`, which Pages publishes.

**The design the lane must map to.**
1. Static STAC 1.0 under `build/catalog/stac/`: `catalog.json` root, one `Collection` per record,
   Items only where OSD-D14 allows (record `period` or a feature date), each Item carrying the
   feature geometry, bbox, `id` = E03's `feature_id`, and `datetime: null` with
   `start_datetime`/`end_datetime` from the period. Collections carry the temporal extent from
   `period` or `[null, null]`.
2. The `osd` extension: schema at `schema/stac-osd.json`, versioned URL mapped to the local file
   for offline validation. Collection-level fields `osd:level`, `osd:checked_at`, `osd:access`,
   `osd:redistribution`, `osd:blocked_since` (record-level assurance, stated as such); Item-level
   `osd:approximate`, `osd:derivation`, `osd:input_sha256`. Enums closed.
3. `license`: the SPDX id when the record has one, else `other` plus a `license` link; `proprietary`
   never appears. A test asserts the mapping for every record.
4. Assets: Collection `links` carry the landing page (`rel: about`) and licence; Collection
   `assets` carry E02's checksummed files (`href`, `file:size`, `file:checksum`), since their
   relation to an individual Item is not established; Items carry no data assets until E06 or E07
   establishes one. Mirror preference stays in E07.
5. Validation offline inside `make check`: `stac-validator` pinned, core and extension schemas
   bundled under `schema/stac/`, schema-map to local files, and a test that runs with network
   access denied (a fetcher that raises).
6. Publication: `Makefile` copies `build/catalog/` recursively; link validation runs over the
   staged `site/data/stac/` tree, the one Pages serves.
7. Identity: `feature_id` is the shared key between `outlines.geojson` features (emitted as
   GeoJSON `id` too) and STAC Items; duplicates fail the build.

**Acceptance.**
- `stac-validator site/data/stac/catalog.json --recursive` passes with the local schema map and
  no network; a mutation that removes one `child` link makes the reachable-set test fail (the test
  asserts the exact reachable collection ids against the record ids).
- Item ids equal the exact set of `feature_id`s of features with a period (fixture with three such
  features and two without); a mutation that drops one Item fails.
- A record with outlines but at L0 yields a collection with its Items and `osd:level: L0`; a record
  with no outlines yields an empty Item list; both asserted in one parametrised test.
- Removing `osd:level` fails validation; setting it to `L9` fails validation; hard-coding every
  level to L0 fails the test that compares collection levels to `records.json`.
- QGIS 3.34 STAC browser opens the staged tree from a local `http.server`, lists collections and
  opens one Item showing licence, level and access (screenshot in the PR).

**Out of scope.** A STAC API, mirrors (E07), manifests (E06), Ophiolite intake (E09), map UI (E05).

**Stop rules.** The STAC extension process requires a registered schema URL: use the repository's
versioned raw URL mapped locally; do not block on registration.

**Ownership and dependencies.** Coding lane; paths `src/osd/stac.py`, `src/osd/build.py`,
`schema/stac-osd.json`, `schema/stac/**` (bundled schemas), `schema/record.schema.json` (optional
`period` only, coordinated with E03's record/2), `pyproject.toml` (stac-validator pinned),
`Makefile` (recursive copy), `tests/test_stac.py`. Depends on E03 (feature ids) and E02 (files).

**Evidence to inspect.** The validator output in CI; the reachable-set and id-set tests; the QGIS
screenshot.

**Dispositions of the Codex round (23 Oct).** Accepted: offline validation with bundled schemas
and a schema map (5), the time contract (OSD-D14, design 1), item eligibility independent of
level (acceptance 3), identity ownership (E03 assigns `feature_id`, E04 emits it in both outputs),
assets at collection level from E02 with no mirror logic, extension semantics by level (2),
recursive publication and staged-tree validation (6), exact-set acceptance tests with named
mutations, licence mapping test, outcome narrowed to publishing the contract (E09 consumes).
Refuted: none.
## E15 Tiles for the registers — QUEUED · Surface · no strategy, no Codex round

Authority: OSD-D16 (register outlines up to 8 MB until a tiling lane); E05 as merged (the page
prefers `data/outlines.pmtiles` when `files.txt` lists it); `docs/ARCHITECTURE.md` (PMTiles).

**Outcome.** Opening the map on a phone connection no longer downloads the register outlines whole:
the page loads tiles for the viewport, and every feature still carries the same properties and
`feature_id` as `outlines.geojson`.

**Context today (verified 23 Oct, main after PR #7).** `outlines/sodir__factpages.geojson` is
4.3 MB and `outlines/nlog__nlog.geojson` 2.6 MB; `make build` concatenates all outlines into
`build/catalog/outlines.geojson`, which the page fetches whole. E05 added the `pmtiles` protocol
and the `files.txt` probe but nothing writes a PMTiles file. `tippecanoe` is not installed in CI.

**The design the lane must map to.**
1. `make build` writes `build/catalog/outlines.pmtiles` from `outlines.geojson` with `tippecanoe`
   (pinned version, installed in the `check` workflow from the official release or a pinned apt
   package; the build skips tiling with a visible notice when the binary is absent, so `make check`
   stays offline-capable locally). Zoom range 0 to 12, point features kept at every zoom with
   clustering left to the page, polygons simplified by tippecanoe only below zoom 8.
2. The page uses the tiles for the extents, surveys and wells layers when present and falls back to
   the GeoJSON otherwise; the list, search and detail panel keep reading `records.json` and
   `outlines.geojson` metadata (ids and names), not the tiles.
3. `feature_id` is the tile feature id; a Playwright test opens `#q=sodir`, clicks a wellbore and
   gets the same detail title as the GeoJSON path.

**Acceptance.**
- With tiles present, the page's network log on load shows no request for `outlines.geojson`
  larger than the metadata fetch (Playwright, offline, asserts the transferred bytes under 1 MB
  before any pan).
- The 10,000-wellbore performance test from E05 passes unchanged on the tile path.
- Tile feature count per layer equals the GeoJSON feature count at the maximum zoom (test using
  the `pmtiles` CLI or a Python reader).
- `make check` without `tippecanoe` prints the notice and passes.

**Out of scope.** Changes to outline files or schemas; STAC (E04).

**Ownership and dependencies.** Coding lane; paths `Makefile` (build target), `src/osd/build.py`
(tiling call only), `.github/workflows/ci.yml` and `pages.yml` (tippecanoe install step, announced),
`site/app.js`, `tests/site/**`, `tests/test_build.py` (tile count test). Depends on E03 (merged).
Runs in parallel with E04 (disjoint paths except `src/osd/build.py`: E15 adds one call at the end of
`build()`; E04 adds `stac.py` and one call; the second to merge rebases).

**Evidence to inspect.** The network-log assertion; the count test; a phone screenshot.
## E16 Periods from the publishers — QUEUED · Records · no strategy, no Codex round

Authority: OSD-D14 (STAC Items need a datetime or a bounded interval; Items only where a record
declares a `period`); E04 as merged (record/2 optional `period`).

**Outcome.** A STAC client lists Items, not only Collections: every record whose publisher states
an acquisition, drilling or release period carries it, quoted as the publisher states it, and the
published catalogue has Items for every outlined feature of those records.

**Context today (after E04 merges).** 68 records, none with `period`; the STAC tree has 68
Collections and 0 Items. `period` is `{start, end}` strings (ISO dates or years as the publisher
states them; `records.py` coerces unquoted YAML dates and ints). Outlined records: Sodir, NLOG,
Poseidon, Parihaka, Kerry 3D (derived); F3, Teapot Dome (placeholders).

**The design the lane must map to.**
1. One `period` per record, from the publisher's own page or register (survey year, drilling
   years, release date), with `stated` text in `notes` or the record's existing field where short;
   never inferred from a file name or from another aggregator.
2. Registers (Sodir, NLOG) get the register's own coverage period as the publisher states it
   (first wellbore year to today, or the register's stated range); per-feature dates are E03's
   business, not this lane's.
3. Target: every record whose publisher states a period, expected at least forty of 68; the PR
   lists the records without a stated period and why.

**Acceptance.**
- `uv run osd validate`: 68 records, 0 problems; every `period` has `start <= end` (existing test).
- `make build` then a count: Items emitted for every outlined record with a period; the PR shows
  the Item count per collection for the five derived-outline records.
- The verify comment on the PR shows no level change (periods do not touch levels).
- Hand count in the PR: records with a period, records without, by reason.

**Out of scope.** Schema changes, outlines, levels.

**Ownership and dependencies.** Records lane; paths `records/**`, `docs/program/evidence/e16/**`.
Depends on E04 (merged).

**Evidence to inspect.** The Item counts; the verify comment; a QGIS Item screenshot (owner, with
action 102).

