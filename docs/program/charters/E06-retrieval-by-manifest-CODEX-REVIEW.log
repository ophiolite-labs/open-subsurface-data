   188	        "type": "Catalog", "stac_version": STAC_VERSION, "id": "open-subsurface-data",
   189	        "title": "Open Subsurface Data",
   190	        "description": "Open subsurface datasets as their publishers state them, one Collection per "
   191	                       "record, with the level our tools verified.",
   192	        "links": [{"rel": "root", "href": "./catalog.json", "type": "application/json"}] + children,
