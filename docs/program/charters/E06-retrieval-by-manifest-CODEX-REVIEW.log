   371	class _Text(HTMLParser):
   372	    SKIP = frozenset({"script", "style", "noscript", "head", "template"})
   373	
   374	    def __init__(self):
   375	        super().__init__()
   376	        self.depth, self.parts = 0, []
   377	
   378	    def handle_starttag(self, tag, attrs):
   379	        self.depth += tag in self.SKIP
   380	
   381	    def handle_endtag(self, tag):
   382	        if tag in self.SKIP and self.depth:
   383	            self.depth -= 1
   384	
   385	    def handle_data(self, data):
   386	        if not self.depth:
   387	            self.parts.append(data)
