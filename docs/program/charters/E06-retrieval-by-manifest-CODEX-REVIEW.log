    60	def interval(rec: dict) -> list:
    61	    p = rec.get("period")
    62	    if not p:
    63	        return [None, None]
    64	    start, end = _instant(p["start"], False), _instant(p["end"], True)
    65	    if end < start:
    66	        raise ValueError(f"{rec['id']}: period ends before it starts ({p['start']} > {p['end']})")
    67	    return [start, end]
