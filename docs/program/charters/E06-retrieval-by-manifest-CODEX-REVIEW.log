    40	def item_file_name(feature_id: str) -> str:
    41	    """The part after '#', path-safe; a lossy name gets a short hash so two ids never collide."""
    42	    local = feature_id.split("#", 1)[1]
    43	    safe = re.sub(r"[^A-Za-z0-9._-]", "_", local).lstrip(".") or "_"
    44	    if safe != local:
    45	        safe += "-" + hashlib.sha256(feature_id.encode()).hexdigest()[:8]
    46	    return safe + ".json"
