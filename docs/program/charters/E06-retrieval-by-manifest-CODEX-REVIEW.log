    90	def _assets(verification: dict | None) -> dict:
    91	    """E02's checksummed files that carry a fetch address; collection-level, since which Item a
    92	    file belongs to is not established."""
    93	    out = {}
    94	    for f in (verification or {}).get("files", []):
    95	        if f.get("url"):
    96	            out[f["path"]] = {"href": f["url"], "title": f["path"], "roles": ["data"],
    97	                              "file:size": f["bytes"], "file:checksum": "1220" + f["sha256"]}
    98	    return out
