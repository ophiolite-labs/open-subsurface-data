   425	def level_from_checks(checks: list[dict]) -> str:
   426	    """The highest level whose every check passed, with no gaps below it."""
   427	    level = "L0"
   428	    for lv in LEVELS[1:]:
   429	        mine = [c for c in checks if c["level"] == lv]
   430	        if not mine or any(c["outcome"] != "pass" for c in mine):
   431	            break
   432	        level = lv
   433	    return level
