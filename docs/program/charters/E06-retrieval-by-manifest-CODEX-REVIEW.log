    95	def http_fetch(url: str, timeout: float = 20.0) -> Fetched:
    96	    """GET the first 16 KB; HEAD is refused by too many publishers to be useful."""
    97	    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT, "Range": f"bytes=0-{PROBE_BYTES - 1}"})
    98	    t0 = time.monotonic()
    99	    ms = lambda: int((time.monotonic() - t0) * 1000)
   100	    try:
   101	        with urllib.request.urlopen(req, timeout=timeout) as resp:
   102	            body = resp.read(PROBE_BYTES)
   103	            return Fetched(resp.status, resp.geturl(), resp.headers.get("Content-Type", ""), ms(), body)
   104	    except urllib.error.HTTPError as e:
   105	        try:
   106	            body = e.read(PROBE_BYTES)
   107	        except OSError:
   108	            body = b""
   109	        return Fetched(e.code, url, e.headers.get("Content-Type", "") if e.headers else "", ms(), body)
   110	    except (urllib.error.URLError, TimeoutError, OSError) as e:
   111	        return Fetched(0, url, "", ms(), error=_error_kind(e))
