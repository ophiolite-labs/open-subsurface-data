   101	def _item(rec: dict, cid: str, feature: dict, inputs: dict, when: list) -> dict:
   102	    p = feature["properties"]
   103	    props = {"title": p["name"], "datetime": None, "start_datetime": when[0], "end_datetime": when[1],
   104	             "osd:approximate": p["approximate"], "osd:derivation": p["source"]}
