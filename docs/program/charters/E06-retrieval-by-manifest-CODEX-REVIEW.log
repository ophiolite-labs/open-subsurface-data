   208	
   209	def _links(path: Path) -> list[dict]:
   210	    return json.loads(path.read_text()).get("links", [])
   211	
   212	
   213	def link_problems(root: Path) -> list[str]:
   214	    """Every relative link in the tree points at a file that exists."""
   215	    out = []
   216	    for p in sorted(root.rglob("*.json")):
   217	        for link in _links(p):
   218	            href = link["href"]
   219	            if "://" not in href and not (p.parent / href).resolve().is_file():
   220	                out.append(f"{p.relative_to(root)}: {link['rel']} -> {href} does not exist")
   221	    return out
   222	
   223	
   224	def reachable(catalog: Path) -> dict[str, set[str]]:
   225	    """Collection and Item ids a client reaches from the root by child and item links."""
   226	    out: dict[str, set[str]] = {"collections": set(), "items": set()}
   227	    todo, seen = [catalog.resolve()], set()
   228	    while todo:
   229	        p = todo.pop()
   230	        if p in seen:
   231	            continue
   232	        seen.add(p)
   233	        doc = json.loads(p.read_text())
   234	        if doc["type"] == "Collection":
   235	            out["collections"].add(doc["id"])
   236	        elif doc["type"] == "Feature":
   237	            out["items"].add(doc["id"])
   238	        todo += [(p.parent / x["href"]).resolve() for x in doc.get("links", [])
   239	                 if x["rel"] in ("child", "item")]
   240	    return out
     1	"""Build the published catalogue from records, outlines and verification records.
     2	
     3	Outputs (build/catalog/):
     4	  records.json    every record, joined with its latest verification level, the date it was
     5	                   established, `stale` when that date is over 30 days old (or absent) and
     6	                   `blocked_since` while the origin refuses this runner (OSD-D9)
     7	  outlines.geojson one FeatureCollection, every feature joined with record title, kinds,
     8	                   licence and level so the map needs no second lookup
     9	  stac/            the static STAC catalogue (src/osd/stac.py)
    10	  collections.json {"collections": [...]}, the same STAC Collections in one file
    11	"""
    12	
    13	from __future__ import annotations
    14	
    15	import json
    16	from datetime import datetime
    17	from pathlib import Path
    18	
    19	from . import __version__, paths, stac
    20	from .records import load_outline, load_records
    21	from .verify import is_stale
    22	
    23	
    24	def latest_verification(rid: str, vdir: Path = paths.VERIFICATION_DIR) -> dict | None:
    25	    p = vdir / (rid.replace("/", "__") + ".json")
    26	    return json.loads(p.read_text()) if p.exists() else None
    27	
    28	
    29	def build(out_dir: Path = paths.CATALOG_DIR, vdir: Path = paths.VERIFICATION_DIR,
    30	          now: datetime | None = None) -> dict:
    31	    out_dir.mkdir(parents=True, exist_ok=True)
    32	    recs = load_records()
    33	    records_out = []
    34	    features = []
    35	    for rid, rec in recs.items():
    36	        v = latest_verification(rid, vdir)
    37	        level = v["level"] if v else "L0"
    38	        checked = v["checked_at"] if v else None
    39	        blocked = (v or {}).get("origin", {}).get("blocked_since")
    40	        joined = dict(rec, level=level, checked_at=checked, stale=is_stale(checked, now), blocked_since=blocked)
    41	        records_out.append(joined)
    42	        op = paths.outline_path(rid)
    43	        if op.exists():
    44	            for f in load_outline(op)["features"]:
    45	                props = dict(f["properties"])
    46	                props.update({
    47	                    "title": rec["title"], "publisher": rec["publisher"]["name"],
    48	                    "kinds": rec["kinds"], "licence": rec["licence"]["name"],
    49	                    "redistribution": rec["licence"]["redistribution"], "level": level,
    50	                })
    51	                fid = {"id": props["feature_id"]} if "feature_id" in props else {}
    52	                features.append({"type": "Feature", **fid, "properties": props, "geometry": f["geometry"]})
    53	    (out_dir / "records.json").write_text(json.dumps(
    54	        {"tool_version": __version__, "count": len(records_out), "records": records_out}, indent=2) + "\n")
    55	    (out_dir / "outlines.geojson").write_text(json.dumps(
    56	        {"type": "FeatureCollection", "features": features}) + "\n")
    57	    collections = stac.write_catalog(out_dir, records_out, vdir)
    58	    (out_dir / "collections.json").write_text(json.dumps({"collections": collections}, indent=2) + "\n")
    59	    return {"records": len(records_out), "features": len(features), "collections": len(collections)}
