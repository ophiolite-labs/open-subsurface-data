   198	def validate(path: Path, recursive: bool = True, schema_config: Path = SCHEMA_MAP) -> tuple[bool, list]:
   199	    """stac-validator over a local file or tree, against the bundled schemas only."""
   200	    from stac_validator.utilities import fetch_and_parse_schema
   201	    from stac_validator.validate import StacValidate
   202	
   203	    fetch_and_parse_schema.cache_clear()   # a schema map change must not reuse a cached schema
   204	    v = StacValidate(str(path), recursive=recursive, schema_config=str(schema_config))
   205	    ok = v.run()
   206	    return ok and all(m.get("valid_stac") for m in v.message), v.message
