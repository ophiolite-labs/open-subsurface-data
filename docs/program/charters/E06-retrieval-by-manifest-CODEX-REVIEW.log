   160	            "license": lic.get("spdx") or "other",
   161	            "keywords": rec["kinds"],
   162	            "providers": [{"name": rec["publisher"]["name"], "roles": ["producer", "licensor"],
   163	                           "url": rec["publisher"]["url"]}],
   164	            "extent": {"spatial": {"bbox": [spatial]}, "temporal": {"interval": [when]}},
   165	            "links": [{"rel": "root", "href": "../catalog.json", "type": "application/json"},
   166	                      {"rel": "parent", "href": "../catalog.json", "type": "application/json"},
   167	                      {"rel": "about", "href": rec["origin"]["url"], "title": "Publisher's page"},
   168	                      {"rel": "license", "href": lic.get("url", rec["origin"]["url"]),
   169	                       "title": lic["name"]}]
   170	                     + [{"rel": "item", "href": f"./items/{n}", "type": "application/geo+json"}
   171	                        for n in names],
   172	            "osd:level": rec["level"], "osd:checked_at": rec["checked_at"],
   173	            "osd:access": rec["origin"]["access"], "osd:redistribution": lic["redistribution"],
   174	        }
   175	        if rec.get("blocked_since"):
   176	            col["osd:blocked_since"] = rec["blocked_since"]
   177	        if assets:
   178	            col["assets"] = assets
   179	        d = root / cid
   180	        (d / "items" if items else d).mkdir(parents=True, exist_ok=True)
   181	        (d / "collection.json").write_text(json.dumps(col, indent=2) + "\n")
   182	        for n, it in zip(names, items):
   183	            (d / "items" / n).write_text(json.dumps(it) + "\n")
   184	        collections.append(col)
   185	        children.append({"rel": "child", "href": f"./{cid}/collection.json",
   186	                         "type": "application/json", "title": rec["title"]})
