    83	def _union(boxes: list[list[float]]) -> list[float] | None:
    84	    if not boxes:
    85	        return None
    86	    return [min(b[0] for b in boxes), min(b[1] for b in boxes),
    87	            max(b[2] for b in boxes), max(b[3] for b in boxes)]
