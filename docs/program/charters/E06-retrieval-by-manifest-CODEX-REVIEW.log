   114	def http_open(url: str, timeout: float = 60.0) -> Iterable[bytes]:
   115	    req = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
   116	    try:
   117	        with urllib.request.urlopen(req, timeout=timeout) as resp:
   118	            while chunk := resp.read(CHUNK):
   119	                yield chunk
   120	    except urllib.error.HTTPError as e:
   121	        raise FetchError(url, e.code) from None
   122	    except (urllib.error.URLError, TimeoutError, OSError) as e:
   123	        raise FetchError(url, 0, _error_kind(e)) from None
