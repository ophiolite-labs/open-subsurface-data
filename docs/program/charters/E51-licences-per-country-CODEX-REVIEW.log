schema/outline.schema.json:5:  "description": "Properties every feature in outlines/<record-id>.geojson carries; $defs.collection is the file's own members. Geometry is WGS84 (EPSG:4326). A feature is one wellbore (Point), one survey or field (Polygon or MultiPolygon) or one line (LineString). Version 2: a derived feature (approximate: false) carries feature_id and the name of its input; the collection carries each input's identity once and the licence once (per feature only where it differs within a file). Version 3: a feature from a register whose rule names period_fields carries the dates the service states for it, raw and normalised, and the collection names those fields per input. Every version-1 placeholder and every version-2 file still validates.",
schema/outline.schema.json:52:    "licence": {
schema/outline.schema.json:54:      "description": "The record's licence when it differs within a file; otherwise the collection's licence applies (OSD-D13)"
schema/outline.schema.json:115:        "licence": {
schema/outline.schema.json:117:          "description": "The licence of the record the features were derived from (OSD-D13)"
schema/verification.schema.json:14:              "description": "L0 listed; L1 origin reachable; L2 files checksummed and licence text captured; L3 outlines extracted by a reader; L4 converted to a canonical type with a fidelity record"},
schema/verification.schema.json:58:    "licence_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
schema/verification.schema.json:59:    "licence_text": {"type": "string", "maxLength": 100000, "description": "v2. The visible licence text the hash was computed over, whitespace collapsed"},
schema/verification.schema.json:74:      "description": "v7 (E40; written by E41). A maintainer deposited the publisher's download (OSD-D22): the files as held in the mirror under custody/2 `deposit`, when, by which role, and the publisher's page and licence text as captured then",
schema/verification.schema.json:75:      "required": ["name", "level", "outcome", "detail", "files", "obtained_at", "by", "publisher_page_sha256", "licence_text_sha256"],
schema/verification.schema.json:96:        "licence_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
schema/record.schema.json:5:  "description": "One dataset as published by its owner. Facts about the dataset, never facts produced by our tools: verification levels, checksums and outlines live in build output, not here. Version 2 adds `inputs` and the optional `period` (E04, additive); every version-1 record is a valid version-2 record. Version 3 (E19, additive) adds the kind `potential-fields`, the access `purchase` and the optional `licence.terms`; every version-2 record is a valid version-3 record. Version 4 (E26, additive) adds the kinds `velocity-model`, `geological-model`, `airborne-em`, `radiometrics` and `stress`; every version-3 record is a valid version-4 record.",
schema/record.schema.json:8:  "required": ["id", "title", "publisher", "origin", "licence", "kinds", "region", "listed_by", "added"],
schema/record.schema.json:22:        "country": {"type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2"}
schema/record.schema.json:35:    "licence": {
schema/record.schema.json:38:        "name": {"type": "string", "description": "The licence as the publisher names it."},
schema/record.schema.json:39:        "spdx": {"type": ["string", "null"], "description": "SPDX identifier when one exists (CC-BY-4.0, CC-BY-SA-4.0, OGL-UK-3.0, NLOD-2.0); null for bespoke licences."},
schema/record.schema.json:44:        "share_alike": {"type": "boolean", "description": "Derived products must carry the same licence (CC BY-SA and kin)."},
schema/record.schema.json:48:          "description": "Record/3. What the publisher's terms say about how long a licence runs and review before publication, as the publisher states it. Never computed: a duration stays the publisher's conditional wording, and `expires` is set only when the publisher states an absolute calendar date. Absent keys are not stated.",
schema/record.schema.json:51:            "duration": {"type": ["string", "null"], "minLength": 1, "description": "The publisher's wording of how long a licence runs, e.g. 'at most 10 years from purchase'; null when the terms state none."},
schema/record.schema.json:72:        "country": {"type": "string", "pattern": "^[A-Z]{2}$"},
schema/custody.schema.json:5:  "description": "One copy the mirror holds: what it is, where it came from, under which licence with which attribution, and how to ask for its removal. Written by `osd mirror put` (a verified download) or by the deposit and derived uploads (E41) beside the object as custody/<sha256>.json before the object becomes public; `osd mirror remove` turns it into the tombstone custody/<sha256>.removed.json. Never written by hand. The build regenerates the public index from these documents. v2 (E40): exactly one provenance: `origin_href` with `verifier_run` (a verified download, as /1), or `origin_href: null` with `deposit` (a maintainer's deposit of the publisher's download) or with `derived` (an artefact a starter-pack recipe made from held inputs). A /1 document keeps the /1 shape.",
schema/custody.schema.json:9:               "licence", "licence_text_sha256", "attribution", "takedown", "removal"],
schema/custody.schema.json:29:      "required": ["obtained_at", "by", "publisher_page_url", "publisher_page_sha256", "licence_text_sha256"],
schema/custody.schema.json:36:        "licence_text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$", "description": "The licence text as captured at deposit"}
schema/custody.schema.json:50:    "licence": {
schema/custody.schema.json:52:      "description": "The licence object, whole: the record's for a verified download or a deposit, the pack's computed licence for a derived artefact (v2 admits record/5 `terms`). Only `allowed` is ever mirrored (OSD-D6)",
schema/custody.schema.json:62:          "type": "object", "additionalProperties": false, "required": ["stated"], "description": "v2. record/5 licence.terms, copied whole",
schema/custody.schema.json:72:    "licence_text_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$",
schema/custody.schema.json:73:                            "description": "The licence text the verifier captured (E02), or null when none was"},
schema/starter.schema.json:5:  "description": "One starter pack of one catalogue record: which held files went in, which decisions were taken for which object, which artefacts came out for which application and version, under the licence computed from the inputs, with the fidelity record of the conversion. Written by the recipe run it names (family rule R-T1, never by hand) and committed as starters/<record id with / as __>__<pack>.json (OSD-D12). `src/osd/starters.py` states what a schema cannot: inputs held, licence computed, decisions complete, artefacts in custody, fidelity covering the inputs, the oracle clean (E40 design 4).",
schema/starter.schema.json:9:               "targets", "licence", "fidelity", "built_at"],
schema/starter.schema.json:124:    "licence": {
schema/starter.schema.json:125:      "$ref": "#/$defs/licence_fields",
schema/starter.schema.json:127:      "description": "The record/5-shaped licence computed from the inputs (family rule R-T4), plus each input's licence object whole",
schema/starter.schema.json:131:          "items": {"type": "object", "additionalProperties": false, "required": ["input", "licence"],
schema/starter.schema.json:133:                                   "licence": {"$ref": "#/$defs/licence"}}}
schema/starter.schema.json:156:    "licence": {"$ref": "#/$defs/licence_fields", "unevaluatedProperties": false},
schema/starter.schema.json:157:    "licence_fields": {
schema/starter.schema.json:159:      "description": "record/5 `licence`",
schema/stac-osd.json:48:          "description": "The record's latest verification level: L0 listed; L1 origin reachable; L2 files checksummed and licence text captured; L3 outlines extracted by a reader; L4 converted with a fidelity record"
