    20	        run: |
    21	          curl -fsSLo /tmp/tippecanoe.deb http://archive.ubuntu.com/ubuntu/pool/universe/t/tippecanoe/tippecanoe_2.79.0-1_amd64.deb
    22	          echo "78261946e0ee8f6cb10c00c4aaf5e66858f0bfb9d870c530d6704fbcc67fb727  /tmp/tippecanoe.deb" | sha256sum -c
    23	          sudo dpkg -i /tmp/tippecanoe.deb && tippecanoe --version
    24	      - run: make check
