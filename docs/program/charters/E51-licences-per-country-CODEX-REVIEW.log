tests/fixtures/listings/datacite-egg.json:1:{"data":{"id":"10.4121/uuid:916c86cd-3558-4672-829a-105c62985ab2","type":"dois","attributes":{"doi":"10.4121/uuid:916c86cd-3558-4672-829a-105c62985ab2","prefix":"10.4121","suffix":"uuid:916c86cd-3558-4672-829a-105c62985ab2","identifiers":[],"alternateIdentifiers":[],"creators":[{"name":"J.D.Jansen","nameType":"Personal","familyName":"J.D.Jansen","nameIdentifiers":[{"nameIdentifier":"0000-0003-2492-6791","nameIdentifierScheme":"https://orcid.org/"}],"affiliation":[]}],"titles":[{"title":"The Egg Model - data files"}],"publisher":"TU Delft","container":{},"publicationYear":2013,"subjects":[{"subject":"Physical Geography and Environmental Geoscience","subjectScheme":"Australian and New Zealand Standard Research Classification (ANZSRC), 2008","classificationCode":"0406"},{"subject":"FOS: Earth and related environmental sciences","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"Geomatic Engineering","subjectScheme":"Australian and New Zealand Standard Research Classification (ANZSRC), 2008","classificationCode":"0909"},{"subject":"FOS: Environmental engineering","schemeUri":"http://www.oecd.org/science/inno/38235147.pdf","subjectScheme":"Fields of Science and Technology (FOS)"},{"subject":"geological realizations"},{"subject":"reservoir simulation"},{"subject":"Time: 2013"}],"contributors":[{"name":"G.M. Van Essen","nameType":"Personal","affiliation":[],"contributorType":"Other","nameIdentifiers":[]},{"name":"M.Siraj","nameType":"Personal","affiliation":[],"contributorType":"Other","nameIdentifiers":[]},{"name":"P.M.J. Van Den Hof","nameType":"Personal","affiliation":[],"contributorType":"Other","nameIdentifiers":[]},{"name":"R.M.Fonseca","nameType":"Personal","affiliation":[],"contributorType":"Other","nameIdentifiers":[]},{"name":"S.Kahrobaei","nameType":"Personal","affiliation":[],"contributorType":"Other","nameIdentifiers":[]},{"name":"TU Delft, Faculty Of Civil Engineering And Geosciences, Department Of Geoscience And Engineering","nameType":"Organizational","affiliation":[],"contributorType":"Other","nameIdentifiers":[]}],"dates":[{"date":"2013-11-12","dateType":"Issued"}],"language":"en","types":{"ris":"DATA","bibtex":"misc","citeproc":"dataset","schemaOrg":"Dataset","resourceType":"Dataset","resourceTypeGeneral":"Dataset"},"relatedIdentifiers":[{"relationType":"References","relatedIdentifier":"http://onlinelibrary.wiley.com/doi/10.1002/gdj3.21/full","relatedIdentifierType":"URL"}],"relatedItems":[],"sizes":[],"formats":["media types: application/octet-stream, application/zip, text/plain"],"version":"1","rightsList":[{"rights":"4TU General Terms of Use","rightsUri":"https://doi.org/10.4121/resource:terms_of_use"}],"descriptions":[{"description":"The \"Egg Model\" is a synthetic reservoir model consisting of an ensemble of 101 relatively small three-dimensional realizations of a channelized reservoir produced under water flooding conditions with eight water injectors and four producers. This data set represents a \"standard version\" of the Egg Model which is meant to serve as a standard test case in future publications. We implemented and tested the model in four reservoir simulators: Dynamo/Mores (Shell), Eclipse (Schlumberger), AD-GPRS (Stanford University) and MRST (Sintef). This data set also contains the input files for the various simulators.","descriptionType":"Abstract"}],"geoLocations":[{"geoLocationPlace":"Netherlands,"}],"fundingReferences":[],"xml":"","url":"https://data.4tu.nl/articles/_/12707642/1","contentUrl":null,"metadataVersion":16,"schemaVersion":"http://datacite.org/schema/kernel-4","source":"mds","isActive":true,"state":"findable","reason":null,"viewCount":14,"viewsOverTime":[{"yearMonth":"2025-03","total":1},{"yearMonth":"2025-03","total":1},{"yearMonth":"2025-04","total":4},{"yearMonth":"2025-04","total":4},{"yearMonth":"2025-05","total":1},{"yearMonth":"2025-05","total":1},{"ye