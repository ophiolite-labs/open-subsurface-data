   174	    if isinstance(i, bool) or not isinstance(i, (str, int, float)):
   175	        raise Refused(f"a feature has no id ({json.dumps(f)[:120]})")
   176	    return isinstance(i, str), i   # strings and numbers never compare
   177	
   178	
   179	def geojson_canonical(features: list[dict], crs=None) -> bytes:
   180	    """The bytes of a whole WFS or OGC API layer: features sorted by id, keys sorted, no whitespace;
   181	    the pages' crs when they state one; page members (counts, links, timestamps, bbox) left out."""
   182	    doc = {"type": "FeatureCollection", "features": sorted(features, key=_fid)}
   183	    if crs is not None:
   184	        doc["crs"] = crs
   185	    return json.dumps(doc, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
   186	
   187	
   188	def _doc(b: bytes, where: str):
   189	    """A JSON answer, or Refused naming the publisher's exception (OWS XML or OGC API JSON)."""
   190	    text = b.decode("utf-8", "replace").lstrip("﻿").lstrip()
   191	    if text.startswith("<"):
   192	        if "ExceptionReport" in text[:2000]:
   193	            code, said = XML_CODE.search(text), XML_EXCEPTION.search(text)
   194	            raise Refused(f"{where} answered an exception: {code.group(1) if code else ''} "
   195	                          f"{html.unescape(said.group(1)) if said else ''}".strip()[:300])
   196	        raise Refused(f"{where} is XML, not GeoJSON: {b[:80]!r}")
   197	    try:
   198	        d = json.loads(text)
   199	    except ValueError:
   200	        raise Refused(f"{where} is not JSON: {b[:80]!r}") from None
   201	    if isinstance(d, dict) and "code" in d and "description" in d and "features" not in d:
   202	        raise Refused(f"{where} answered an exception: {d['code']} {d['description']}"[:300])
   203	    return d
   204	
   205	
   206	class _Pages:
   207	    """Features assembled page by page: every feature with an id, no id twice, one crs."""
   208	
   209	    def __init__(self, what: str):
   210	        self.what, self.features, self.seen, self.crs, self.pages = what, [], set(), None, 0
   211	
   212	    def add(self, page, where: str) -> int:
   213	        feats = page.get("features") if isinstance(page, dict) else None
   214	        if not (isinstance(page, dict) and page.get("type") == "FeatureCollection" and isinstance(feats, list)):
   215	            raise Refused(f"{where} is not a GeoJSON FeatureCollection")
   216	        if self.pages and page.get("crs") != self.crs:
   217	            raise Refused(f"{where} states crs {page.get('crs')!r}, the first page {self.crs!r}")
   218	        self.crs, self.pages = page.get("crs"), self.pages + 1
   219	        for f in feats:
   220	            k = _fid(f)
   221	            if k in self.seen:
   222	                raise Refused(f"{self.what}: feature id {f['id']!r} served twice")
   223	            self.seen.add(k)
   224	            self.features.append(f)
   225	        return len(feats)
   226	
   227	
   228	def _outcome(fmt: str, layer: str, pages: _Pages, count: int | None) -> Outcome:
   229	    if count is not None and len(pages.features) != count:
   230	        raise Refused(f"{pages.what} counts {count} features, the pages served {len(pages.features)}")
   231	    body = geojson_canonical(pages.features, pages.crs)
   232	    entry = {"layer": layer, "format": fmt, "features": len(pages.features), "count": count,
   233	             "completeness": "complete" if count is not None else "unconfirmed", "bytes": len(body),
   234	             "sha256": hashlib.sha256(body).hexdigest()}
   235	    if count is None:
   236	        return Outcome("unconfirmed", "the server states no numberMatched", entry, body)
   237	    return Outcome("complete", UNKNOWN_REVISION[fmt], entry, body)
   238	
   239	
   240	def _evidence(url: str, b: bytes, name: str) -> dict:
   241	    return {"path": name, "url": url, "bytes": len(b), "sha256": hashlib.sha256(b).hexdigest(), "partial": True}
   242	
   243	
   244	def _read(reader: Callable[[], Outcome]) -> Outcome:
   245	    try:
   246	        return reader()
   247	    except Partial as p:
   248	        return Outcome("partial", p.reason, evidence=p.evidence)
   249	    except Refused as e:
   250	        return Outcome("failed", str(e))
   251	    except Incomplete as i:
   252	        return Outcome("failed" if i.outcome == "fail" else "declined", i.reason)
   253	
   254	
   255	def _with(url: str, **params) -> str:
   256	    """`url` with these query parameters set (any case of the same name replaced)."""
   257	    u = urlsplit(url)
   258	    names = {k.lower() for k in params}
   259	    q = [(k, v) for k, v in parse_qsl(u.query, keep_blank_values=True) if k.lower() not in names]
   260	    return urlunsplit(u._replace(query=urlencode(q + [(k, str(v)) for k, v in params.items()])))
   261	
   262	
   263	def _link(doc: dict, rel: str, base: str) -> str | None:
   264	    """The href of `rel` in a document's links, GeoJSON first, then JSON, then an untyped one."""
   265	    links = [x for x in doc.get("links") or [] if isinstance(x, dict) and x.get("rel") == rel
   266	             and isinstance(x.get("href"), str)]
   267	    for want in (*GEOJSON_TYPES, None):
   268	        for x in links:
   269	            if (x.get("type") or None) == want or (want and str(x.get("type", "")).startswith(want)):
   270	                return urljoin(base, x["href"])
   271	    return None
   272	
