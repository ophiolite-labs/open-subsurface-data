   376	def comparable(checksum: dict | None) -> str | None:
   377	    """The hashlib algorithm a stated checksum can be compared with, or None (recorded, not compared)."""
   378	    if not checksum:
   379	        return None
   380	    alg = COMPARABLE.get(re.sub(r"[^a-z0-9]", "", str(checksum.get("algorithm", "")).lower()))
   381	    width = {"md5": 32, "sha1": 40, "sha256": 64}.get(alg or "")
   382	    return alg if width and re.fullmatch(f"[0-9a-fA-F]{{{width}}}", str(checksum.get("digest", ""))) else None
