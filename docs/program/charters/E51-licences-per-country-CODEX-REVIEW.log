   155	            code=$(curl -s -o /dev/null -I -w '%{http_code}' "$href")
   156	            echo "anonymous HEAD $code $href" | tee -a mirror.txt
   157	            [ "$code" = 200 ] || status=1
   158	          done
   159	          code=$(curl -s -o /dev/null -w '%{http_code}' "https://$OSD_S3_BUCKET.${OSD_S3_ENDPOINT#https://}/")
