   143	def published_starters(starters_dir: Path, recs: dict[str, dict], records_out: list[dict], vdir: Path,
   144	                       custody_dir: Path) -> list[dict]:
   145	    """The packs the site shows (E40): valid with every rule checked here, not unpublished; the rest on stderr."""
   146	    import sys
   147	
   148	    ev = starters.Evidence(recs, vdir, custody_dir)
   149	    joined = {r["id"]: r for r in records_out}
   150	    out = []
   151	    for p, doc, r in starters.check_dir(starters_dir, ev):
   152	        why = r.problems or [f"unchecked here: {u}" for u in r.unchecked]
   153	        if why:
   154	            for line in why:
   155	                print(f"starters: {p.name} not published: {line}", file=sys.stderr)
     1	"""Load and validate dataset records (records/<publisher>/<dataset>.yaml) and outlines."""
     2	
     3	from __future__ import annotations
     4	
     5	import json
     6	from dataclasses import dataclass
     7	from pathlib import Path
     8	
     9	import yaml
    10	from jsonschema import Draft202012Validator, FormatChecker
    11	
    12	from . import paths
    13	
    14	
    15	@dataclass(frozen=True)
    16	class Problem:
    17	    path: str
    18	    message: str
    19	
    20	    def __str__(self) -> str:
    21	        return f"{self.path}: {self.message}"
    22	
    23	
    24	def _schema(name: str) -> dict:
    25	    return json.loads((paths.SCHEMA_DIR / f"{name}.schema.json").read_text())
    26	
    27	
    28	def _validator(name: str) -> Draft202012Validator:
    29	    return Draft202012Validator(_schema(name), format_checker=FormatChecker())
    30	
    31	
    32	def record_files(records_dir: Path = paths.RECORDS_DIR) -> list[Path]:
    33	    return sorted(records_dir.glob("*/*.yaml"))
    34	
    35	
    36	def load_record(path: Path) -> dict:
    37	    data = yaml.safe_load(path.read_text())
    38	    if not isinstance(data, dict):
    39	        raise TypeError(f"{path}: not a mapping")
    40	    # dates: yaml parses 2026-10-23 into a date; the schema wants the ISO string
    41	    if "added" in data and not isinstance(data["added"], str):
    42	        data["added"] = data["added"].isoformat()
    43	    # period: unquoted 1993-06-30 is a date and 1993 an int; the schema wants the strings
    44	    period = data.get("period")
    45	    if isinstance(period, dict):
    46	        for k in ("start", "end"):
    47	            x = period.get(k)
    48	            if hasattr(x, "isoformat"):
    49	                period[k] = x.isoformat()
    50	            elif isinstance(x, int) and not isinstance(x, bool):
    51	                period[k] = str(x)
    52	    # licence.terms.expires: unquoted 2030-12-31 is a date; the schema wants the string
    53	    terms = (data.get("licence") or {}).get("terms")
    54	    if isinstance(terms, dict):
    55	        x = terms.get("expires")
    56	        if hasattr(x, "isoformat"):
    57	            terms["expires"] = x.isoformat()
    58	        elif isinstance(x, int) and not isinstance(x, bool):
    59	            terms["expires"] = str(x)
    60	    return data
    61	
    62	
    63	def load_records(records_dir: Path = paths.RECORDS_DIR) -> dict[str, dict]:
    64	    out: dict[str, dict] = {}
    65	    for p in record_files(records_dir):
    66	        rec = load_record(p)
    67	        out[rec.get("id", str(p))] = rec
    68	    return out
    69	
    70	
    71	def validate_records(records_dir: Path = paths.RECORDS_DIR) -> list[Problem]:
    72	    """Schema validity plus the two consistency rules a schema cannot express."""
    73	    problems: list[Problem] = []
    74	    v = _validator("record")
    75	    seen: dict[str, Path] = {}
    76	    for p in record_files(records_dir):
    77	        rel = str(p.relative_to(records_dir))
    78	        try:
    79	            rec = load_record(p)
    80	        except (OSError, TypeError, yaml.YAMLError) as e:
    81	            problems.append(Problem(rel, f"unreadable: {e}"))
    82	            continue
    83	        for err in sorted(v.iter_errors(rec), key=lambda e: list(e.path)):
    84	            where = "/".join(str(x) for x in err.path) or "<root>"
    85	            problems.append(Problem(rel, f"{where}: {err.message}"))
    86	        rid = rec.get("id")
    87	        if isinstance(rid, str):
    88	            if rid + ".yaml" != rel:
    89	                problems.append(Problem(rel, f"id '{rid}' does not match the file path"))
    90	            if rid in seen:
    91	                problems.append(Problem(rel, f"duplicate id '{rid}' (also {seen[rid].name})"))
    92	            seen[rid] = p
    93	        lic = rec.get("licence", {})
    94	        if lic.get("share_alike") and lic.get("redistribution") == "forbidden":
    95	            problems.append(Problem(rel, "share_alike with redistribution forbidden is contradictory"))
    96	    return problems
    97	
    98	
    99	def load_outline(path: Path) -> dict:
   100	    return json.loads(path.read_text())
   101	
   102	
   103	def validate_outlines(
   104	    outlines_dir: Path = paths.OUTLINES_DIR, records_dir: Path = paths.RECORDS_DIR
   105	) -> list[Problem]:
   106	    """Each outline file is a FeatureCollection whose features carry the outline properties
   107	    and name an existing record; the file name must match that record. Geometry is WGS84 with
   108	    closed, non-empty rings; a feature_id is '<record-id>#...' and unique in its file; a derived
   109	    feature names an input the collection carries and has a licence (its own or the file's)."""
   110	    problems: list[Problem] = []
   111	    v = _validator("outline")
   112	    vc = Draft202012Validator(_schema("outline")["$defs"]["collection"], format_checker=FormatChecker())
   113	    known = set(load_records(records_dir))
   114	    for p in sorted(outlines_dir.glob("*.geojson")):
   115	        rel = p.name
   116	        try:
   117	            fc = load_outline(p)
   118	        except (OSError, ValueError) as e:
   119	            problems.append(Problem(rel, f"unreadable: {e}"))
   120	            continue
   121	        if fc.get("type") != "FeatureCollection":
   122	            problems.append(Problem(rel, "not a FeatureCollection"))
   123	            continue
   124	        expected_id = p.stem.replace("__", "/")
   125	        ids: dict[str, int] = {}
   126	        for err in vc.iter_errors({k: x for k, x in fc.items() if k not in ("type", "features")}):
   127	            problems.append(Problem(rel, f"collection: {err.message}"))
   128	        named = fc.get("inputs") if isinstance(fc.get("inputs"), dict) else {}
   129	        if expected_id not in known:
   130	            problems.append(Problem(rel, f"no record '{expected_id}' for this outline file"))
   131	        for i, f in enumerate(fc.get("features", [])):
   132	            props = f.get("properties", {})
   133	            for err in v.iter_errors(props):
   134	                problems.append(Problem(rel, f"feature {i}: {err.message}"))
   135	            if props.get("record_id") != expected_id:
   136	                problems.append(
   137	                    Problem(rel, f"feature {i}: record_id '{props.get('record_id')}' != '{expected_id}'")
   138	                )
   139	            for msg in geometry_problems(f.get("geometry") or {}):
   140	                problems.append(Problem(rel, f"feature {i}: {msg}"))
   141	            if props.get("approximate") is False:
   142	                if "input" in props and props["input"] not in named:
   143	                    problems.append(Problem(rel, f"feature {i}: input '{props['input']}' is not in the collection's inputs"))
   144	                if not (props.get("licence") or fc.get("licence")):
   145	                    problems.append(Problem(rel, f"feature {i}: no licence (the feature's or the collection's)"))
   146	            fid = props.get("feature_id")
   147	            if fid is not None:
   148	                if not str(fid).startswith(expected_id + "#"):
   149	                    problems.append(Problem(rel, f"feature {i}: feature_id '{fid}' is not '{expected_id}#...'"))
   150	                if fid in ids:
   151	                    problems.append(Problem(rel, f"feature {i}: duplicate feature_id '{fid}' (also feature {ids[fid]})"))
   152	                ids.setdefault(fid, i)
   153	    return problems
