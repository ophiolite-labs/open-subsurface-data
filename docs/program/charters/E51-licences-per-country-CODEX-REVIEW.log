   385	class _Robots:
   386	    """robots.txt per host: 2xx is obeyed, 4xx allows everything, anything else (5xx, no answer) is
   387	    unreadable and treated as disallow (RFC 9309 section 2.3.1.4); `unread` says why, per host. A
   388	    2xx body is read by osd.verifier.robots (H3: groups, wildcards, the longest match)."""
   389	    TOKEN = USER_AGENT.split("/", 1)[0]  # the product token (RFC 9309 section 2.2.1)
   390	
   391	    def __init__(self, opener: Opener):
   392	        self.opener, self.hosts, self.unread = opener, {}, {}
   393	
   394	    def allowed(self, url: str) -> bool:
   395	        u = urlsplit(url)
   396	        key = f"{u.scheme}://{u.netloc}"
   397	        if key not in self.hosts:
   398	            try:
   399	                text = _read(self.opener(key + "/robots.txt"), 512 * 1024).decode("utf-8", "replace")
   400	                self.hosts[key] = robots_txt.parse(text, self.TOKEN)
   401	            except FetchError as e:
   402	                if 400 <= e.status < 500:
   403	                    self.hosts[key] = robots_txt.Rules()
   404	                else:
   405	                    self.hosts[key] = robots_txt.Rules.disallow_all()
   406	                    self.unread[key] = f"HTTP {e.status}" if e.status else (e.error or "no answer")
   407	        return self.hosts[key].allowed(url)
   408	
   409	    def refusal(self, url: str, what: str) -> str:
   410	        """Why `url` is not fetched: an unreadable robots.txt (H1 design 9) or an explicit disallow."""
   411	        u = urlsplit(url)
   412	        if why := self.unread.get(f"{u.scheme}://{u.netloc}"):
   413	            return f"robots.txt unreadable ({why}), treated as disallow (RFC 9309 section 2.3.1.4): {what} not fetched"
   414	        return f"robots.txt disallows {what}"
