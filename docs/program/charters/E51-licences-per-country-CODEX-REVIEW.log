   580	def _check_service(service, manifest: str, sort: str | None, opener: Opener, budget: ByteBudget,
   581	                   check: Callable[[str, str], dict]) -> tuple[dict, list[dict], dict]:
   582	    """E38: a WFS feature type or an OGC API collection read whole. Only a complete layer passes; an
   583	    unconfirmed one is kept as evidence without L2, a partial one keeps the cap's one-page export
   584	    as a partial export; none of them is ever a file."""
   585	    get = _layer_get(opener, _Robots(opener), budget)
   586	    if service.protocol == "wfs":
   587	        fmt, out = layers.WFS_FORMAT, layers.export_wfs(service.url, service.name, sort, manifest, get)
   588	    else:
   589	        fmt, out = layers.OGC_FORMAT, layers.export_ogcapi(service.url, service.name, get)
   590	    if out.status == "complete":
   591	        return check("pass", f"whole layer checked ({out.entry['features']} features, {fmt}), not a downloadable "
   592	                             f"file; {out.reason}"), [], {"layer_exports": [out.entry]}
   593	    if out.status == "unconfirmed":
   594	        return check("skip", f"whole layer read ({out.entry['features']} features, {fmt}) but its count is "
   595	                             f"unconfirmed ({out.reason}): no L2"), [], {"layer_exports": [out.entry]}
   596	    if out.status == "partial":
   597	        kept = "; the one-page export kept as a partial export, not a hashed file" if out.evidence else ""
   598	        return (check("skip", f"not read whole: {out.reason}{kept}"), [],
   599	                {"partial_exports": [out.evidence]} if out.evidence else {})
   600	    if out.status == "failed":
   601	        return check("fail", f"whole layer {service.url} {service.name if service.protocol == 'wfs' else ''}"
   602	                             .rstrip() + f": {out.reason}"), [], {}
   603	    return check("skip", out.reason), [], {}
