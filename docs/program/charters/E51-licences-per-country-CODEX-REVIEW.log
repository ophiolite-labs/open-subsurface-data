   274	# --- OGC API Features ----------------------------------------------------------------------------
   275	
   276	def export_ogcapi(collection: str, query: str, get: Callable[[str], bytes]) -> Outcome:
   277	    """A collection paged by its `next` links only (design 4): the expected count is the first page's
   278	    numberMatched (none: unconfirmed); a next link served before is a paging loop."""
   279	    def read() -> Outcome:
   280	        what = f"the collection {collection}"
   281	        desc = _doc(get(f"{collection}?{query}" if query else collection), "the collection description")
   282	        if not isinstance(desc, dict):
   283	            raise Refused("the collection description is not a JSON object")
   284	        items = _link(desc, "items", collection) or (f"{collection}/items?{query}" if query else f"{collection}/items")
   285	        url, seen, count, pages = _with(items, limit=OGC_PAGE), set(), None, _Pages(what)
   286	        while url:
   287	            if url in seen:
   288	                raise Refused(f"paging loop: the next link {url} was served before")
   289	            seen.add(url)
   290	            b = get(url)
   291	            where = f"page {pages.pages + 1} ({url})"
   292	            page = _doc(b, where)
   293	            if not pages.pages and isinstance(page, dict):
   294	                n = page.get("numberMatched")
   295	                count = n if isinstance(n, int) and not isinstance(n, bool) and n >= 0 else None
   296	                if count is not None and count > ARCGIS_MAX_FEATURES:
   297	                    raise Partial(f"the collection counts {count} features, above the {ARCGIS_MAX_FEATURES} a whole "
   298	                                  f"layer is read to", _evidence(url, b, f"first page ({OGC_FORMAT}, "
   299	                                                                 f"{len(page.get('features') or [])} of {count} features)"))
   300	            got = pages.add(page, where)
     1	"""robots.txt as RFC 9309 reads it (H3): the groups and rules of one file, matched against a URL.
     2	
     3	Groups (section 2.2.1): a group is one or more `user-agent` lines followed by rules; it ends at the
     4	next `user-agent` line after a rule, never at a blank line or a comment. Other records (`sitemap`,
     5	`crawl-delay`) neither end a group nor count as rules. Rules before the first `user-agent` line
     6	belong to no group and are ignored. Every group naming the product token (case-insensitive) is
     7	combined into one; if none does, every `*` group is; if neither exists, no rules apply.
     8	
     9	Rules (sections 2.2.2, 2.2.3): `allow` and `disallow` patterns match from the first octet of the
    10	path (with its query); `*` is any run of characters, a trailing `$` ends the pattern. The match with
    11	the most octets in its pattern wins and `allow` wins a tie; no match allows. An empty pattern is no
    12	rule (an empty `disallow` allows). `/robots.txt` is always allowed.
    13	
    14	Percent-encoding (section 2.2.2): both sides are compared as ASCII. Non-ASCII octets are encoded,
    15	escapes are written in upper case, and an escaped unreserved character (`A-Z a-z 0-9 - . _ ~`) is
    16	decoded; a literal `*` or `$` in the URL is encoded so that only a pattern's `%2A`/`%24` matches it.
    17	"""
    18	
    19	from __future__ import annotations
    20	
    21	import re
    22	from dataclasses import dataclass
    23	from functools import cache
    24	from urllib.parse import urlsplit
    25	
    26	UNRESERVED = frozenset(b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789-._~")
    27	ESCAPE = re.compile(rb"%([0-9A-Fa-f]{2})")
    28	
    29	
    30	def normalise(text: str, url: bool = False) -> str:
    31	    """`text` as the ASCII octets RFC 9309 compares; `url` encodes a literal `*` and `$` too."""
    32	    def unescape(m: re.Match) -> bytes:
    33	        o = int(m.group(1), 16)
    34	        return bytes([o]) if o in UNRESERVED else b"%" + m.group(1).upper()
    35	
    36	    raw = ESCAPE.sub(unescape, text.encode("utf-8"))
    37	    special = b"*$" if url else b""
    38	    return "".join(f"%{o:02X}" if o > 0x7E or o <= 0x20 or o in special else chr(o) for o in raw)
    39	
    40	
    41	@cache
    42	def _pattern(path: str) -> re.Pattern:
    43	    end = path.endswith("$")
    44	    body = ".*".join(re.escape(part) for part in (path[:-1] if end else path).split("*"))
    45	    return re.compile(body + (r"\Z" if end else ""), re.DOTALL)
    46	
    47	
    48	@dataclass(frozen=True)
    49	class Rules:
    50	    """The rules that apply to one product token: (allow, normalised pattern) pairs."""
    51	    rules: tuple[tuple[bool, str], ...] = ()
    52	
    53	    @classmethod
    54	    def disallow_all(cls) -> Rules:
    55	        return cls(((False, "/"),))
    56	
    57	    def allowed(self, url: str) -> bool:
    58	        u = urlsplit(url)
    59	        if u.path == "/robots.txt":
    60	            return True
    61	        target = normalise((u.path or "/") + (f"?{u.query}" if u.query else ""), url=True)
    62	        best = None  # (octets, allow): the longest match, allow above disallow at equal length
    63	        for allow, path in self.rules:
    64	            if _pattern(path).match(target) and (best is None or (len(path), allow) > best):
    65	                best = (len(path), allow)
    66	        return best is None or best[1]
    67	
    68	
    69	def parse(text: str, token: str) -> Rules:
    70	    """The rules of `text` for the product `token` (letters, `_` and `-`)."""
    71	    groups: list[tuple[set[str], list[tuple[bool, str]]]] = []
    72	    open_ = False  # the last group still takes user-agent lines (no rule seen since)
    73	    for line in text.removeprefix("\ufeff").splitlines():  # a byte order mark is not part of the first key
    74	        key, sep, value = line.split("#", 1)[0].partition(":")
    75	        key, value = key.strip().lower(), value.strip()
    76	        if not sep:
    77	            continue
    78	        if key == "user-agent":
    79	            agent = "*" if value.startswith("*") else re.match(r"[A-Za-z_-]*", value).group().lower()
    80	            if not open_:
    81	                groups.append((set(), []))
    82	                open_ = True
    83	            groups[-1][0].add(agent)
    84	        elif key in ("allow", "disallow") and groups:
    85	            open_ = False
    86	            if value:
    87	                groups[-1][1].append((key == "allow", normalise(value if value[0] in "/*" else "/" + value)))
    88	    for name in (token.lower(), "*"):
    89	        if matched := [rules for agents, rules in groups if name in agents]:
    90	            return Rules(tuple(r for rules in matched for r in rules))
    91	    return Rules()
     1	"""Verify in shards (H2): which records a shard verifies, and how the finishing job puts the shards'
     2	results back together.
     3	
     4	  shard_of    the shard of an origin host: SHA-256 of the lowercased host (UTF-8), first 8 bytes
     5	              big-endian, modulo N, plus one. One publisher's origin stays in one shard, so the 2 s
     6	              pause per host holds; adding a record moves no other record.
     7	  select      the ids of shard I of N, in catalogue order (`osd verify --shard I/N`)
     8	  overlay     the earlier-results snapshot with each accepted shard's fresh files laid over it; a
     9	              shard without its id list, or naming a record outside its shard, is discarded and its
    10	              records keep their earlier results
    11	  hosts       the measurement behind N: origin hosts per shard, and the other hosts (listings, files,
    12	              licence pages, outline inputs) with the shards that can reach each at once
    13	
    14	A shard artifact is a directory `shard-<I>/` holding `ids.txt` (the ids it verified, one per line),
    15	`verification/<id with / as __>.json` (exactly their files) and `shard.json` ({"shard", "of",
    16	"started", "finished"}, epoch seconds of its verify step). No network here.
    17	"""
    18	
    19	from __future__ import annotations
    20	
    21	import argparse
    22	import hashlib
    23	import json
    24	import re
    25	import shutil
    26	import sys
    27	from datetime import datetime
    28	from pathlib import Path
    29	from urllib.parse import urlsplit
    30	
    31	from . import paths
    32	from .records import load_records
    33	
    34	SHARDS = 12      # the verify workflow's matrix (H2 strategy: measured, not tuned per run)
    35	MAX_SHARDS = 16  # charter: 1 <= I <= N <= 16
    36	
    37	
    38	def origin_host(rec: dict) -> str:
    39	    return (urlsplit(rec["origin"]["url"]).hostname or "").lower()
    40	
    41	
    42	def shard_of(host: str, n: int) -> int:
    43	    return int.from_bytes(hashlib.sha256(host.encode("utf-8")).digest()[:8], "big") % n + 1
    44	
    45	
    46	def parse(spec: str) -> tuple[int, int]:
    47	    """"I/N" -> (I, N); ValueError for anything else or out of range."""
    48	    m = re.fullmatch(r"([0-9]+)/([0-9]+)", spec.strip())
    49	    if not m:
    50	        raise ValueError(f"--shard {spec!r} is not I/N")
    51	    i, n = int(m.group(1)), int(m.group(2))
    52	    if not 1 <= i <= n <= MAX_SHARDS:
    53	        raise ValueError(f"--shard {spec!r}: needs 1 <= I <= N <= {MAX_SHARDS}")
    54	    return i, n
    55	
    56	
    57	def select(recs: dict[str, dict], i: int, n: int) -> list[str]:
    58	    return [rid for rid, rec in recs.items() if shard_of(origin_host(rec), n) == i]
    59	
    60	
    61	def _file(rid: str) -> str:
    62	    return rid.replace("/", "__") + ".json"
    63	
    64	
    65	# --- the finishing job ---------------------------------------------------------------------------
    66	
    67	def check_artifact(d: Path, i: int, n: int, recs: dict[str, dict]) -> tuple[list[str] | None, str]:
    68	    """(ids, "") for an artifact the finishing job accepts, else (None, why it is discarded)."""
    69	    if not (d / "ids.txt").is_file():
    70	        return None, "no id list (the shard failed, was cancelled or uploaded nothing)"
    71	    ids = (d / "ids.txt").read_text().split()
    72	    meta = json.loads((d / "shard.json").read_text()) if (d / "shard.json").is_file() else {}
    73	    if (meta.get("shard"), meta.get("of")) != (i, n):
    74	        return None, f"shard.json names {meta.get('shard')}/{meta.get('of')}, not {i}/{n}"
    75	    for rid in ids:
    76	        if rid not in recs:
    77	            return None, f"names {rid}, not a record of this checkout"
    78	        if shard_of(origin_host(recs[rid]), n) != i:
    79	            return None, f"names {rid}, which is in shard {shard_of(origin_host(recs[rid]), n)}, not {i}"
    80	    files = {p.name for p in (d / "verification").glob("*")} if (d / "verification").is_dir() else set()
    81	    if files != {_file(r) for r in ids}:
    82	        return None, f"files {sorted(files ^ {_file(r) for r in ids})} do not match its id list"
    83	    for rid in ids:
    84	        if json.loads((d / "verification" / _file(rid)).read_text()).get("record_id") != rid:
    85	            return None, f"{_file(rid)} is not the result of {rid}"
    86	    return ids, ""
    87	
    88	
    89	def overlay(snapshot: Path, shards_dir: Path, out: Path, n: int, recs: dict[str, dict]) -> dict:
    90	    """Copy the snapshot to `out`, then each accepted shard's files over it (a fresh file replaces the
    91	    earlier one; a record without one keeps its earlier file). Returns what was accepted and why the
    92	    rest was discarded: {"accepted": {I: ids}, "discarded": {I: why}, "fresh": [ids], "kept": [ids]}."""
    93	    out.mkdir(parents=True, exist_ok=True)
    94	    if snapshot.resolve() != out.resolve():
    95	        shutil.copytree(snapshot, out, dirs_exist_ok=True)
    96	    accepted, discarded = {}, {}
    97	    for i in range(1, n + 1):
    98	        ids, why = check_artifact(shards_dir / f"shard-{i}", i, n, recs)
    99	        if ids is None:
   100	            discarded[i] = why
   101	            continue
   102	        for rid in ids:
   103	            shutil.copyfile(shards_dir / f"shard-{i}" / "verification" / _file(rid), out / _file(rid))
   104	        accepted[i] = ids
   105	    fresh = {rid for ids in accepted.values() for rid in ids}
   106	    return {"accepted": accepted, "discarded": discarded, "fresh": [r for r in recs if r in fresh],
   107	            "kept": [r for r in recs if r not in fresh]}
   108	
   109	
   110	def _stamp(v: dict) -> float:
   111	    return datetime.fromisoformat(v["checked_at"]).timestamp()
   112	
   113	
   114	def timings(shards_dir: Path, accepted: dict[int, list[str]]) -> dict[int, dict]:
   115	    """Per accepted shard: verify-step seconds, bytes hashed, and each record's seconds (from its
   116	    `checked_at` to the next record's, the last to the step's end; a record's time therefore includes
   117	    the next record's outline-input fetch)."""
   118	    out = {}
   119	    for i, ids in accepted.items():
   120	        d = shards_dir / f"shard-{i}"
   121	        meta = json.loads((d / "shard.json").read_text())
   122	        vs = [json.loads((d / "verification" / _file(r)).read_text()) for r in ids]
   123	        ends = [_stamp(v) for v in vs[1:]] + [float(meta.get("finished", 0))]
   124	        out[i] = {"seconds": float(meta.get("finished", 0)) - float(meta.get("started", 0)),
   125	                  "bytes": sum(f.get("bytes", 0) for v in vs for f in v.get("files", [])),
   126	                  "records": {v["record_id"]: max(0.0, e - _stamp(v)) for v, e in zip(vs, ends, strict=True)}}
   127	    return out
   128	
   129	
   130	def summary_lines(r: dict, n: int, recs: dict[str, dict], times: dict[int, dict] | None = None) -> list[str]:
   131	    times = times or {}
   132	    lines = [f"### verify in {n} shards", "",
   133	             (f"{len(r['fresh'])} of {len(recs)} records verified in this run; "
   134	              f"{len(r['kept'])} keep their earlier result."), "",
   135	             "| shard | records | verify step | bytes hashed | slowest record |", "|---|---|---|---|---|"]
   136	    for i in range(1, n + 1):
   137	        if i in r["discarded"]:
   138	            lines.append(f"| {i}/{n} | {len(select(recs, i, n))} | **failed**: {r['discarded'][i]} | | |")
   139	            continue
   140	        t = times.get(i, {})
   141	        slow = max(t.get("records", {}).items(), key=lambda kv: kv[1], default=None)
   142	        lines.append(f"| {i}/{n} | {len(r['accepted'][i])} | {t.get('seconds', 0) / 60:.1f} min | "
   143	                     f"{t.get('bytes', 0):,} | {f'{slow[0]} ({slow[1]:.0f} s)' if slow else ''} |")
   144	    for i, why in r["discarded"].items():
   145	        lines += ["", f"Shard {i}/{n} failed ({why}); its records keep their earlier results:",
   146	                  *[f"- {rid}" for rid in select(recs, i, n)]]
   147	    every = sorted(((s, rid) for t in times.values() for rid, s in t["records"].items()), reverse=True)[:10]
   148	    if every:
   149	        lines += ["", "Slowest records: " + ", ".join(f"{rid} ({s:.0f} s)" for s, rid in every)]
   150	    if r["kept"]:
   151	        lines += ["", "Records without a fresh result: " + " ".join(r["kept"])]
   152	    return lines
   153	
   154	
   155	# --- the measurement behind N --------------------------------------------------------------------
   156	
   157	def hosts(recs: dict[str, dict], n: int, vdir: Path | None = None) -> dict:
   158	    """Origin hosts per shard, and every other host a record reaches (manifest_url, licence page,
   159	    outline inputs, files hashed in `vdir`) with the shards whose records reach it."""
   160	    origin = {rid: origin_host(rec) for rid, rec in recs.items()}
   161	    other: dict[str, set[int]] = {}
   162	    for rid, rec in recs.items():
   163	        urls = [rec["origin"].get("manifest_url"), (rec.get("licence") or {}).get("url")]
   164	        urls += [x.get("url") for x in rec.get("inputs") or [] if isinstance(x, dict)]
   165	        v = vdir / _file(rid) if vdir else None
   166	        if v and v.is_file():
   167	            urls += [f.get("url") for f in json.loads(v.read_text()).get("files", [])]
   168	        for u in filter(None, urls):
   169	            h = (urlsplit(u).hostname or "").lower()
   170	            if h and h != origin[rid]:
   171	                other.setdefault(h, set()).add(shard_of(origin[rid], n))
   172	    per = {i: sorted({origin[r] for r in select(recs, i, n)}) for i in range(1, n + 1)}
   173	    return {"origin_hosts": per, "other_hosts": {h: sorted(s) for h, s in sorted(other.items())}}
   174	
   175	
   176	def main(argv: list[str] | None = None) -> int:
   177	    ap = argparse.ArgumentParser(prog="python -m osd.shards", description=__doc__.split("\n\n")[0])
   178	    sub = ap.add_subparsers(dest="cmd", required=True)
   179	    po = sub.add_parser("overlay", help="the finishing job: lay the accepted shards over the snapshot")
   180	    po.add_argument("--snapshot", required=True)
   181	    po.add_argument("--shards", required=True, help="the directory holding shard-<I>/")
   182	    po.add_argument("--out", default=str(paths.VERIFICATION_DIR))
   183	    po.add_argument("-n", type=int, default=SHARDS)
   184	    po.add_argument("--fresh", required=True, help="write the freshly verified ids here, one per line")
   185	    po.add_argument("--summary", help="write the step summary (markdown) here")
   186	    ph = sub.add_parser("hosts", help="origin hosts per shard and the other hosts each shard reaches")
