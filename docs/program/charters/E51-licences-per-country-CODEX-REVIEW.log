     1	# Network verification. Never a required check: a publisher's outage must not stop merges.
     2	# Pull requests (the records and outlines they change; none changed, nothing verified: H4) and
     3	# dispatches naming ids: one job verifies those records (the PR
     4	# gets a comment with the levels). A dispatch with empty ids verifies every record in 12 shards (H2):
     5	# `snapshot` fetches the stored results once, each `shard` verifies the records whose origin host
     6	# hashes to it (osd.shards), `finish` lays the accepted shards over the snapshot (a failed shard's
     7	# records keep their earlier results), reports, runs `make check-full`, and on main stores the
     8	# results on the `verification-results` branch (OSD-D5) and republishes.
     9	# The mirror (E07): a dispatch on main copies the eligible records to the S3 bucket and refreshes the
    10	# custody documents, which travel on `verification-results` under custody/ for the build (pages.yml);
    11	# a branch dispatch only reads the bucket (`--dry-run`). A dispatch on main naming ids also copies the
    12	# custody documents before verifying (E41), so a deposit made since the last run counts in this run. A dispatch naming `takedown_sha256` runs only
    13	# the takedown job (main, an approved request). The S3 keys reach no pull-request run.
    14	name: verify
    15	on:
    16	  workflow_dispatch:
    17	    inputs:
    18	      ids: { description: "record ids, space separated (empty = all, in shards)", required: false, default: "" }
    19	      fail_shard: { description: "branch dispatches only: this shard exits 1 before verifying (H2 evidence)", required: false, default: "" }
    20	      takedown_sha256: { description: "main only: remove this mirrored copy (E07); nothing else runs", required: false, default: "" }
    21	      takedown_request: { description: "with takedown_sha256: the issue URL carrying takedown-approved", required: false, default: "" }
    22	  pull_request:
    23	    paths: ["records/**", "outlines/**"]
    24	# One dispatch on main at a time, all-record and explicit-id alike, so two never overwrite each
    25	# other's stored results. cancel-in-progress false: a running dispatch finishes; GitHub keeps one
    26	# pending run and replaces an older pending one. Accepted: the replaced dispatch is covered by the
    27	# newer one when that one is all-record, and the supervisor dispatches all-record runs after merges.
    28	# Pull requests and branch dispatches each get their own group (outside).
    29	concurrency:
    30	  group: "${{ github.event_name == 'workflow_dispatch' && github.ref == 'refs/heads/main' && 'verify-main' || format('verify-{0}', github.run_id) }}"
