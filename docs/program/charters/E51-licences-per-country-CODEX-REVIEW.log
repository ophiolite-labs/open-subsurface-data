tests/fixtures/listings/ckan-wa-demirs.json:1:{"help": "https://catalogue.data.wa.gov.au/api/3/action/help_show?name=package_show", "success": true, "result": {"access_level": "open", "author": "Digital Data Administrator", "author_email": "gsd.dda@dmpe.wa.gov.au", "citation": "", "creator_user_id": "ade8d60c-29c7-4fa3-b710-dfb700f988f4", "data_access_statement": "Licensed under CCBY 4", "data_homepage": "https://public-services.slip.wa.gov.au/public/rest/services/SLIP_Public_Services/Industry_and_Mining/MapServer/13", "data_portal": "https://services.slip.wa.gov.au/public/rest/services/SLIP_Public_Services/Industry_and_Mining/MapServer/13", "doi": "", "geospatial_theme": "Industry and Mining", "harvesting_service": "", "harvesting_source": "", "has_additional_licensing_options": "False", "hide_data_dictionary_resource": false, "id": "e9e7eee9-4fd5-4482-b182-e3ad8f3be85b", "information_classification": "official", "isopen": true, "last_updated_on": "2026-10-22", "license_id": "cc-by", "license_title": "Creative Commons Attribution 4.0", "license_url": "https://creativecommons.org/licenses/by/4.0/", "maintainer": "Digital Data Administrator", "maintainer_email": "gsd.dda@dmpe.wa.gov.au", "metadata_created": "2018-06-20T03:44:56.483480", "metadata_modified": "2026-10-22T22:29:14.313748", "name": "wa-onshore-petroleum-wells-dmirs-025", "notes": "This dataset is a reference system for petroleum exploration and development wells drilled in Western Australia. NOTE: Since 1 January 2012 Offshore wells have been managed by National Offshore Petroleum Titles Administrator (NOPTA). NOPTA should be contacted for currency and completeness of offshore wells since this date. The extent of wells is both onshore and offshore (prior to 1/1/2012). Onshore wells are updated on a regular basis. Offshore is done on an adhoc basis when updates are provided by NOPTA. ", "num_resources": 4, "num_tags": 2, "organization": {"id": "db367a59-0a5d-4674-81d3-c9e248335d47", "name": "department-of-mines-industry-regulation-and-safety", "title": "Department of Energy, Mines, Industry Regulation and Safety", "type": "organization", "description": "The Department of Energy, Mines, Industry Regulation and Safety has brought together the Department of Mines and Petroleum and most of the Department of Commerce. ", "image_url": "2024-09-25-101524.683620DEMIRS-datawa.svg", "created": "2018-01-12T12:59:48.721528", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "db367a59-0a5d-4674-81d3-c9e248335d47", "private": false, "projection_and_datum": "GDA2020 (7844)", "published_on": "2018-06-01", "spatial": "{\"type\": \"Polygon\", \"coordinates\": [[[111.59486200000003, -34.75071099999997], [128.97626300000002, -34.75071099999997], [128.97626300000002, -10.632117999999934], [111.59486200000003, -10.632117999999934], [111.59486200000003, -34.75071099999997]]]}", "state": "active", "theme": "Natural Resources", "title": "WA Petroleum Wells (DMIRS-025)", "type": "dataset", "update_frequency": "daily", "url": null, "version": null, "visibility": "public", "groups": [{"description": "_The About page for this group provides data service links and more information regarding this service._ \r\n\r\nThis service provides access to industry and mining related data for public use.\r\n\r\nIf you have any questions about this service, please contact Landgate Customer Service:\r\n\r\nCustomer Experience team\r\n\r\n[customerexperience@landgate.wa.gov.au](mailto:customerexperience@landgate.wa.gov.au)\r\n\r\n+61 (0)8 9273 7683 (direct line)\r\nMonday to Friday, 8.30am to 5pm (AWST)\r\n\r\n\r\nFor data quality queries please refer to the [dataset](https://catalogue.data.wa.gov.au/group/slip-public-industry-and-mining-service) Contact details.\r\n\r\nServices \r\n=======\r\n\r\nNote, the following services require 3rd party software that supports [OGC Standards](http://www.opengeospatial.org/standards) and [Esri services](http://www.esri.com/).\r\n\r\nOGC Web Services\r\n------------------------------\r\n\r\n__[Web Map Service (WMS)](https://services.slip.wa.gov.au/public/services/SLIP_Public_Services/Industry_and_Mining/MapServer/WMSServer?)__ _Right mouse click to copy and paste the URL to a WMS server connection._ \r\n\r\n__[Web Feature Service (WFS)](https://services.slip.wa.gov.au/public/services/SLIP_Public_Services/Industry_and_Mining_WFS/MapServer/WFSServer?)__ _Right mouse click to copy and paste the URL to a WFS server connection._ \r\n\r\nESRI ArcGIS users\r\n------------------------------\r\n\r\n__[Map Service](https://services.slip.wa.gov.au/public/rest/services/SLIP_Public_Services/Industry_and_Mining/MapServer)__ _Right mouse click to copy and paste the URL to an ArcGIS server connection._", "display_name": "SLIP Public Industry and Mining Service", "id": "d40f7f9f-ff7e-4dd3-bfca-5bdb72dbe0f3", "image_display_url": "https://catalogue.data.wa.gov.au/uploads/group/2017-06-23-093047.0162702017-06-23-063701.018991SLIP-logo.png", "name": "slip-public-industry-and-mining-service", "title": "SLIP Public Industry and Mining Service"}], "resources": [{"access_level": "open", "cache_last_updated": null, "cache_url": null, "created": "2018-06-20T03:47:41.036122", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "description": "Download in other data formats from the Department of Mines, Industry Regulation and Safety Data and Software Centre.", "format": "GDB SHP TAB KML", "hash": "", "id": "5a2f1e56-5bcb-45e9-845e-1bc789042a0a", "last_modified": null, "metadata_modified": "2022-07-19T19:50:06.185289", "mimetype": null, "mimetype_inner": null, "name": "Other spatial formats", "package_id": "e9e7eee9-4fd5-4482-b182-e3ad8f3be85b", "position": 0, "resource_type": null, "section": "data_downloads", "size": null, "state": "active", "tracking_summary": {"total": 0, "recent": 0}, "url": "https://dasc.dmirs.wa.gov.au/home?productAlias=WAPetroleumWells", "url_type": null}, {"access_level": "open", "cache_last_updated": null, "cache_url": null, "created": "2025-11-27T03:05:26.142102", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "description": "Web Feature Service (WFS) provides an interface that allows requests for geographical features across the web using platform independent calls.\n\nWFS allows a user to download and spatially analyse the features within a datset.\n\nThis service is aimed at advanced geographical information users, and will require access to geographical information system (GIS) software such as QGIS and ArcGIS.", "format": "WFS", "harvesting_source": "https://public-services.slip.wa.gov.au/public/services/SLIP_Public_Services/Industry_and_Mining_WFS/MapServer/WFSServer", "hash": "", "id": "a489a4d7-c7a0-4b5a-b117-aa98de28572c", "last_modified": "2026-10-22T00:00:00", "metadata_modified": "2026-10-22T22:28:11.680976", "mimetype": null, "mimetype_inner": null, "name": "Web Feature Service", "package_id": "e9e7eee9-4fd5-4482-b182-e3ad8f3be85b", "position": 1, "resource_type": null, "section": "web_services_and_apis", "size": null, "state": "active", "tracking_summary": {"total": 0, "recent": 0}, "url": "https://public-services.slip.wa.gov.au/public/services/SLIP_Public_Services/Industry_and_Mining_WFS/MapServer/WFSServer", "url_type": null, "wfs_layer": "SLIP_Public_Services_Industry_and_Mining_WFS:WA_Onshore_Petroleum_Wells__DMIRS-025_"}, {"access_level": "open", "cache_last_updated": null, "cache_url": null, "created": "2025-11-27T03:05:39.676386", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "description": "Web Map Service (WMS) is a standard protocol for serving georeferenced map images over the internet that are generated by a map server using data from a GIS database.\n\nWMS allows a user to spatially visualise the dataset, and query individual features, but does not allow downloading the raw data.\n\nThis service is aimed at advanced geographical information users, and will require access to geographical information system (GIS) software such as QGIS and ArcGIS.", "format": "WMS", "harvesting_source": "https://public-services.slip.wa.gov.au/public/services/SLIP_Public_Services/Industry_and_Mining/MapServer/WMSServer", "hash": "", "id": "648eb757-d1de-4901-96c0-868bc4128336", "last_modified": "2026-10-22T00:00:00", "metadata_modified": "2026-10-22T22:29:14.321519", "mimetype": null, "mimetype_inner": null, "name": "Web Mapping Service", "package_id": "e9e7eee9-4fd5-4482-b182-e3ad8f3be85b", "position": 2, "preview_data": "true", "resource_type": null, "section": "web_services_and_apis", "size": null, "state": "active", "tracking_summary": {"total": 0, "recent": 0}, "url": "https://public-services.slip.wa.gov.au/public/services/SLIP_Public_Services/Industry_and_Mining/MapServer/WMSServer", "url_type": null, "wms_layer": "37"}, {"access_level": "open", "cache_last_updated": null, "cache_url": null, "created": "2025-11-27T03:05:41.316677", "datastore_active": false, "datastore_contains_all_records_of_source_file": false, "description": "An ArcGIS Server Map Service offers access to a geographic dataset - such as a map or imagery - by providing a set of tiled images for use in web-based maps.\n\nDepending on the capabilities enabled, this web service may also allow a client to dynamically draw, search, and query its features.\n\nThis service is aimed at advanced geographical information users, and will require access to geographical information system (GIS) software such as ArcGIS and QGIS.", "format": "API ArcGIS Server Map Service", "harvesting_source": "https://public-services.slip.wa.gov.au/public/rest/services/SLIP_Public_Services/Industry_and_Mining/MapServer/13", "hash": "", "id": "6eb7eceb-9039-486f-b239-537618c1f11c", "last_modified": "2026-10-22T00:00:00", "metadata_modified": "2026-10-22T22:29:11.712583", "mimetype": null, "mimetype_inner": null, "name": "ArcGIS Server Map Service", "package_id": "e9e