   222	def cmd_get(a: argparse.Namespace) -> int:
   223	    try:
   224	        m = manifest_mod.read(a.manifest)
   225	        outcomes = get_mod.get(m, Path(a.dest))
   226	    except manifest_mod.ManifestError as e:
