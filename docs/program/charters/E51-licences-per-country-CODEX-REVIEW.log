    33	        run: |
    34	          npm ci --no-audit --no-fund
    35	          npx playwright install --only-shell chromium   # the runner image has Chromium's system libraries; --with-deps stalls on apt
    36	          make site-test
    37	      - uses: actions/upload-artifact@v4
