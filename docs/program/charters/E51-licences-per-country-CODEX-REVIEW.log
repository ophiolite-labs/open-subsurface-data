   234	def cmd_mirror_eligible(a: argparse.Namespace) -> int:
   235	    rules, n, total = mirror_mod.load_rules(), 0, 0
   236	    for rid, rec in load_records().items():
   237	        if a.ids and rid not in a.ids:
   238	            continue
   239	        e = mirror_mod.eligibility(rec, build_mod.latest_verification(rid, Path(a.vdir)), rules.get(rid))
   240	        n, total = n + e.eligible, total + (e.bytes if e.eligible else 0)
   241	        why = f"{len(e.files)} files, {e.bytes} bytes" if e.eligible else "; ".join(e.reasons)
   242	        print(f"  {'eligible' if e.eligible else 'no':8} {rid:40} {why}")
   243	    print(f"{n} eligible, {total} bytes of inventory")
   244	    return 0
   245	
   246	
   247	def _store(a: argparse.Namespace):
   248	    return mirror_mod.open_store(a.store, a.public_url)
   249	
   250	
   251	def cmd_mirror_put(a: argparse.Namespace, opener=http_open) -> int:
   252	    recs, rules, bad, to_copy = load_records(), mirror_mod.load_rules(), False, []
   253	    dry = getattr(a, "dry_run", False)
   254	    try:
   255	        store = _store(a)
   256	        if hasattr(store, "check"):
   257	            store.check()               # HEAD on the bucket: the keys reach it
   258	    except mirror_mod.MirrorError as e:
   259	        print(f"refused: {e}")
   260	        return 1
   261	    for rid in a.ids:
   262	        try:
   263	            out = mirror_mod.put(recs[rid], build_mod.latest_verification(rid, Path(a.vdir)), rules.get(rid),
   264	                                 store, opener, dry_run=dry)
   265	        except mirror_mod.MirrorError as e:     # NotEligible, or the store refused
   266	            print(f"refused: {e}")
   267	            bad = True
   268	            continue
   269	        for c in out:
   270	            print(f"  {c.outcome:11} {rid} {c.path} {c.sha256[:12]}  ({c.detail})")
   271	            bad |= c.outcome in ("mismatch", "origin-dead")
   272	            to_copy += [c] if c.outcome in ("would-copy", "would-finish") else []
   273	    if dry:
   274	        print(f"dry run: {len(to_copy)} files, {sum(c.bytes for c in to_copy)} bytes would be copied;"
   275	              f" nothing written to {store.root}")
   276	    tombs = sum(k.endswith(".removed.json") for k in store.keys("custody/"))
   277	    print(f"store {store.root}: {len(store.keys('mirror/'))} objects, "
   278	          f"{len(store.keys('custody/')) - tombs} custody documents, {tombs} tombstones")
   279	    return 1 if bad else 0
   280	
   281	
   282	def _uploaded(rid: str, out: list, store) -> None:
   283	    for c in out:
   284	        print(f"  {c.outcome:11} {rid} {c.path} {c.sha256[:12]}  ({c.bytes} bytes)")
   285	    print(f"{len(out)} files, {sum(c.bytes for c in out)} bytes in {store.root}: "
   286	          f"{sum(c.outcome == 'published' for c in out)} published, {sum(c.outcome == 'present' for c in out)} present")
   287	
   288	
   289	def cmd_mirror_deposit(a: argparse.Namespace) -> int:
   290	    """E41: no network but the store; the page and the licence text are files the person saved."""
   291	    recs = load_records()
   292	    if a.record_id not in recs:
   293	        print(f"refused: no record {a.record_id}")
   294	        return 1
   295	    try:
   296	        store = _store(a)
   297	        if hasattr(store, "check"):
   298	            store.check()
   299	        out = mirror_mod.deposit(recs[a.record_id], Path(a.dir), store, obtained=a.obtained, by=a.by,
   300	                                 page_url=a.page_url, page=Path(a.page), licence=Path(a.licence_text))
     1	"""Build the published catalogue from records, outlines and verification records.
     2	
     3	Outputs (build/catalog/):
     4	  records.json    every record, joined with its latest verification level, the date it was
     5	                   established, `stale` when that date is over 30 days old (or absent) and
     6	                   `blocked_since` while the origin refuses this runner (OSD-D9); `reasons`, by record
     7	                   id, why the record is at its level in the verifier's words ("never verified" when
     8	                   it never was), the very string `osd status` prints (osd.reasons, E27), kept beside
     9	                   the records array so records_digest and the manifests that pin it are unchanged;
    10	                   and `catalog`,
    11	                   the snapshot identity (E09): source_commit, verification_commit, built_at and
    12	                   records_digest, the sha256 of the records array as canonical JSON (keys sorted,
    13	                   separators "," ":", UTF-8), which manifest/3 and fidelity/1 carry back
    14	  outlines.geojson one FeatureCollection, every feature joined with record title, kinds,
    15	                   licence and level so the map needs no second lookup
    16	  stac/            the static STAC catalogue (src/osd/stac.py)
    17	  collections.json {"collections": [...]}, the same STAC Collections in one file
    18	  outlines.pmtiles the same features as vector tiles, z0-12, when tippecanoe is installed (E15);
    19	                   wellbore points from CLUSTER_BELOW_ZOOM up only (E36)
    20	  wells-z<z>.json  for z below CLUSTER_BELOW_ZOOM, the wellbore points counted on a grid (E36): what
    21	                   the map clusters there, so the world view does not load every well
    22	  mirror.json     {"copies": [...]}, the public index of what the mirror holds, regenerated from the
    23	                   custody documents in <mirror_dir>/custody/ (E07, custody/1 and /2); STAC assets gain
    24	                   the alternates
    25	  starters.json   {"starters": [...]}, every published starter pack whole (E40): each pack document that
    26	                   passes every rule of osd.starters with its evidence here, is not `unpublished`, plus
    27	                   `record` (the record's title and level) and each artefact's `href` from its custody
    28	                   document; the record in records.json lists the pack ids in `starters` (only records
    29	                   with a pack carry the key). A refused or unchecked pack is printed, never published
    30	  starters/       each published pack document and its fidelity record, byte for byte (the pack
    31	                   manifest's two documents, osd manifest --starter)
    32	"""
    33	
    34	from __future__ import annotations
    35	
    36	import hashlib
    37	import json
    38	import os
    39	import re
    40	import shutil
    41	import subprocess
    42	from datetime import UTC, datetime
    43	from pathlib import Path
    44	
    45	from . import __version__, mirror, paths, stac, starters
    46	from .reasons import reason
    47	from .records import load_outline, load_records
    48	from .verify import is_stale
    49	
    50	
    51	def latest_verification(rid: str, vdir: Path = paths.VERIFICATION_DIR) -> dict | None:
    52	    p = vdir / (rid.replace("/", "__") + ".json")
    53	    return json.loads(p.read_text()) if p.exists() else None
    54	
    55	
    56	COMMIT = re.compile(r"^[0-9a-f]{40}$")
    57	FROM_ENVIRONMENT = "from-environment"
    58	
    59	
    60	def records_digest(records: list[dict]) -> str:
    61	    canonical = json.dumps(records, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    62	    return hashlib.sha256(canonical.encode()).hexdigest()
    63	
    64	
    65	def git_head(root: Path = paths.ROOT) -> str | None:
    66	    """HEAD of the checkout the records come from; None outside git."""
    67	    try:
    68	        r = subprocess.run(["git", "-C", str(root), "rev-parse", "HEAD"], capture_output=True, text=True, check=False)
    69	    except OSError:
    70	        return None
    71	    return r.stdout.strip() if r.returncode == 0 and COMMIT.match(r.stdout.strip()) else None
    72	
    73	
    74	def verification_commit_from_env() -> str | None:
    75	    """The verification-results commit the workflow extracted into build/verification, as it says in
    76	    OSD_VERIFICATION_COMMIT; None when it says nothing (a local build)."""
    77	    v = os.environ.get("OSD_VERIFICATION_COMMIT", "").strip()
    78	    if v and not COMMIT.match(v):
    79	        raise ValueError(f"OSD_VERIFICATION_COMMIT={v!r} is not a 40-character commit id")
    80	    return v or None
    81	
    82	
    83	def build(out_dir: Path = paths.CATALOG_DIR, vdir: Path = paths.VERIFICATION_DIR,
    84	          now: datetime | None = None, mirror_dir: Path = mirror.MIRROR_DIR,
    85	          records_dir: Path = paths.RECORDS_DIR, source_commit: str | None = FROM_ENVIRONMENT,
    86	          verification_commit: str | None = FROM_ENVIRONMENT, starters_dir: Path = starters.STARTERS_DIR) -> dict:
    87	    out_dir.mkdir(parents=True, exist_ok=True)
    88	    recs = load_records(records_dir)
    89	    records_out = []
    90	    reasons = {}
    91	    features = []
    92	    for rid, rec in recs.items():
    93	        v = latest_verification(rid, vdir)
    94	        level = v["level"] if v else "L0"
    95	        checked = v["checked_at"] if v else None
    96	        blocked = (v or {}).get("origin", {}).get("blocked_since")
    97	        joined = dict(rec, level=level, checked_at=checked, stale=is_stale(checked, now), blocked_since=blocked)
    98	        reasons[rid] = reason(v, rec)
    99	        records_out.append(joined)
   100	        op = paths.outline_path(rid)
   101	        if op.exists():
   102	            for f in load_outline(op)["features"]:
   103	                # E18: a feature's dates are its STAC Item's, not map attributes (tippecanoe 2.49
   104	                # wrote other features' values into three tiles with them: evidence/e18/registers.md)
   105	                props = {k: v for k, v in f["properties"].items() if not k.startswith("osd:period_")}
   106	                props.update({
   107	                    "title": rec["title"], "publisher": rec["publisher"]["name"],
   108	                    "kinds": rec["kinds"], "licence": rec["licence"]["name"],
   109	                    "redistribution": rec["licence"]["redistribution"], "level": level,
   110	                })
   111	                fid = {"id": props["feature_id"]} if "feature_id" in props else {}
   112	                features.append({"type": "Feature", **fid, "properties": props, "geometry": f["geometry"]})
   113	    packs = published_starters(starters_dir, recs, records_out, vdir, mirror_dir / "custody")
   114	    for r in records_out:
   115	        ids = sorted(p["id"] for p in packs if p["record_id"] == r["id"])
   116	        if ids:
   117	            r["starters"] = ids
   118	    catalog = {
   119	        "source_commit": git_head() if source_commit == FROM_ENVIRONMENT else source_commit,
   120	        "verification_commit": (verification_commit_from_env() if verification_commit == FROM_ENVIRONMENT
   121	                                else verification_commit),
   122	        "built_at": (now or datetime.now(UTC)).strftime("%Y-%m-%dT%H:%M:%SZ"),
   123	        "records_digest": records_digest(records_out),
   124	    }
   125	    (out_dir / "records.json").write_text(json.dumps(
   126	        {"tool_version": __version__, "count": len(records_out), "catalog": catalog, "records": records_out,
   127	         "reasons": reasons},
   128	        indent=2) + "\n")
   129	    (out_dir / "outlines.geojson").write_text(json.dumps(
   130	        {"type": "FeatureCollection", "features": features}) + "\n")
   131	    write_starters(out_dir, starters_dir, packs)
   132	    index = mirror.public_index(mirror_dir / "custody")
   133	    (out_dir / "mirror.json").write_text(json.dumps({"copies": index}, indent=2) + "\n")
   134	    collections = stac.write_catalog(out_dir, records_out, vdir, mirror_index=index)
   135	    (out_dir / "collections.json").write_text(json.dumps({"collections": collections}, indent=2) + "\n")
   136	    write_well_grids(out_dir, features)
   137	    print_sizes(out_dir)
   138	    write_tiles(out_dir) if out_dir == paths.CATALOG_DIR else None  # test builds into tmp dirs skip tiling
   139	    return {"records": len(records_out), "features": len(features), "collections": len(collections),
   140	            "starters": len(packs)}
   141	
   142	
   143	def published_starters(starters_dir: Path, recs: dict[str, dict], records_out: list[dict], vdir: Path,
   144	                       custody_dir: Path) -> list[dict]:
   145	    """The packs the site shows (E40): valid with every rule checked here, not unpublished; the rest on stderr."""
   146	    import sys
   147	
   148	    ev = starters.Evidence(recs, vdir, custody_dir)
   149	    joined = {r["id"]: r for r in records_out}
   150	    out = []
   151	    for p, doc, r in starters.check_dir(starters_dir, ev):
   152	        why = r.problems or [f"unchecked here: {u}" for u in r.unchecked]
   153	        if why:
   154	            for line in why:
   155	                print(f"starters: {p.name} not published: {line}", file=sys.stderr)
   156	            continue
   157	        if doc.get("unpublished") is True:
   158	            print(f"starters: {p.name} not published: it says unpublished", file=sys.stderr)
   159	            continue
   160	        held = ev.custody[0]
   161	        pack = json.loads(json.dumps(doc))
   162	        for t in pack["targets"]:
   163	            for a in t["artefacts"]:
   164	                a["href"] = held[a["key"]]["href"]
   165	        rec = joined[doc["record_id"]]
   166	        out.append({**pack, "record": {"title": rec["title"], "level": rec["level"]}})
   167	    return out
   168	
   169	
   170	def write_starters(out_dir: Path, starters_dir: Path, packs: list[dict]) -> None:
   171	    """starters.json, and the published pack documents and fidelity records copied byte for byte."""
   172	    docs = out_dir / "starters"
   173	    if docs.exists():
   174	        shutil.rmtree(docs)
   175	    for pack in packs:
   176	        for rel in (starters.file_name(pack["id"]), pack["fidelity"]):
   177	            (docs / rel).parent.mkdir(parents=True, exist_ok=True)
   178	            shutil.copyfile(starters_dir / rel, docs / rel)
   179	    (out_dir / "starters.json").write_text(json.dumps({"starters": packs}, indent=2, ensure_ascii=False) + "\n")
   180	
   181	
   182	def print_sizes(out_dir: Path) -> None:
   183	    """Items and bytes per Collection that has Items, then the totals (E32), on stderr."""
   184	    import sys
   185	
   186	    total_items = total_bytes = 0
   187	    for d in sorted(p for p in (out_dir / "stac").iterdir() if p.is_dir()):
   188	        size = items = 0
   189	        for parent, _, names in os.walk(d):
   190	            size += sum(os.stat(os.path.join(parent, n)).st_size for n in names)
   191	            items += len(names) if os.path.basename(parent) == "items" else 0
   192	        total_items, total_bytes = total_items + items, total_bytes + size
   193	        if items:
   194	            print(f"stac: {d.name} {items} Items, {size / 1e6:.1f} MB", file=sys.stderr)
   195	    print(f"stac: {total_items} Items, {(total_bytes + (out_dir / 'stac' / 'catalog.json').stat().st_size) / 1e6:.1f} MB"
   196	          f" in stac/; collections.json {(out_dir / 'collections.json').stat().st_size / 1e6:.1f} MB,"
   197	          f" records.json {(out_dir / 'records.json').stat().st_size / 1e6:.1f} MB", file=sys.stderr)
   198	
   199	
   200	# Wells below CLUSTER_BELOW_ZOOM (E36). The page draws clusters there from these grids, not from tiles:
   201	# per zoom z, the world is grid_cells(z) cells a side in Web Mercator (64 px at 512 px tiles, the
   202	# page's old cluster radius), and each row is one record's wells in one cell:
   203	#   [cx, cy, record index, exact count, approximate count, mean lon, mean lat]
   204	# The record, period and approximate filters stay on the page: it sums the rows it keeps per cell.
   205	# site/app.js CLUSTER_BELOW_ZOOM is the same number (tests/test_build.py).
   206	CLUSTER_BELOW_ZOOM = 7
   207	
   208	
   209	def grid_cells(z: int) -> int:
   210	    return 2 ** (z + 3)
   211	
   212	
   213	def is_well(f: dict) -> bool:
   214	    return f["properties"].get("kind") == "wellbore" and f["geometry"]["type"] == "Point"
   215	
   216	
   217	def grid_cell(lon: float, lat: float, n: int) -> tuple[int, int]:
   218	    import math
   219	
   220	    lat = max(-85.05112878, min(85.05112878, lat))
   221	    x = (lon + 180) / 360
   222	    y = (1 - math.log(math.tan(math.radians(lat)) + 1 / math.cos(math.radians(lat))) / math.pi) / 2
   223	    return min(n - 1, max(0, int(x * n))), min(n - 1, max(0, int(y * n)))
   224	
   225	
   226	def well_grid(features: list[dict], z: int) -> dict:
   227	    n = grid_cells(z)
   228	    records: dict[str, int] = {}
   229	    cells: dict[tuple, list] = {}
   230	    for f in features:
   231	        if not is_well(f):
   232	            continue
   233	        lon, lat = f["geometry"]["coordinates"][:2]
   234	        ri = records.setdefault(f["properties"]["record_id"], len(records))
   235	        c = cells.setdefault((*grid_cell(lon, lat, n), ri), [0, 0, 0.0, 0.0])
   236	        c[1 if f["properties"].get("approximate") else 0] += 1
   237	        c[2] += lon
   238	        c[3] += lat
   239	    rows = [[cx, cy, ri, e, a, round(lon / (e + a), 4), round(lat / (e + a), 4)]
   240	            for (cx, cy, ri), (e, a, lon, lat) in sorted(cells.items())]
   241	    return {"zoom": z, "cells": n, "records": list(records), "rows": rows}
   242	
   243	
   244	def write_well_grids(out_dir: Path, features: list[dict]) -> None:
   245	    import sys
   246	
   247	    for old in out_dir.glob("wells-z*.json"):
   248	        old.unlink()
   249	    size = 0
   250	    for z in range(CLUSTER_BELOW_ZOOM):
   251	        p = out_dir / f"wells-z{z}.json"
   252	        p.write_text(json.dumps(well_grid(features, z), separators=(",", ":")) + "\n")
   253	        size += p.stat().st_size
   254	    print(f"wells: wells-z0..z{CLUSTER_BELOW_ZOOM - 1}.json {sum(map(is_well, features))} wellbore points,"
   255	          f" {size / 1e3:.0f} kB", file=sys.stderr)
   256	
   257	
   258	# Tiling (E15). One source layer, "outlines", every GeoJSON property kept. Points are kept at every
   259	# zoom they are in (-r1); wellbore points start at CLUSTER_BELOW_ZOOM (E36, the filter below), the
   260	# page clusters them under it from the grids. One run z0-12, lines and polygons unsimplified at every
   261	# zoom (E36: E15's two runs, simplified below z8 and joined, took 25 s more of the gate's build for
   262	# 75 kB less in all). Pinned in CI: Ubuntu tippecanoe 2.79.0-1 (E32: before 2.55.0 the
   263	# string pool wrote one string for another whose hash shared its low 32 bits, tests/fixtures/tiles/).
   264	TIPPECANOE_PIN = "2.79.0"
   265	TILE_ZOOMS = ["-Z0", "-z12", "--no-line-simplification"]
   266	TILE_WELLS_FROM = {"*": ["any", ["!=", "kind", "wellbore"], ["!=", "$type", "Point"],
   267	                         [">=", "$zoom", CLUSTER_BELOW_ZOOM]]}
   268	TILE_COMMON = ["-q", "-f", "-l", "outlines", "-r1", "--no-feature-limit", "--no-tile-size-limit",
   269	               "--no-tiny-polygon-reduction", "-j", json.dumps(TILE_WELLS_FROM)]
   270	
   271	
   272	def write_tiles(out_dir: Path, cache_dir: Path = paths.BUILD_DIR / "tiles") -> Path | None:
   273	    """out_dir/outlines.pmtiles from out_dir/outlines.geojson, or None with a notice when
   274	    tippecanoe is absent (the page then reads the GeoJSON whole). Cached by input and tool version,
   275	    so a second build of the same outlines (the site test's) costs a copy."""
   276	    import hashlib
   277	    import shutil
   278	    import subprocess
   279	    import sys
   280	    import tempfile
   281	
   282	    src, dst = out_dir / "outlines.geojson", out_dir / "outlines.pmtiles"
   283	    dst.unlink(missing_ok=True)
   284	    if not shutil.which("tippecanoe"):
   285	        print("notice: tippecanoe not found, outlines.pmtiles not written; the map reads outlines.geojson "
   286	              f"whole (install tippecanoe {TIPPECANOE_PIN}, see .github/workflows/ci.yml)", file=sys.stderr)
   287	        return None
   288	    version = subprocess.run(["tippecanoe", "--version"], capture_output=True, text=True, check=False).stderr.strip()
   289	    key = hashlib.sha256(src.read_bytes())
   290	    key.update(json.dumps([version, TILE_ZOOMS, TILE_COMMON]).encode())
   291	    cached = cache_dir / f"outlines-{key.hexdigest()[:16]}.pmtiles"
   292	    if not cached.exists():
   293	        cache_dir.mkdir(parents=True, exist_ok=True)
   294	        with tempfile.TemporaryDirectory() as tmp:
   295	            tiles = Path(tmp) / "outlines.pmtiles"
   296	            r = subprocess.run(["tippecanoe", *TILE_COMMON, *TILE_ZOOMS, "-o", str(tiles), str(src)],
   297	                               capture_output=True, text=True, check=False)
   298	            if r.returncode:
   299	                raise RuntimeError(f"tippecanoe failed: {r.stderr}")
   300	            for old in cache_dir.glob("outlines-*.pmtiles"):
   301	                old.unlink()
   302	            shutil.move(tiles, cached)
   303	    shutil.copyfile(cached, dst)
   304	    note = "" if TIPPECANOE_PIN in version else f" (CI pins {TIPPECANOE_PIN})"
   305	    print(f"tiles: {dst.name} {dst.stat().st_size / 1e6:.1f} MB, z0-12, {version}{note}", file=sys.stderr)
   306	    return dst
     1	{
     2	  "$schema": "https://json-schema.org/draft/2020-12/schema",
     3	  "$id": "https://open-subsurface-data.org/schema/record/5",
     4	  "title": "Open Subsurface Data record, version 4",
     5	  "description": "One dataset as published by its owner. Facts about the dataset, never facts produced by our tools: verification levels, checksums and outlines live in build output, not here. Version 2 adds `inputs` and the optional `period` (E04, additive); every version-1 record is a valid version-2 record. Version 3 (E19, additive) adds the kind `potential-fields`, the access `purchase` and the optional `licence.terms`; every version-2 record is a valid version-3 record. Version 4 (E26, additive) adds the kinds `velocity-model`, `geological-model`, `airborne-em`, `radiometrics` and `stress`; every version-3 record is a valid version-4 record.",
     6	  "type": "object",
     7	  "additionalProperties": false,
     8	  "required": ["id", "title", "publisher", "origin", "licence", "kinds", "region", "listed_by", "added"],
     9	  "properties": {
    10	    "id": {
    11	      "type": "string",
    12	      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*/[a-z0-9]+(-[a-z0-9]+)*$",
    13	      "description": "publisher-slug/dataset-slug; stable forever, also the file path records/<id>.yaml"
    14	    },
    15	    "title": {"type": "string", "minLength": 3, "maxLength": 120},
    16	    "summary": {"type": "string", "maxLength": 600, "description": "Two or three sentences in the publisher's own terms."},
    17	    "publisher": {
    18	      "type": "object", "additionalProperties": false, "required": ["name", "url"],
    19	      "properties": {
    20	        "name": {"type": "string"},
    21	        "url": {"type": "string", "format": "uri"},
    22	        "country": {"type": "string", "pattern": "^[A-Z]{2}$", "description": "ISO 3166-1 alpha-2"}
    23	      }
    24	    },
    25	    "origin": {
    26	      "type": "object", "additionalProperties": false, "required": ["url", "access"],
    27	      "properties": {
