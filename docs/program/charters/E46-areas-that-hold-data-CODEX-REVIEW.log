    99	def load_outline(path: Path) -> dict:
   100	    return json.loads(path.read_text())
   101	
   102	
   103	def validate_outlines(
   104	    outlines_dir: Path = paths.OUTLINES_DIR, records_dir: Path = paths.RECORDS_DIR
   105	) -> list[Problem]:
   106	    """Each outline file is a FeatureCollection whose features carry the outline properties
   107	    and name an existing record; the file name must match that record. Geometry is WGS84 with
   108	    closed, non-empty rings; a feature_id is '<record-id>#...' and unique in its file; a derived
   109	    feature names an input the collection carries and has a licence (its own or the file's)."""
   110	    problems: list[Problem] = []
   111	    v = _validator("outline")
   112	    vc = Draft202012Validator(_schema("outline")["$defs"]["collection"], format_checker=FormatChecker())
   113	    known = set(load_records(records_dir))
   114	    for p in sorted(outlines_dir.glob("*.geojson")):
   115	        rel = p.name
   116	        try:
   117	            fc = load_outline(p)
   118	        except (OSError, ValueError) as e:
   119	            problems.append(Problem(rel, f"unreadable: {e}"))
   120	            continue
   121	        if fc.get("type") != "FeatureCollection":
   122	            problems.append(Problem(rel, "not a FeatureCollection"))
   123	            continue
   124	        expected_id = p.stem.replace("__", "/")
   125	        ids: dict[str, int] = {}
   126	        for err in vc.iter_errors({k: x for k, x in fc.items() if k not in ("type", "features")}):
   127	            problems.append(Problem(rel, f"collection: {err.message}"))
   128	        named = fc.get("inputs") if isinstance(fc.get("inputs"), dict) else {}
   129	        if expected_id not in known:
   130	            problems.append(Problem(rel, f"no record '{expected_id}' for this outline file"))
   131	        for i, f in enumerate(fc.get("features", [])):
   132	            props = f.get("properties", {})
   133	            for err in v.iter_errors(props):
   134	                problems.append(Problem(rel, f"feature {i}: {err.message}"))
   135	            if props.get("record_id") != expected_id:
   136	                problems.append(
   137	                    Problem(rel, f"feature {i}: record_id '{props.get('record_id')}' != '{expected_id}'")
   138	                )
   139	            for msg in geometry_problems(f.get("geometry") or {}):
   140	                problems.append(Problem(rel, f"feature {i}: {msg}"))
   141	            if props.get("approximate") is False:
   142	                if "input" in props and props["input"] not in named:
   143	                    problems.append(Problem(rel, f"feature {i}: input '{props['input']}' is not in the collection's inputs"))
   144	                if not (props.get("licence") or fc.get("licence")):
   145	                    problems.append(Problem(rel, f"feature {i}: no licence (the feature's or the collection's)"))
   146	            fid = props.get("feature_id")
   147	            if fid is not None:
   148	                if not str(fid).startswith(expected_id + "#"):
   149	                    problems.append(Problem(rel, f"feature {i}: feature_id '{fid}' is not '{expected_id}#...'"))
   150	                if fid in ids:
   151	                    problems.append(Problem(rel, f"feature {i}: duplicate feature_id '{fid}' (also feature {ids[fid]})"))
   152	                ids.setdefault(fid, i)
   153	    return problems
   154	
   155	
   156	def _position_problem(p) -> str | None:
   157	    if not (isinstance(p, list) and len(p) in (2, 3)
   158	            and all(isinstance(c, (int, float)) and not isinstance(c, bool) for c in p)):
   159	        return f"position {p!r} is not [lon, lat]"
   160	    if not (-180 <= p[0] <= 180 and -90 <= p[1] <= 90):
   161	        return f"position {p!r} outside WGS84 lon/lat"
   162	    return None
   163	
   164	
   165	def _ring_problems(ring) -> list[str]:
   166	    if not isinstance(ring, list) or len(ring) < 4:
   167	        return ["ring has fewer than 4 positions"]
   168	    out = [m for m in map(_position_problem, ring) if m][:1]
   169	    if not out and ring[0] != ring[-1]:
   170	        out.append("ring is not closed")
   171	    return out
   172	
   173	
   174	def _line_problems(line) -> list[str]:
   175	    if not isinstance(line, list) or len(line) < 2:
   176	        return ["line has fewer than 2 positions"]
   177	    return [m for m in map(_position_problem, line) if m][:1]
   178	
   179	
   180	def geometry_problems(g: dict) -> list[str]:
   181	    """WGS84 positions, closed non-empty rings, lines of at least two positions."""
   182	    t, c = g.get("type"), g.get("coordinates")
   183	    if t == "Point":
   184	        m = _position_problem(c)
   185	        return [m] if m else []
   186	    if t == "LineString":
   187	        return _line_problems(c)
   188	    if t == "MultiPoint":   # E29: an Esri multipoint; each part as a Point
   189	        if not isinstance(c, list) or not c:
   190	            return ["multipoint has no positions"]
   191	        return [m for m in map(_position_problem, c) if m][:1]
   192	    if t == "MultiLineString":   # E29: an Esri polyline with several paths; each part as a LineString
   193	        if not isinstance(c, list) or not c:
   194	            return ["multilinestring has no lines"]
   195	        return [m for line in c for m in _line_problems(line)][:1]
   196	    if t == "Polygon":
   197	        if not isinstance(c, list) or not c:
   198	            return ["polygon has no rings"]
   199	        return [m for r in c for m in _ring_problems(r)][:1]
   200	    if t == "MultiPolygon":
   201	        if not isinstance(c, list) or not c or not all(isinstance(p, list) and p for p in c):
   202	            return ["multipolygon has an empty part"]
   203	        return [m for p in c for r in p for m in _ring_problems(r)][:1]
   204	    return [f"geometry type {t!r} not allowed"]
