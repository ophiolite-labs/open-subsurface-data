   142	
   143	def published_starters(starters_dir: Path, recs: dict[str, dict], records_out: list[dict], vdir: Path,
   144	                       custody_dir: Path) -> list[dict]:
   145	    """The packs the site shows (E40): valid with every rule checked here, not unpublished; the rest on stderr."""
   146	    import sys
   147	
   148	    ev = starters.Evidence(recs, vdir, custody_dir)
   149	    joined = {r["id"]: r for r in records_out}
   150	    out = []
   151	    for p, doc, r in starters.check_dir(starters_dir, ev):
   152	        why = r.problems or [f"unchecked here: {u}" for u in r.unchecked]
   153	        if why:
   154	            for line in why:
   155	                print(f"starters: {p.name} not published: {line}", file=sys.stderr)
   156	            continue
   157	        if doc.get("unpublished") is True:
   158	            print(f"starters: {p.name} not published: it says unpublished", file=sys.stderr)
   159	            continue
   160	        held = ev.custody[0]
   161	        pack = json.loads(json.dumps(doc))
   162	        for t in pack["targets"]:
   163	            for a in t["artefacts"]:
   164	                a["href"] = held[a["key"]]["href"]
   165	        rec = joined[doc["record_id"]]
   166	        out.append({**pack, "record": {"title": rec["title"], "level": rec["level"]}})
   167	    return out
