    27	def cmd_validate(a: argparse.Namespace) -> int:
    28	    """Records, outlines and the starter packs (E40); with documents given, those starter documents alone,
    29	    wherever they are (Ophiolite E129 runs `osd validate <pack>.json` before and after its upload)."""
    30	    records_dir, starters_dir = Path(a.records), Path(a.starters)
    31	    ev = starters_mod.Evidence(load_records(records_dir), Path(a.vdir), Path(a.custody))
    32	    problems = [] if a.documents else validate_records(records_dir) + validate_outlines(Path(a.outlines), records_dir)
    33	    for p in problems:
    34	        print(f"  {p}")
    35	    if a.documents:
    36	        checked = []
    37	        for d in map(Path, a.documents):
    38	            try:
    39	                doc = json.loads(d.read_text())
    40	            except (OSError, ValueError) as e:
    41	                checked.append((d, starters_mod.Result(problems=[str(e)])))
    42	                continue
    43	            inside = d.parent.resolve() == starters_dir.resolve()
    44	            checked.append((d, starters_mod.check(doc, ev, d.parent, d.name if inside else None) if isinstance(doc, dict)
    45	                            else starters_mod.Result(problems=["(root): not an object"])))
    46	    else:
    47	        checked = [(p, r) for p, _, r in starters_mod.check_dir(starters_dir, ev)]
    48	    bad = 0
    49	    for p, r in checked:
    50	        bad += len(r.problems)
    51	        for line in r.problems:
    52	            print(f"  {p}: {line}")
    53	        for line in r.unchecked:
    54	            print(f"  {p}: unchecked here: {line}")
    55	        for line in r.notes:
    56	            print(f"  {p}: note: {line}")
    57	    if a.documents:
    58	        print(f"{len(checked)} starter documents, {bad} problems")
    59	    else:
    60	        print(f"{len(load_records(records_dir))} records, {len(checked)} starter packs, {len(problems) + bad} problems")
    61	    return 1 if problems or bad else 0
    62	
