   302	def _inside(p: list, ring: list) -> bool:
   303	    x, y, hit = p[0], p[1], False
   304	    for a, b in itertools.pairwise(ring):
   305	        if (a[1] > y) != (b[1] > y) and x < a[0] + (y - a[1]) * (b[0] - a[0]) / (b[1] - a[1]):
   306	            hit = not hit
   307	    return hit
