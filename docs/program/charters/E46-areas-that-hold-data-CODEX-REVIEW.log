    63	
    64	def test_record_ids_are_versioned():
    65	    assert RECORD.schema["$id"].endswith("/record/5") and RECORD_4.schema["$id"].endswith("/record/4")
    66	    assert RECORD_3.schema["$id"].endswith("/record/3")
    67	    assert RECORD_2.schema["$id"].endswith("/record/2")
    68	
    69	
    70	def test_record_3_admits_the_new_values():
    71	    assert _errors(_base(kinds=["potential-fields"])) == []
    72	    assert _errors(_base(access="purchase")) == []
    73	    assert _errors(_base(access="purchase", terms=TERMS)) == []
    74	    assert _errors(_base(terms={"stated": "Licence runs until 31 December 2030.", "expires": "2030-12-31"})) == []
    75	    assert _errors(_base(terms={"stated": "Terms as published.", "duration": None,
    76	                                "review_before_publication": None, "expires": None})) == []
    77	    assert _errors(_base(terms={"stated": "Only the words."})) == []
    78	
    79	
    80	def test_terms_without_stated_refused():
    81	    assert _errors(_base(terms={k: x for k, x in TERMS.items() if k != "stated"}))
    82	    assert _errors(_base(terms={"stated": ""}))
