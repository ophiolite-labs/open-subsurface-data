    24	
    25	    def cross(o, a, b):
    26	        return (a[0] - o[0]) * (b[1] - o[1]) - (a[1] - o[1]) * (b[0] - o[0])
    27	
    28	    lower, upper = [], []
    29	    for p in pts:
    30	        while len(lower) >= 2 and cross(lower[-2], lower[-1], p) <= 0:
    31	            lower.pop()
    32	        lower.append(p)
    33	    for p in reversed(pts):
    34	        while len(upper) >= 2 and cross(upper[-2], upper[-1], p) <= 0:
    35	            upper.pop()
    36	        upper.append(p)
    37	    hull = lower[:-1] + upper[:-1]
    38	    if len(hull) < 3:
    39	        raise Refused("every position lies on one line: no area to outline")
    40	    return hull
