    83	def build(out_dir: Path = paths.CATALOG_DIR, vdir: Path = paths.VERIFICATION_DIR,
    84	          now: datetime | None = None, mirror_dir: Path = mirror.MIRROR_DIR,
    85	          records_dir: Path = paths.RECORDS_DIR, source_commit: str | None = FROM_ENVIRONMENT,
    86	          verification_commit: str | None = FROM_ENVIRONMENT, starters_dir: Path = starters.STARTERS_DIR) -> dict:
    87	    out_dir.mkdir(parents=True, exist_ok=True)
    88	    recs = load_records(records_dir)
    89	    records_out = []
    90	    reasons = {}
    91	    features = []
    92	    for rid, rec in recs.items():
    93	        v = latest_verification(rid, vdir)
    94	        level = v["level"] if v else "L0"
    95	        checked = v["checked_at"] if v else None
    96	        blocked = (v or {}).get("origin", {}).get("blocked_since")
    97	        joined = dict(rec, level=level, checked_at=checked, stale=is_stale(checked, now), blocked_since=blocked)
    98	        reasons[rid] = reason(v, rec)
    99	        records_out.append(joined)
   100	        op = paths.outline_path(rid)
   101	        if op.exists():
   102	            for f in load_outline(op)["features"]:
   103	                # E18: a feature's dates are its STAC Item's, not map attributes (tippecanoe 2.49
   104	                # wrote other features' values into three tiles with them: evidence/e18/registers.md)
   105	                props = {k: v for k, v in f["properties"].items() if not k.startswith("osd:period_")}
   106	                props.update({
   107	                    "title": rec["title"], "publisher": rec["publisher"]["name"],
   108	                    "kinds": rec["kinds"], "licence": rec["licence"]["name"],
   109	                    "redistribution": rec["licence"]["redistribution"], "level": level,
   110	                })
   111	                fid = {"id": props["feature_id"]} if "feature_id" in props else {}
   112	                features.append({"type": "Feature", **fid, "properties": props, "geometry": f["geometry"]})
   113	    packs = published_starters(starters_dir, recs, records_out, vdir, mirror_dir / "custody")
   114	    for r in records_out:
   115	        ids = sorted(p["id"] for p in packs if p["record_id"] == r["id"])
   116	        if ids:
   117	            r["starters"] = ids
   118	    catalog = {
   119	        "source_commit": git_head() if source_commit == FROM_ENVIRONMENT else source_commit,
   120	        "verification_commit": (verification_commit_from_env() if verification_commit == FROM_ENVIRONMENT
   121	                                else verification_commit),
   122	        "built_at": (now or datetime.now(UTC)).strftime("%Y-%m-%dT%H:%M:%SZ"),
   123	        "records_digest": records_digest(records_out),
   124	    }
   125	    (out_dir / "records.json").write_text(json.dumps(
   126	        {"tool_version": __version__, "count": len(records_out), "catalog": catalog, "records": records_out,
   127	         "reasons": reasons},
   128	        indent=2) + "\n")
   129	    (out_dir / "outlines.geojson").write_text(json.dumps(
   130	        {"type": "FeatureCollection", "features": features}) + "\n")
   131	    write_starters(out_dir, starters_dir, packs)
   132	    index = mirror.public_index(mirror_dir / "custody")
   133	    (out_dir / "mirror.json").write_text(json.dumps({"copies": index}, indent=2) + "\n")
   134	    collections = stac.write_catalog(out_dir, records_out, vdir, mirror_index=index)
   135	    (out_dir / "collections.json").write_text(json.dumps({"collections": collections}, indent=2) + "\n")
   136	    write_well_grids(out_dir, features)
   137	    print_sizes(out_dir)
   138	    write_tiles(out_dir) if out_dir == paths.CATALOG_DIR else None  # test builds into tmp dirs skip tiling
   139	    return {"records": len(records_out), "features": len(features), "collections": len(collections),
   140	            "starters": len(packs)}
