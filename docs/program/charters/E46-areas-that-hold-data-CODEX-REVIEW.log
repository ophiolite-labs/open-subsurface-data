   170	def write_starters(out_dir: Path, starters_dir: Path, packs: list[dict]) -> None:
   171	    """starters.json, and the published pack documents and fidelity records copied byte for byte."""
   172	    docs = out_dir / "starters"
   173	    if docs.exists():
   174	        shutil.rmtree(docs)
   175	    for pack in packs:
   176	        for rel in (starters.file_name(pack["id"]), pack["fidelity"]):
   177	            (docs / rel).parent.mkdir(parents=True, exist_ok=True)
   178	            shutil.copyfile(starters_dir / rel, docs / rel)
   179	    (out_dir / "starters.json").write_text(json.dumps({"starters": packs}, indent=2, ensure_ascii=False) + "\n")
