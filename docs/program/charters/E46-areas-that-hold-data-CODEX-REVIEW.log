   128	def terms_note(rec: dict, now: datetime | None = None) -> str:
   129	    """"terms expire D" for a publisher-stated absolute `licence.terms.expires` (record/3, E19). The
   130	    date is a UTC calendar day and the terms hold through its end; nothing is computed from a
   131	    duration. Empty when the record states no date."""
   132	    x = (rec.get("licence", {}).get("terms") or {}).get("expires")
   133	    if x is None:
   134	        return ""
   135	    try:
   136	        if not isinstance(x, date) and not re.fullmatch(r"[0-9]{4}-[0-9]{2}-[0-9]{2}", str(x)):
   137	            raise ValueError(x)
   138	        day = x if isinstance(x, date) else date.fromisoformat(x)
   139	    except ValueError:
   140	        return f"terms expire ? ({x!r} is not a date)"
   141	    today = (now or datetime.now(UTC)).astimezone(UTC).date()
   142	    if today > day:
   143	        return f"terms expired {day.isoformat()}"
   144	    return f"terms expire {day.isoformat()}" + (" (today)" if today == day else "")
   145	
   146	
   147	def status_lines(vdir: Path = paths.VERIFICATION_DIR, now: datetime | None = None,
   148	                 records_dir: Path = paths.RECORDS_DIR) -> list[str]:
   149	    """The levels `osd build` publishes, read from the same verification directory; an L4 shows
   150	    its coverage beside it, "L4 (2 of 2 converted)" (E09), and a stated expiry of the terms,
   151	    "L1 (terms expire 2027-01-01)" (E19); every line ends with the reason, the string records.json
   152	    carries (osd.reasons, E23/E27)."""
   153	    rows = []
   154	    for rid, r in load_records(records_dir).items():
   155	        v = build_mod.latest_verification(rid, vdir)
   156	        lv, checked = (v["level"], v["checked_at"]) if v else ("L0", None)
   157	        coverage = conversion_coverage(v)
   158	        lv += f" ({coverage})" if coverage else ""
   159	        terms = terms_note(r, now)
   160	        lv += f" ({terms})" if terms else ""
   161	        when = (checked or "never")[:10] + (" stale" if is_stale(checked, now) else "")
   162	        blocked = (v or {}).get("origin", {}).get("blocked_since")
   163	        when += f" blocked since {blocked[:10]}" if blocked else ""
   164	        rows.append((lv, (f"{rid:36} {when:36} {r['origin']['access']:12} "
   165	                          f"{r['licence']['redistribution']:14}"), ",".join(r["kinds"]), reasons_mod.reason(v, r)))
   166	    w = max([5] + [len(lv) for lv, *_ in rows])
   167	    k = max([5] + [len(kinds) for _, _, kinds, _ in rows])
   168	    return ([f"{'level':{w}} {'id':36} {'checked':36} {'access':12} {'redistribution':14} {'kinds':{k}} reason"]
   169	            + [f"{lv:{w}} {rest} {kinds:{k}} {why}".rstrip() for lv, rest, kinds, why in rows])
   170	
   171	
   172	def cmd_status(_: argparse.Namespace) -> int:
   173	    print("\n".join(status_lines()))
   174	    return 0
