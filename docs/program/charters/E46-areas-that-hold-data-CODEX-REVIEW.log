    32	def record_files(records_dir: Path = paths.RECORDS_DIR) -> list[Path]:
    33	    return sorted(records_dir.glob("*/*.yaml"))
    34	
    35	
    36	def load_record(path: Path) -> dict:
    37	    data = yaml.safe_load(path.read_text())
    38	    if not isinstance(data, dict):
    39	        raise TypeError(f"{path}: not a mapping")
    40	    # dates: yaml parses 2026-10-23 into a date; the schema wants the ISO string
    41	    if "added" in data and not isinstance(data["added"], str):
    42	        data["added"] = data["added"].isoformat()
    43	    # period: unquoted 1993-06-30 is a date and 1993 an int; the schema wants the strings
    44	    period = data.get("period")
    45	    if isinstance(period, dict):
    46	        for k in ("start", "end"):
    47	            x = period.get(k)
    48	            if hasattr(x, "isoformat"):
    49	                period[k] = x.isoformat()
    50	            elif isinstance(x, int) and not isinstance(x, bool):
    51	                period[k] = str(x)
    52	    # licence.terms.expires: unquoted 2030-12-31 is a date; the schema wants the string
    53	    terms = (data.get("licence") or {}).get("terms")
    54	    if isinstance(terms, dict):
    55	        x = terms.get("expires")
    56	        if hasattr(x, "isoformat"):
    57	            terms["expires"] = x.isoformat()
    58	        elif isinstance(x, int) and not isinstance(x, bool):
    59	            terms["expires"] = str(x)
    60	    return data
    61	
    62	
    63	def load_records(records_dir: Path = paths.RECORDS_DIR) -> dict[str, dict]:
    64	    out: dict[str, dict] = {}
    65	    for p in record_files(records_dir):
    66	        rec = load_record(p)
    67	        out[rec.get("id", str(p))] = rec
    68	    return out
