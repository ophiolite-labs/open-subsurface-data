    15	@dataclass(frozen=True)
    16	class Problem:
    17	    path: str
    18	    message: str
    19	
    20	    def __str__(self) -> str:
    21	        return f"{self.path}: {self.message}"
    22	
    23	
    24	def _schema(name: str) -> dict:
    25	    return json.loads((paths.SCHEMA_DIR / f"{name}.schema.json").read_text())
    26	
    27	
    28	def _validator(name: str) -> Draft202012Validator:
    29	    return Draft202012Validator(_schema(name), format_checker=FormatChecker())
