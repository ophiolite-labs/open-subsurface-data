   183	    rel = str(out.relative_to(paths.RECORDS_DIR))
   184	    todo: dict[str, str] = {}  # field -> its last problem (an enum's choices beat "not a string")
   185	    for p in validate_records(paths.RECORDS_DIR):
   186	        if p.path == rel:
   187	            field, _, why = p.message.partition(": ")
   188	            todo[field] = why
   189	    print(f"wrote {out}; {len(todo)} fields for a human to fill from the publisher's page:")
   190	    for field, why in todo.items():
   191	        print(f"  {field}: {why}")
   192	    return 0
