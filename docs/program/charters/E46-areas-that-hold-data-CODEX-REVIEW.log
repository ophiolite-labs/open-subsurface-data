   211	               else manifest_mod.from_catalog(a.ids, Path(a.catalog), a.catalog_url))
   212	    except manifest_mod.ManifestError as e:
   213	        print(f"refused: {e}")
   214	        return 1
   215	    out = manifest_mod.write(doc, Path(a.out))
   216	    n = sum(len(e["assets"]) for e in doc["entries"])
   217	    todo = sum(1 for e in doc["entries"] if not e["assets"])
   218	    print(f"wrote {out}: {len(doc['entries'])} {doc['selection']}, {n} assets, {todo} to-do")
