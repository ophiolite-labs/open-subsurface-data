    70	
    71	def validate_records(records_dir: Path = paths.RECORDS_DIR) -> list[Problem]:
    72	    """Schema validity plus the two consistency rules a schema cannot express."""
    73	    problems: list[Problem] = []
    74	    v = _validator("record")
    75	    seen: dict[str, Path] = {}
    76	    for p in record_files(records_dir):
    77	        rel = str(p.relative_to(records_dir))
    78	        try:
    79	            rec = load_record(p)
    80	        except (OSError, TypeError, yaml.YAMLError) as e:
    81	            problems.append(Problem(rel, f"unreadable: {e}"))
    82	            continue
    83	        for err in sorted(v.iter_errors(rec), key=lambda e: list(e.path)):
    84	            where = "/".join(str(x) for x in err.path) or "<root>"
    85	            problems.append(Problem(rel, f"{where}: {err.message}"))
    86	        rid = rec.get("id")
    87	        if isinstance(rid, str):
    88	            if rid + ".yaml" != rel:
    89	                problems.append(Problem(rel, f"id '{rid}' does not match the file path"))
    90	            if rid in seen:
    91	                problems.append(Problem(rel, f"duplicate id '{rid}' (also {seen[rid].name})"))
    92	            seen[rid] = p
    93	        lic = rec.get("licence", {})
    94	        if lic.get("share_alike") and lic.get("redistribution") == "forbidden":
    95	            problems.append(Problem(rel, "share_alike with redistribution forbidden is contradictory"))
    96	    return problems
