   234	def cmd_mirror_eligible(a: argparse.Namespace) -> int:
   235	    rules, n, total = mirror_mod.load_rules(), 0, 0
   236	    for rid, rec in load_records().items():
   237	        if a.ids and rid not in a.ids:
   238	            continue
   239	        e = mirror_mod.eligibility(rec, build_mod.latest_verification(rid, Path(a.vdir)), rules.get(rid))
   240	        n, total = n + e.eligible, total + (e.bytes if e.eligible else 0)
   241	        why = f"{len(e.files)} files, {e.bytes} bytes" if e.eligible else "; ".join(e.reasons)
   242	        print(f"  {'eligible' if e.eligible else 'no':8} {rid:40} {why}")
   243	    print(f"{n} eligible, {total} bytes of inventory")
   244	    return 0
