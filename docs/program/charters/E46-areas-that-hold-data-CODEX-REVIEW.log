   181	
   182	def print_sizes(out_dir: Path) -> None:
   183	    """Items and bytes per Collection that has Items, then the totals (E32), on stderr."""
   184	    import sys
   185	
   186	    total_items = total_bytes = 0
   187	    for d in sorted(p for p in (out_dir / "stac").iterdir() if p.is_dir()):
   188	        size = items = 0
   189	        for parent, _, names in os.walk(d):
   190	            size += sum(os.stat(os.path.join(parent, n)).st_size for n in names)
   191	            items += len(names) if os.path.basename(parent) == "items" else 0
   192	        total_items, total_bytes = total_items + items, total_bytes + size
   193	        if items:
   194	            print(f"stac: {d.name} {items} Items, {size / 1e6:.1f} MB", file=sys.stderr)
   195	    print(f"stac: {total_items} Items, {(total_bytes + (out_dir / 'stac' / 'catalog.json').stat().st_size) / 1e6:.1f} MB"
   196	          f" in stac/; collections.json {(out_dir / 'collections.json').stat().st_size / 1e6:.1f} MB,"
   197	          f" records.json {(out_dir / 'records.json').stat().st_size / 1e6:.1f} MB", file=sys.stderr)
