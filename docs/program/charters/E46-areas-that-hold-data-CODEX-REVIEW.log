    64	def cmd_fidelity(a: argparse.Namespace) -> int:
    65	    """osd verify <id> --fidelity-from F: offline, the L4 rule (E09). Writes the verification back."""
    66	    if len(a.ids) != 1:
    67	        print("refused: --fidelity-from takes exactly one record id, the record the fidelity is for")
    68	        return 2
    69	    (rid,) = a.ids
    70	    vdir = Path(a.vdir)
    71	    try:
    72	        doc = json.loads(Path(a.fidelity_from).read_text())
    73	    except (OSError, ValueError) as e:
    74	        print(f"refused: {a.fidelity_from}: {e}")
    75	        return 1
    76	    v, reasons = apply_fidelity(rid, doc if isinstance(doc, dict) else {}, build_mod.latest_verification(rid, vdir))
    77	    if v is None:
    78	        print(f"refused: {reasons[0]}")
    79	        return 1
    80	    verify_mod._validator().validate(v)   # never write a record the schema refuses
    81	    (vdir / (rid.replace("/", "__") + ".json")).write_text(json.dumps(v, indent=2) + "\n")
    82	    c = next(c for c in v["checks"] if c["name"] == "canonical-conversion")
    83	    if c["outcome"] == "fail":
    84	        for r in reasons:
    85	            print(f"  {v['level']}  {rid}  fidelity rejected: {r}")
    86	        return 1
    87	    print(f"  {v['level']}  {rid}  canonical-conversion: pass ({c['detail']})")
    88	    for r in reasons:
    89	        print(f"  {v['level']}  {rid}  L4 not awarded: {r}")
    90	    return 0
