   195	def cmd_report(a: argparse.Namespace) -> int:
   196	    issues = report_mod.read_issues(Path(a.open_issues) if a.open_issues else None)
   197	    verified = "all" if a.verified.strip() in ("", "all") else set(a.verified.split())
   198	    r = report_mod.report(Path(a.before), Path(a.after), issues, verified, a.run_url)
   199	    print("\n".join(report_mod.report_lines(r, a.dry_run)))
   200	    if a.out:  # the workflow reads .open[] and .recovered[] (and mutates nothing on a dry run)
   201	        Path(a.out).write_text(json.dumps({"open": r["open"], "recovered": r["recovered"]}, indent=2) + "\n")
   202	    return 0
