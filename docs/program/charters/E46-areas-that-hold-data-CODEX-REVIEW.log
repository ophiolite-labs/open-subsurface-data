    43	def _base(**kw) -> dict:
    44	    rec = {"id": "acme/demo", "title": "Demo set", "publisher": {"name": "Acme", "url": "https://acme.example"},
    45	           "origin": {"url": "https://acme.example/demo", "access": "anonymous"},
    46	           "licence": {"name": "Acme terms", "spdx": None, "redistribution": "forbidden", "attribution": "unknown"},
    47	           "kinds": ["seismic-3d"], "region": {"country": "NL"}, "listed_by": ["publisher"], "added": "2026-10-23"}
    48	    for k, x in kw.items():
    49	        if k == "access":
    50	            rec["origin"]["access"] = x
    51	        elif k == "terms":
    52	            rec["licence"]["terms"] = x
    53	        else:
    54	            rec[k] = x
    55	    return rec
