    93	def cmd_verify(a: argparse.Namespace) -> int:
    94	    if a.fidelity_from:
    95	        return cmd_fidelity(a)
    96	    ids = a.ids or None
    97	    if a.shard is not None:  # H2: the records whose origin host hashes to shard I of N
    98	        if a.ids:
    99	            print("refused: --shard selects the records itself; give either ids or --shard")
   100	            return 2
   101	        try:
   102	            i, n = shards_mod.parse(a.shard)
   103	        except ValueError as e:
   104	            print(f"refused: {e}")
   105	            return 2
   106	        ids = shards_mod.select(load_records(), i, n)
   107	        print(f"shard {i}/{n}: {len(ids)} records")
   108	    results = verify_all(ids=ids, derive=a.outlines, fetch_inputs=a.outline_inputs) if ids != [] else []
   109	    for v in results:
   110	        o = v["origin"]
   111	        l2 = "; ".join(f"{c['name']}: {c['outcome']} ({c.get('detail', '')})" for c in v["checks"] if c["level"] == "L2")
   112	        l3 = "; ".join(f"{c['name']}: {c['outcome']} ({c.get('detail', '')})" for c in v["checks"] if c["level"] == "L3")
   113	        l1 = next((c.get("detail", "") for c in v["checks"] if c["name"] == "origin-reachable"), "")
   114	        print(f"  {v['level']}  {v['record_id']}  (origin {o.get('reachability')} HTTP {o.get('http_status')}: {l1}; "
   115	              f"{l2}; {l3})")
   116	    print(f"{len(results)} verified -> {paths.VERIFICATION_DIR}")
   117	    if a.ids_out:
   118	        Path(a.ids_out).write_text("".join(v["record_id"] + "\n" for v in results))
   119	    return 0
