   200	# Wells below CLUSTER_BELOW_ZOOM (E36). The page draws clusters there from these grids, not from tiles:
   201	# per zoom z, the world is grid_cells(z) cells a side in Web Mercator (64 px at 512 px tiles, the
   202	# page's old cluster radius), and each row is one record's wells in one cell:
   203	#   [cx, cy, record index, exact count, approximate count, mean lon, mean lat]
   204	# The record, period and approximate filters stay on the page: it sums the rows it keeps per cell.
   205	# site/app.js CLUSTER_BELOW_ZOOM is the same number (tests/test_build.py).
   206	CLUSTER_BELOW_ZOOM = 7
   207	
   208	
   209	def grid_cells(z: int) -> int:
   210	    return 2 ** (z + 3)
   211	
   212	
   213	def is_well(f: dict) -> bool:
   214	    return f["properties"].get("kind") == "wellbore" and f["geometry"]["type"] == "Point"
   215	
   216	
   217	def grid_cell(lon: float, lat: float, n: int) -> tuple[int, int]:
   218	    import math
   219	
   220	    lat = max(-85.05112878, min(85.05112878, lat))
   221	    x = (lon + 180) / 360
   222	    y = (1 - math.log(math.tan(math.radians(lat)) + 1 / math.cos(math.radians(lat))) / math.pi) / 2
   223	    return min(n - 1, max(0, int(x * n))), min(n - 1, max(0, int(y * n)))
   224	
   225	
   226	def well_grid(features: list[dict], z: int) -> dict:
   227	    n = grid_cells(z)
   228	    records: dict[str, int] = {}
   229	    cells: dict[tuple, list] = {}
   230	    for f in features:
   231	        if not is_well(f):
   232	            continue
   233	        lon, lat = f["geometry"]["coordinates"][:2]
   234	        ri = records.setdefault(f["properties"]["record_id"], len(records))
   235	        c = cells.setdefault((*grid_cell(lon, lat, n), ri), [0, 0, 0.0, 0.0])
   236	        c[1 if f["properties"].get("approximate") else 0] += 1
   237	        c[2] += lon
   238	        c[3] += lat
   239	    rows = [[cx, cy, ri, e, a, round(lon / (e + a), 4), round(lat / (e + a), 4)]
   240	            for (cx, cy, ri), (e, a, lon, lat) in sorted(cells.items())]
   241	    return {"zoom": z, "cells": n, "records": list(records), "rows": rows}
   242	
   243	
   244	def write_well_grids(out_dir: Path, features: list[dict]) -> None:
   245	    import sys
   246	
   247	    for old in out_dir.glob("wells-z*.json"):
   248	        old.unlink()
   249	    size = 0
   250	    for z in range(CLUSTER_BELOW_ZOOM):
   251	        p = out_dir / f"wells-z{z}.json"
   252	        p.write_text(json.dumps(well_grid(features, z), separators=(",", ":")) + "\n")
   253	        size += p.stat().st_size
   254	    print(f"wells: wells-z0..z{CLUSTER_BELOW_ZOOM - 1}.json {sum(map(is_well, features))} wellbore points,"
   255	          f" {size / 1e3:.0f} kB", file=sys.stderr)
   256	
   257	
   258	# Tiling (E15). One source layer, "outlines", every GeoJSON property kept. Points are kept at every
   259	# zoom they are in (-r1); wellbore points start at CLUSTER_BELOW_ZOOM (E36, the filter below), the
   260	# page clusters them under it from the grids. One run z0-12, lines and polygons unsimplified at every
   261	# zoom (E36: E15's two runs, simplified below z8 and joined, took 25 s more of the gate's build for
   262	# 75 kB less in all). Pinned in CI: Ubuntu tippecanoe 2.79.0-1 (E32: before 2.55.0 the
   263	# string pool wrote one string for another whose hash shared its low 32 bits, tests/fixtures/tiles/).
   264	TIPPECANOE_PIN = "2.79.0"
   265	TILE_ZOOMS = ["-Z0", "-z12", "--no-line-simplification"]
   266	TILE_WELLS_FROM = {"*": ["any", ["!=", "kind", "wellbore"], ["!=", "$type", "Point"],
   267	                         [">=", "$zoom", CLUSTER_BELOW_ZOOM]]}
   268	TILE_COMMON = ["-q", "-f", "-l", "outlines", "-r1", "--no-feature-limit", "--no-tile-size-limit",
   269	               "--no-tiny-polygon-reduction", "-j", json.dumps(TILE_WELLS_FROM)]
   270	
   271	
   272	def write_tiles(out_dir: Path, cache_dir: Path = paths.BUILD_DIR / "tiles") -> Path | None:
   273	    """out_dir/outlines.pmtiles from out_dir/outlines.geojson, or None with a notice when
   274	    tippecanoe is absent (the page then reads the GeoJSON whole). Cached by input and tool version,
   275	    so a second build of the same outlines (the site test's) costs a copy."""
   276	    import hashlib
   277	    import shutil
   278	    import subprocess
   279	    import sys
   280	    import tempfile
   281	
   282	    src, dst = out_dir / "outlines.geojson", out_dir / "outlines.pmtiles"
   283	    dst.unlink(missing_ok=True)
   284	    if not shutil.which("tippecanoe"):
   285	        print("notice: tippecanoe not found, outlines.pmtiles not written; the map reads outlines.geojson "
   286	              f"whole (install tippecanoe {TIPPECANOE_PIN}, see .github/workflows/ci.yml)", file=sys.stderr)
   287	        return None
   288	    version = subprocess.run(["tippecanoe", "--version"], capture_output=True, text=True, check=False).stderr.strip()
   289	    key = hashlib.sha256(src.read_bytes())
   290	    key.update(json.dumps([version, TILE_ZOOMS, TILE_COMMON]).encode())
   291	    cached = cache_dir / f"outlines-{key.hexdigest()[:16]}.pmtiles"
   292	    if not cached.exists():
   293	        cache_dir.mkdir(parents=True, exist_ok=True)
   294	        with tempfile.TemporaryDirectory() as tmp:
   295	            tiles = Path(tmp) / "outlines.pmtiles"
   296	            r = subprocess.run(["tippecanoe", *TILE_COMMON, *TILE_ZOOMS, "-o", str(tiles), str(src)],
   297	                               capture_output=True, text=True, check=False)
   298	            if r.returncode:
   299	                raise RuntimeError(f"tippecanoe failed: {r.stderr}")
   300	            for old in cache_dir.glob("outlines-*.pmtiles"):
