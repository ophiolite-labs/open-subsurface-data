    51	def latest_verification(rid: str, vdir: Path = paths.VERIFICATION_DIR) -> dict | None:
    52	    p = vdir / (rid.replace("/", "__") + ".json")
    53	    return json.loads(p.read_text()) if p.exists() else None
    54	
    55	
    56	COMMIT = re.compile(r"^[0-9a-f]{40}$")
    57	FROM_ENVIRONMENT = "from-environment"
    58	
    59	
    60	def records_digest(records: list[dict]) -> str:
    61	    canonical = json.dumps(records, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    62	    return hashlib.sha256(canonical.encode()).hexdigest()
    63	
    64	
    65	def git_head(root: Path = paths.ROOT) -> str | None:
    66	    """HEAD of the checkout the records come from; None outside git."""
    67	    try:
    68	        r = subprocess.run(["git", "-C", str(root), "rev-parse", "HEAD"], capture_output=True, text=True, check=False)
    69	    except OSError:
    70	        return None
    71	    return r.stdout.strip() if r.returncode == 0 and COMMIT.match(r.stdout.strip()) else None
    72	
    73	
    74	def verification_commit_from_env() -> str | None:
    75	    """The verification-results commit the workflow extracted into build/verification, as it says in
    76	    OSD_VERIFICATION_COMMIT; None when it says nothing (a local build)."""
    77	    v = os.environ.get("OSD_VERIFICATION_COMMIT", "").strip()
    78	    if v and not COMMIT.match(v):
    79	        raise ValueError(f"OSD_VERIFICATION_COMMIT={v!r} is not a 40-character commit id")
    80	    return v or None
