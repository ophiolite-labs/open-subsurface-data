{"help": "https://www.data.qld.gov.au/api/3/action/help_show?name=package_show", "success": true, "result": {"author": "GSQOpenData@dnrme.qld.gov.au", "author_email": "GSQOpenData@dnrme.qld.gov.au", "creator_user_id": "cefefdab-2536-436b-b34c-75252b2e2c0e", "id": "84628242-ef3d-4dec-8e6a-d49add1ab2e1", "isopen": true, "license_id": "CC-BY-4.0", "license_title": "Creative Commons Attribution 4.0", "license_url": "https://creativecommons.org/licenses/by/4.0/", "maintainer": "GSQOpenData@dnrme.qld.gov.au", "maintainer_email": "GSQOpenData@dnrme.qld.gov.au", "metadata_created": "2023-05-08T21:58:06.049791", "metadata_modified": "2023-05-08T21:58:06.049805", "name": "ds000005", "notes": "URL: https://geoscience.data.qld.gov.au/dataset/ds000005\r\n\r\n2017 Database extract containing geological, geophysical, and geochemical data relating to Queensland\u2019s sedimentary basins derived from the drilling of petroleum wells, coal seam gas wells 'CSG', and stratigraphic bores. Data includes general well history, company and GSQ stratigraphy, drill stem tests, wireline logs, downhole temperatures, analytical data, biostratigraphy, and hydrocarbon indications.\r\nQPED is extracted from MERLIN, a geographic information system GIS, which involved the amalgamation of 4 Departmental Databases: the petroleum 'QERDB', coal 'QCOS', mineral 'TerraSearch Pty Ltd download' and water 'Groundwater Database'.", "num_resources": 0, "num_tags": 0, "organization": {"id": "1d443ba7-8efb-42f0-b836-9be70390378d", "name": "geological-survey-of-queensland", "title": "Geological Survey of Queensland", "type": "organization", "description": "https://geoscience.data.qld.gov.au/", "image_url": "", "created": "2022-03-24T12:52:13.167367", "is_organization": true, "approval_status": "approved", "state": "active"}, "owner_org": "1d443ba7-8efb-42f0-b836-9be70390378d", "private": false, "state": "active", "title": "Queensland Petroleum Exploration Data-QPED", "type": "geoscience", "url": "https://geoscience